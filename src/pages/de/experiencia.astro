---
import Layout from '../../layouts/Layout.astro';
import expData from '../../data/experience.json';

const lang = 'de';

const expSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Berufserfahrung — Pablo Gómez",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Full-Stack-Entwickler — EDUCA EDTECH Group",
      "description": "Entwicklung und Wartung von Bildungsplattformen in Produktion. Okt. 2023 – Jun. 2024"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Junior Software Developer — Euroinnova",
      "description": "Entwicklung von Webanwendungen im Bereich Online-Weiterbildung. Apr. 2023 – Okt. 2023"
    }
  ]
};
---

<Layout
  title="Erfahrung — Pablo Gómez | Full-Stack-Entwickler"
  lang="de"
  showHero={false}
  description="Beruflicher Werdegang von Pablo Gómez: über 1 Jahr Erfahrung als Full-Stack-Entwickler bei EDUCA EDTECH Group und Euroinnova. Laravel, PHP, MySQL, Google Cloud."
  canonical="https://www.pablogomezvillen.com/de/experiencia"
  alternateEs="https://www.pablogomezvillen.com/experiencia"
  alternateEn="https://www.pablogomezvillen.com/en/experiencia"
  alternateDe="https://www.pablogomezvillen.com/de/experiencia"
  keywords="Berufserfahrung, Full-Stack-Entwickler, Laravel, PHP, EDUCA EDTECH, Euroinnova, Granada, Backend-Entwickler"
  jsonLd={expSchema}
>

  <div class="page-banner">
    <h1>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
      Erfahrung
    </h1>
    <p>Mein beruflicher Werdegang als Entwickler</p>
    <p class="banner-rescue">Suchst du eine Website für dein Unternehmen? <a href="/de/dienstleistungen">Leistungen ansehen</a></p>
    <a href="/CV_Pablo_Gomez_Villen_Software-Developer.pdf" download target="_blank" rel="noopener noreferrer" class="btn secondary btn--icon page-banner-cv">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Lebenslauf herunterladen
    </a>
  </div>

  <section class="section">

    <div class="exp-stats">
      <div class="exp-stat">
        <span class="exp-stat-num">1+</span>
        <span class="exp-stat-label">Jahr Erfahrung</span>
      </div>
      <div class="exp-stat">
        <span class="exp-stat-num">2</span>
        <span class="exp-stat-label">Unternehmen</span>
      </div>
      <div class="exp-stat">
        <span class="exp-stat-num">2</span>
        <span class="exp-stat-label">Produktionsprojekte</span>
      </div>
    </div>

    <div class="exp-timeline">
      {expData.experiencia.map((job) => (
        <div class="exp-item" id={`exp-${job.id}`}>
          <div class="exp-dot"></div>
          <div class="exp-card">
            <div class="exp-header">
              <div class="exp-header-left">
                <h2 class="exp-role">{job.role[lang]}</h2>
                <p class="exp-company">{job.company}</p>
              </div>
              <div class="exp-badges">
                <span class="exp-badge exp-duration">{job.duration[lang]}</span>
                <span class="exp-badge exp-badge--mode exp-modality">{job.modality[lang]}</span>
              </div>
            </div>

            <p class="exp-period">
              <span class="exp-period-text">{job.period[lang]}</span>
              {' · '}{job.location}
            </p>

            <p class="exp-desc">{job.description[lang]}</p>

            <ul class="exp-bullets">
              {job.bullets[lang].map((b) => (
                <li>{b}</li>
              ))}
            </ul>

            <div class="skills">
              {job.skills.map(skill => (
                <span class={`skill ${skill.level}`}>{skill.name}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </section>

</Layout>
