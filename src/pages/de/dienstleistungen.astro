  showHero={false}
  keywords="Webentwicklung Granada Spanien, lokales SEO Spanien, Google-Business-Optimierung, Website für Restaurants, Website für Kliniken, Full-Stack-Entwickler Spanien"
  jsonLd={[localBusinessSchema]}
  footerText="© 2026 Pablo Gómez Villén · Webentwicklung & lokales SEO · Granada"
>

  <!-- Hero -->
  <header class="servicios-hero">
    <span class="servicios-hero-eyebrow">🏪 Für lokale Unternehmen in Spanien und weltweit</span>
    <h1>Webentwicklung, SEO & Automatisierung für Unternehmen</h1>
    <p class="servicios-hero-sub">Dein Unternehmen verdient eine Website, die Kunden bringt</p>
    <a href="/de/kontakt" class="btn-accent">Kostenloses Angebot anfragen</a>
  </header>

  <!-- Services -->
