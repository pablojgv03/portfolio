---
import Layout from '../layouts/Layout.astro';
import projectsData from '../data/projects.json';

const badgeEmojis: Record<string, string> = {
  desktop: '🖥️',
  mobile: '📱',
  web: '🌐',
};
---

<Layout
  title="Proyectos — Pablo Gómez"
  lang="es"
  showHero={false}
  description="Proyectos de desarrollo web y móvil de Pablo Gómez — aplicaciones full stack, apps Android y más."
  canonical="https://www.pablogomezvillen.com/proyectos"
  alternateEs="https://www.pablogomezvillen.com/proyectos"
  alternateEn="https://www.pablogomezvillen.com/en/proyectos"
  lcp={projectsData.proyectos[0]?.image}
>

  <!-- Banner de página -->
  <div class="page-banner">
    <h1 data-i18n="section-proyectos.page-title">🚀 Proyectos</h1>
    <p data-i18n="section-proyectos.subtitle">Una selección de mis proyectos personales y profesionales</p>
    <a href="/CV_Full-stack_Pablo_Gomez_Villen_Desarrollador.pdf" download target="_blank" rel="noopener noreferrer" class="btn secondary btn--icon page-banner-cv">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Descargar CV
    </a>
  </div>

  <section class="section proyectos-page">

    <!-- Filtros -->
    <div class="filtros" role="group" aria-label="Filtrar proyectos">
      <button class="filtro active" data-filtro="todos" data-i18n="filtros.todos">Todos</button>
      <button class="filtro" data-filtro="desktop" data-i18n="filtros.desktop">🖥️ Escritorio</button>
      <button class="filtro" data-filtro="mobile" data-i18n="filtros.mobile">📱 Móvil</button>
      <button class="filtro" data-filtro="web" data-i18n="filtros.web">🌐 Web</button>
    </div>

    <p class="project-count" id="project-count"></p>

    <!-- Grid de proyectos -->
    <div id="lista-proyectos" class="projects">
      {projectsData.proyectos.map((p, idx) => (
        <article class={`project-card project-card--full${p.image ? ' project-card--with-thumb' : ''}`} data-badge={p.badge}>
          <a href={`/proyectos/${p.slug}`} class="full-link" aria-label={`Ver detalle de ${p.title}`}></a>
          {p.image && (
            <div class="project-card-thumb">
              <img
                src={p.image}
                alt={p.imageAlt || p.title}
                loading={idx === 0 ? 'eager' : 'lazy'}
                fetchpriority={idx === 0 ? 'high' : undefined}
                decoding={idx === 0 ? 'sync' : 'async'}
                width="400"
                height="210"
              />
            </div>
          )}
          <div class={p.image ? 'project-card-body' : ''}>
            <div class={`project-badge badge-${p.badge}`} title={p.badge}>
              {badgeEmojis[p.badge] ?? '❓'}
            </div>
            <h2>{p.title}</h2>
            <p class="project-desc">{p.description.es}</p>
            {p.skills && p.skills.length > 0 && (
              <div class="skills" aria-label={`Aptitudes de ${p.title}`}>
                {p.skills.slice(0, 6).map(skill => (
                  <span class={`skill ${skill.level ?? ''}`} title={skill.level ?? ''}>{skill.name}</span>
                ))}
              </div>
            )}
            <div class="links card-links--elevated">
              {p['link-text'] && p['link-text'] !== '#' && (
                <a href={p['link-text']} target="_blank" rel="noopener noreferrer">GitHub →</a>
              )}
              {p.link && p.link !== '#' && !p.link.includes('localhost') && p.link !== p['link-text'] && (
                <a href={p.link} target="_blank" rel="noopener noreferrer">Demo →</a>
              )}
              <a href={`/proyectos/${p.slug}`} class="link-detail">Ver detalle →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const cards = document.querySelectorAll('#lista-proyectos .project-card');
      const botones = document.querySelectorAll('.filtro');

      updateCount(cards.length, cards.length);

      botones.forEach(btn => {
        btn.addEventListener('click', () => {
          botones.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const tipo = (btn as HTMLElement).dataset.filtro;
          let visible = 0;
          cards.forEach(card => {
            const show = tipo === 'todos' || (card as HTMLElement).dataset.badge === tipo;
            (card as HTMLElement).style.display = show ? '' : 'none';
            if (show) visible++;
          });
          updateCount(visible, cards.length);
        });
      });

      function updateCount(visible: number, total: number) {
        const el = document.getElementById('project-count');
        if (el) el.textContent = `${visible} de ${total} proyectos`;
      }
    });
  </script>

<style>
  .card-links--elevated a {
    position: relative;
    z-index: 11;
  }
  .link-detail {
    margin-left: auto;
    color: #2a5298;
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9rem;
    padding: 4px 0;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
  }
  .link-detail:hover { text-decoration: underline; }
  .proyectos-page .project-card {
    content-visibility: auto;
    contain-intrinsic-size: 0 380px;
  }
</style>

</Layout>
