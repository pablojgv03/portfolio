---
interface Props {
  lang?: 'es' | 'en';
  calLink: string;
}
const { lang = 'es', calLink } = Astro.props;
---

<div class="ccal" id="ccal" role="region" aria-label={lang === 'es' ? 'Calendario de reservas' : 'Booking calendar'}>

  <!-- ── LEFT PANEL ────────────────────────────────────────────── -->
  <div class="ccal-left">

    <!-- Event info -->
    <div class="ccal-event-info">
      <img class="ccal-avatar" src="/img/foto-empresa.jpg" alt="Pablo Gómez Villén" />
      <div class="ccal-event-meta">
        <span class="ccal-organizer">Pablo Gómez Villén</span>
        <strong class="ccal-event-name">
          {lang === 'es' ? 'AUDITORÍA GRATUITA' : 'FREE AUDIT'}
        </strong>
        <span class="ccal-event-detail">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          20 {lang === 'es' ? 'min' : 'min'}
        </span>
        <span class="ccal-event-detail">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1a73e8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
          Google Meet
        </span>
      </div>
    </div>

    <!-- Timezone selector - custom dropdown -->
    <div class="ccal-tz-wrap" id="ccal-tz-wrap">
      <button class="ccal-tz-btn" id="ccal-tz-btn" type="button" aria-haspopup="listbox" aria-expanded="false">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        <span class="ccal-tz-label" id="ccal-tz-label">Europe/Madrid</span>
        <span class="ccal-tz-gmt" id="ccal-tz-gmt">GMT+2</span>
        <svg class="ccal-tz-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
    </div>

    <!-- Month navigation -->
    <div class="ccal-month-nav">
      <button class="ccal-arrow" id="ccal-prev" aria-label={lang === 'es' ? 'Mes anterior' : 'Previous month'}>&#8249;</button>
      <span class="ccal-month-title" id="ccal-month-title"></span>
      <button class="ccal-arrow" id="ccal-next" aria-label={lang === 'es' ? 'Mes siguiente' : 'Next month'}>&#8250;</button>
    </div>

    <div class="ccal-weekdays" id="ccal-weekdays"></div>
    <div class="ccal-days" id="ccal-days"></div>

    <div class="ccal-legend">
      <span class="ccal-legend-item">
        <span class="ccal-dot ccal-dot-green"></span>
        {lang === 'es' ? 'Libre' : 'Free'}
      </span>
      <span class="ccal-legend-item">
        <span class="ccal-dot ccal-dot-red"></span>
        {lang === 'es' ? 'Ocupado' : 'Busy'}
      </span>
    </div>
  </div>

  <!-- ── RIGHT PANEL ───────────────────────────────────────────── -->
  <div class="ccal-right">

    <!-- Empty state -->
    <div class="ccal-empty" id="ccal-empty">
      <div class="ccal-empty-arrow">&#8598;</div>
      <p>{lang === 'es' ? 'Elige un día para ver los huecos disponibles' : 'Pick a day to see available slots'}</p>
    </div>

    <!-- Loading skeleton -->
    <div class="ccal-loading" id="ccal-loading" style="display:none" aria-hidden="true">
      <div class="ccal-skeleton ccal-skeleton-title"></div>
      <div class="ccal-skeleton-pills">
        <div class="ccal-skeleton ccal-skeleton-pill"></div>
        <div class="ccal-skeleton ccal-skeleton-pill"></div>
        <div class="ccal-skeleton ccal-skeleton-pill"></div>
        <div class="ccal-skeleton ccal-skeleton-pill"></div>
        <div class="ccal-skeleton ccal-skeleton-pill"></div>
        <div class="ccal-skeleton ccal-skeleton-pill"></div>
      </div>
    </div>

    <!-- Slots list -->
    <div class="ccal-slots" id="ccal-slots" style="display:none">
      <h4 class="ccal-slots-date" id="ccal-slots-date"></h4>
      <div class="ccal-slots-grid" id="ccal-slots-grid"></div>
      <p class="ccal-no-slots" id="ccal-no-slots" style="display:none">
        {lang === 'es' ? 'Sin huecos disponibles este día' : 'No slots available this day'}
      </p>
    </div>

    <!-- Booking form -->
    <div class="ccal-form-panel" id="ccal-form-panel" style="display:none">
      <button class="ccal-back-btn" id="ccal-back">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        {lang === 'es' ? 'Volver' : 'Back'}
      </button>

      <div class="ccal-form-slot-info" id="ccal-form-slot-info"></div>

      <form class="ccal-form" id="ccal-form" novalidate>
        <div class="ccal-field">
          <label class="ccal-label" for="ccal-name">
            {lang === 'es' ? 'Nombre completo' : 'Full name'} <span aria-hidden="true">*</span>
          </label>
          <input class="ccal-input" id="ccal-name" type="text" autocomplete="name"
            placeholder={lang === 'es' ? 'Tu nombre' : 'Your name'} required />
        </div>
        <div class="ccal-field">
          <label class="ccal-label" for="ccal-email">
            Email <span aria-hidden="true">*</span>
          </label>
          <input class="ccal-input" id="ccal-email" type="email" autocomplete="email"
            placeholder={lang === 'es' ? 'tu@email.com' : 'you@email.com'} required />
        </div>
        <div class="ccal-field">
          <label class="ccal-label" for="ccal-notes">
            {lang === 'es' ? 'Cuéntame sobre tu proyecto (opcional)' : 'Tell me about your project (optional)'}
          </label>
          <textarea class="ccal-input ccal-textarea" id="ccal-notes" rows="3"
            placeholder={lang === 'es' ? 'Describe brevemente qué quieres mejorar...' : 'Briefly describe what you want to improve...'}></textarea>
        </div>
        <p class="ccal-form-error" id="ccal-form-error" style="display:none"></p>
        <button type="submit" class="ccal-submit-btn" id="ccal-submit">
          {lang === 'es' ? 'Confirmar reserva' : 'Confirm booking'}
        </button>
      </form>
    </div>

    <!-- Confirmation -->
    <div class="ccal-confirm-panel" id="ccal-confirm-panel" style="display:none">
      <div class="ccal-confirm-icon" aria-hidden="true">✓</div>
      <h4 class="ccal-confirm-title">
        {lang === 'es' ? '¡Reunión confirmada!' : 'Meeting confirmed!'}
      </h4>
      <p class="ccal-confirm-detail" id="ccal-confirm-detail"></p>
      <a class="ccal-meet-link" id="ccal-meet-link" href="#" target="_blank" rel="noopener noreferrer" style="display:none">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
        {lang === 'es' ? 'Unirse a la videollamada' : 'Join video call'}
      </a>
      <p class="ccal-confirm-email-note">
        {lang === 'es' ? 'Recibirás la confirmación por email.' : 'You will receive a confirmation email.'}
      </p>
    </div>

  </div>
</div>

<script define:vars={{ lang, calLink }}>
(function () {
  // ── State ────────────────────────────────────────────────────────────
  let currentTZ    = 'Europe/Madrid';
  let viewYear     = new Date().getFullYear();
  let viewMonth    = new Date().getMonth();
  let selectedDate = null;
  let selectedSlot = null;
  let bookedSlots  = [];
  let availSlots   = {};
  let fetchPromises = {};

  // ── i18n ─────────────────────────────────────────────────────────────
  const i18n = {
    es: {
      months: ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'],
      wdays:  ['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'],
      busy:   'Ocupado',
      back:   'Volver',
      book:   'Reservar',
      submitting: 'Confirmando...',
      errRequired: 'Por favor rellena nombre y email.',
      errServer:   'Error al crear la reserva. Inténtalo de nuevo.',
    },
    en: {
      months: ['January','February','March','April','May','June','July','August','September','October','November','December'],
      wdays:  ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'],
      busy:   'Busy',
      back:   'Back',
      book:   'Book',
      submitting: 'Confirming...',
      errRequired: 'Please fill in your name and email.',
      errServer:   'Error creating booking. Please try again.',
    },
  };
  const t = i18n[lang] || i18n.es;

  // ── DOM refs ──────────────────────────────────────────────────────────
  const elMonthTitle  = document.getElementById('ccal-month-title');
  const elWeekdays    = document.getElementById('ccal-weekdays');
  const elDays        = document.getElementById('ccal-days');
  const elEmpty       = document.getElementById('ccal-empty');
  const elLoading     = document.getElementById('ccal-loading');
  const elSlots       = document.getElementById('ccal-slots');
  const elSlotsDate   = document.getElementById('ccal-slots-date');
  const elSlotsGrid   = document.getElementById('ccal-slots-grid');
  const elNoSlots     = document.getElementById('ccal-no-slots');
  const elFormPanel   = document.getElementById('ccal-form-panel');
  const elFormSlotInfo= document.getElementById('ccal-form-slot-info');
  const elForm        = document.getElementById('ccal-form');
  const elName        = document.getElementById('ccal-name');
  const elEmail       = document.getElementById('ccal-email');
  const elNotes       = document.getElementById('ccal-notes');
  const elFormError   = document.getElementById('ccal-form-error');
  const elSubmit      = document.getElementById('ccal-submit');
  const elConfirm     = document.getElementById('ccal-confirm-panel');
  const elConfirmDetail = document.getElementById('ccal-confirm-detail');
  const elMeetLink    = document.getElementById('ccal-meet-link');

  // ── Helpers ───────────────────────────────────────────────────────────
  function dateKey(d) {
    return new Intl.DateTimeFormat('sv-SE', { timeZone: currentTZ }).format(d);
  }

  function fmtTime(utcStr) {
    return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', {
      hour: '2-digit', minute: '2-digit', timeZone: currentTZ,
    }).format(new Date(utcStr));
  }

  function fmtDayHeader(d) {
    const s = d.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', {
      weekday: 'long', day: 'numeric', month: 'long', timeZone: currentTZ,
    });
    return s.charAt(0).toUpperCase() + s.slice(1);
  }

  function fmtConfirmDate(utcStr) {
    return new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', {
      weekday: 'long', day: 'numeric', month: 'long',
      hour: '2-digit', minute: '2-digit', timeZone: currentTZ,
    }).format(new Date(utcStr));
  }

  // ── Panel switcher ────────────────────────────────────────────────────
  function showPanel(which) {
    elEmpty.style.display    = which === 'empty'   ? '' : 'none';
    elLoading.style.display  = which === 'loading' ? '' : 'none';
    elSlots.style.display    = which === 'slots'   ? '' : 'none';
    elFormPanel.style.display= which === 'form'    ? '' : 'none';
    elConfirm.style.display  = which === 'confirm' ? '' : 'none';
    if (which === 'slots' || which === 'form') {
      const el = which === 'slots' ? elSlots : elFormPanel;
      el.classList.remove('ccal-fade-in');
      void el.offsetWidth;
      el.classList.add('ccal-fade-in');
    }
  }

  // ── Ripple ────────────────────────────────────────────────────────────
  function ripple(el, e) {
    const r  = el.getBoundingClientRect();
    const sz = Math.max(r.width, r.height);
    const sp = document.createElement('span');
    sp.className = 'ccal-ripple';
    sp.style.cssText = `width:${sz}px;height:${sz}px;left:${e.clientX-r.left-sz/2}px;top:${e.clientY-r.top-sz/2}px`;
    el.appendChild(sp);
    setTimeout(() => sp.remove(), 500);
  }

  // ── Fetch bookings ────────────────────────────────────────────────────
  fetch('/api/bookings')
    .then(r => r.json())
    .then(d => { bookedSlots = d.slots || []; renderMonth(); })
    .catch(() => {});

  // ── Fetch available slots (Promise-cached per month) ──────────────────
  function fetchMonth(year, month) {
    const key = `${year}-${String(month + 1).padStart(2, '0')}`;
    if (fetchPromises[key]) return fetchPromises[key];

    fetchPromises[key] = (async () => {
      const start = new Date(year, month, 1).toISOString();
      const end   = new Date(year, month + 1, 0, 23, 59, 59).toISOString();
      try {
        const res  = await fetch(`/api/slots?startTime=${encodeURIComponent(start)}&endTime=${encodeURIComponent(end)}`);
        if (!res.ok) return;
        const data = await res.json();
        const slotsMap = data.slots || {};
        for (const [dk, arr] of Object.entries(slotsMap)) {
          availSlots[dk] = arr; // already UTC strings
        }
        renderMonth();
        if (selectedDate) {
          const sk = dateKey(selectedDate);
          if (availSlots[sk] !== undefined) renderSlots(selectedDate);
        }
      } catch {}
    })();

    return fetchPromises[key];
  }

  // ── Infer occupied slots ──────────────────────────────────────────────
  function getOccupiedSlots(freeSet) {
    if (freeSet.size === 0) return [];

    let minMins = Infinity, maxMins = -Infinity;
    for (const slots of Object.values(availSlots)) {
      for (const s of slots) {
        const d = new Date(s);
        const m = d.getUTCHours() * 60 + d.getUTCMinutes();
        if (m < minMins) minMins = m;
        if (m > maxMins) maxMins = m;
      }
    }
    if (minMins === Infinity) return [];

    const utcDatePrefix = [...freeSet][0].substring(0, 10);
    const occupied = [];
    for (let m = minMins; m <= maxMins; m += 20) {
      const hh = String(Math.floor(m / 60)).padStart(2, '0');
      const mm = String(m % 60).padStart(2, '0');
      const slot = `${utcDatePrefix}T${hh}:${mm}:00.000Z`;
      if (!freeSet.has(slot)) occupied.push(slot);
    }
    return occupied;
  }

  // ── Render month grid ─────────────────────────────────────────────────
  function renderMonth() {
    elMonthTitle.textContent = `${t.months[viewMonth]} ${viewYear}`;

    if (!elWeekdays.children.length) {
      t.wdays.forEach(wd => {
        const s = document.createElement('span');
        s.textContent = wd;
        elWeekdays.appendChild(s);
      });
    }

    const today   = new Date(); today.setHours(0,0,0,0);
    const todayStr= dateKey(today);
    const selStr  = selectedDate ? dateKey(selectedDate) : null;

    let dow = new Date(viewYear, viewMonth, 1).getDay();
    dow = dow === 0 ? 6 : dow - 1;
    const lastDate = new Date(viewYear, viewMonth + 1, 0).getDate();

    elDays.innerHTML = '';
    for (let i = 0; i < dow; i++) elDays.appendChild(document.createElement('div'));

    for (let d = 1; d <= lastDate; d++) {
      const date   = new Date(viewYear, viewMonth, d);
      const dk     = dateKey(date);
      const isPast = date < today;
      const isSel  = dk === selStr;
      const hasAvail  = (availSlots[dk] || []).length > 0;
      const hasBooked = bookedSlots.some(b => dateKey(new Date(b.start)) === dk);

      const cell = document.createElement('div');
      cell.className = 'ccal-day';
      const num = document.createElement('span');
      num.textContent = d;
      cell.appendChild(num);

      if (isPast) {
        cell.classList.add('past');
      } else {
        if (dk === todayStr)  cell.classList.add('today');
        if (isSel)            cell.classList.add('selected');
        if (hasAvail)         cell.classList.add('has-avail');
        else if (hasBooked)   cell.classList.add('has-booked'); // red only if zero free slots
        cell.addEventListener('click', e => { ripple(cell, e); selectDay(date); });
      }
      elDays.appendChild(cell);
    }
  }

  // ── Select day ────────────────────────────────────────────────────────
  async function selectDay(date) {
    selectedDate = date;
    selectedSlot = null;
    renderMonth();
    showPanel('loading');
    await fetchMonth(date.getFullYear(), date.getMonth());
    renderSlots(date);
  }

  // ── Render slots ──────────────────────────────────────────────────────
  function renderSlots(date) {
    const dk      = dateKey(date);
    const free    = availSlots[dk] || [];
    const freeSet = new Set(free);

    const bookedTimes = new Set(
      bookedSlots.filter(b => dateKey(new Date(b.start)) === dk).map(b => b.start)
    );
    const occupied = getOccupiedSlots(freeSet);

    elSlotsDate.textContent = fmtDayHeader(date);

    const now = new Date();

    // free = green, past = grey, future occupied = red
    const allSlots = [
      ...free.map(s => ({ start: s, type: 'free' })),
      ...occupied.map(s => ({
        start: s,
        type: new Date(s) < now ? 'past' : 'busy',
      })),
    ].sort((a, b) => a.start.localeCompare(b.start));

    if (allSlots.length === 0) {
      elSlotsGrid.innerHTML = '';
      elNoSlots.style.display = '';
    } else {
      elNoSlots.style.display = 'none';
      elSlotsGrid.innerHTML = allSlots.map(({ start, type }) => {
        const time = fmtTime(start);
        if (type === 'past') {
          return `<div class="ccal-pill ccal-pill-past" aria-label="${time}" aria-hidden="true">${time}</div>`;
        }
        if (type === 'busy') {
          return `<div class="ccal-pill ccal-pill-busy" title="${t.busy}" aria-label="${time} – ${t.busy}">
            <span class="ccal-pill-dot"></span>${time}
          </div>`;
        }
        return `<button class="ccal-pill ccal-pill-free" data-slot="${start}" aria-label="${t.book} ${time}">
          ${time}
        </button>`;
      }).join('');

      elSlotsGrid.querySelectorAll('.ccal-pill-free').forEach(btn => {
        btn.addEventListener('click', () => openForm(btn.dataset.slot));
      });
    }
    showPanel('slots');
  }

  // ── Open booking form ─────────────────────────────────────────────────
  function openForm(slotUTC) {
    selectedSlot = slotUTC;
    const time = fmtTime(slotUTC);
    const day  = fmtDayHeader(selectedDate);
    elFormSlotInfo.innerHTML = `
      <div class="ccal-form-slot-badge">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span>${day}</span>
      </div>
      <div class="ccal-form-slot-badge">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>${time} · 20 min</span>
      </div>`;
    elFormError.style.display = 'none';
    elSubmit.disabled = false;
    elSubmit.textContent = lang === 'es' ? 'Confirmar reserva' : 'Confirm booking';
    showPanel('form');
  }

  // ── Submit booking ────────────────────────────────────────────────────
  elForm.addEventListener('submit', async e => {
    e.preventDefault();
    const name  = elName.value.trim();
    const email = elEmail.value.trim();
    const notes = elNotes.value.trim();
    if (!name || !email) {
      elFormError.textContent = t.errRequired;
      elFormError.style.display = '';
      return;
    }
    elFormError.style.display = 'none';
    elSubmit.disabled = true;
    elSubmit.textContent = t.submitting;

    try {
      const res = await fetch('/api/book', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ start: selectedSlot, name, email, notes, timeZone: currentTZ, language: lang }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || t.errServer);

      // Show confirmation
      elConfirmDetail.textContent = fmtConfirmDate(data.start || selectedSlot);
      if (data.meetingUrl) {
        elMeetLink.href = data.meetingUrl;
        const isGoogleMeet = data.meetingUrl.includes('meet.google.com');
        const linkLabel = isGoogleMeet
          ? (lang === 'es' ? 'Unirse a Google Meet' : 'Join Google Meet')
          : (lang === 'es' ? 'Unirse a la videollamada' : 'Join video call');
        elMeetLink.childNodes[elMeetLink.childNodes.length - 1].textContent = ' ' + linkLabel;
        elMeetLink.style.display = '';
      } else {
        elMeetLink.style.display = 'none';
      }
      showPanel('confirm');

      // Refresh bookings in background
      fetch('/api/bookings').then(r => r.json()).then(d => {
        bookedSlots = d.slots || [];
        renderMonth();
      }).catch(() => {});
    } catch (err) {
      elFormError.textContent = err.message || t.errServer;
      elFormError.style.display = '';
      elSubmit.disabled = false;
      elSubmit.textContent = lang === 'es' ? 'Confirmar reserva' : 'Confirm booking';
    }
  });

  // ── Back button ───────────────────────────────────────────────────────
  document.getElementById('ccal-back').addEventListener('click', () => {
    if (selectedDate) renderSlots(selectedDate);
    else showPanel('empty');
  });

  // ── Custom timezone dropdown ──────────────────────────────────────────
  const TIMEZONES = [
    { tz: 'Europe/Madrid',        city: lang === 'es' ? 'Madrid'           : 'Madrid' },
    { tz: 'Europe/London',        city: lang === 'es' ? 'Londres'          : 'London' },
    { tz: 'Europe/Lisbon',        city: lang === 'es' ? 'Lisboa'           : 'Lisbon' },
    { tz: 'Europe/Paris',         city: lang === 'es' ? 'París'            : 'Paris' },
    { tz: 'Europe/Berlin',        city: lang === 'es' ? 'Berlín'           : 'Berlin' },
    { tz: 'Europe/Rome',          city: lang === 'es' ? 'Roma'             : 'Rome' },
    { tz: 'Europe/Amsterdam',     city: lang === 'es' ? 'Ámsterdam'        : 'Amsterdam' },
    { tz: 'Europe/Brussels',      city: lang === 'es' ? 'Bruselas'         : 'Brussels' },
    { tz: 'Europe/Warsaw',        city: lang === 'es' ? 'Varsovia'         : 'Warsaw' },
    { tz: 'Europe/Moscow',        city: lang === 'es' ? 'Moscú'            : 'Moscow' },
    { tz: 'America/New_York',     city: lang === 'es' ? 'Nueva York'       : 'New York' },
    { tz: 'America/Chicago',      city: 'Chicago' },
    { tz: 'America/Denver',       city: 'Denver' },
    { tz: 'America/Los_Angeles',  city: lang === 'es' ? 'Los Ángeles'      : 'Los Angeles' },
    { tz: 'America/Toronto',      city: 'Toronto' },
    { tz: 'America/Mexico_City',  city: lang === 'es' ? 'Ciudad de México' : 'Mexico City' },
    { tz: 'America/Bogota',       city: lang === 'es' ? 'Bogotá'           : 'Bogotá' },
    { tz: 'America/Lima',         city: 'Lima' },
    { tz: 'America/Santiago',     city: 'Santiago' },
    { tz: 'America/Buenos_Aires', city: lang === 'es' ? 'Buenos Aires'     : 'Buenos Aires' },
    { tz: 'America/Sao_Paulo',    city: lang === 'es' ? 'São Paulo'        : 'São Paulo' },
    { tz: 'Asia/Dubai',           city: lang === 'es' ? 'Dubái'            : 'Dubai' },
    { tz: 'Asia/Kolkata',         city: lang === 'es' ? 'Mumbai/Delhi'     : 'Mumbai/Delhi' },
    { tz: 'Asia/Singapore',       city: lang === 'es' ? 'Singapur'         : 'Singapore' },
    { tz: 'Asia/Tokyo',           city: lang === 'es' ? 'Tokio'            : 'Tokyo' },
    { tz: 'Asia/Shanghai',        city: lang === 'es' ? 'Pekín/Shanghái'   : 'Beijing/Shanghai' },
    { tz: 'Asia/Seoul',           city: lang === 'es' ? 'Seúl'             : 'Seoul' },
    { tz: 'Australia/Sydney',     city: lang === 'es' ? 'Sídney'           : 'Sydney' },
    { tz: 'Pacific/Auckland',     city: 'Auckland' },
    { tz: 'Africa/Cairo',         city: lang === 'es' ? 'El Cairo'         : 'Cairo' },
    { tz: 'Africa/Johannesburg',  city: 'Johannesburg' },
    { tz: 'UTC',                  city: 'UTC' },
  ];

  function getGMTOffset(tz) {
    try {
      const parts = new Intl.DateTimeFormat('en', {
        timeZone: tz, timeZoneName: 'shortOffset',
      }).formatToParts(new Date());
      const v = parts.find(p => p.type === 'timeZoneName')?.value ?? 'GMT';
      return v.replace('GMT+0', 'GMT').replace('GMT-0', 'GMT');
    } catch { return 'GMT'; }
  }

  function updateTzButton(tz) {
    document.getElementById('ccal-tz-label').textContent = TIMEZONES.find(z => z.tz === tz)?.city ?? tz;
    document.getElementById('ccal-tz-gmt').textContent   = getGMTOffset(tz);
  }

  // Build dropdown (appended to body to escape overflow:hidden)
  let tzDropdown = null;

  function buildTzDropdown() {
    if (tzDropdown) return;
    tzDropdown = document.createElement('div');
    tzDropdown.className = 'ccal-tz-dropdown';
    tzDropdown.innerHTML = `
      <div class="ccal-tz-search-wrap">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input class="ccal-tz-search" id="ccal-tz-search" type="text"
          placeholder="${lang === 'es' ? 'Buscar ciudad o zona...' : 'Search city or zone...'}"
          autocomplete="off" spellcheck="false" />
      </div>
      <ul class="ccal-tz-list" id="ccal-tz-list" role="listbox"></ul>`;
    document.body.appendChild(tzDropdown);

    tzDropdown.querySelector('#ccal-tz-search').addEventListener('input', e => {
      renderTzList(e.target.value.toLowerCase());
    });

    // Close on click outside
    document.addEventListener('click', e => {
      const btn = document.getElementById('ccal-tz-btn');
      if (!tzDropdown.contains(e.target) && !btn.contains(e.target)) closeTzDropdown();
    });
  }

  function renderTzList(filter = '') {
    const list = document.getElementById('ccal-tz-list');
    const filtered = TIMEZONES.filter(z =>
      z.city.toLowerCase().includes(filter) || z.tz.toLowerCase().includes(filter)
    );
    list.innerHTML = filtered.map(z => {
      const offset   = getGMTOffset(z.tz);
      const isSel    = z.tz === currentTZ;
      return `<li class="ccal-tz-item${isSel ? ' ccal-tz-item-sel' : ''}"
                  role="option" aria-selected="${isSel}" data-tz="${z.tz}">
        <span class="ccal-tz-item-city">${z.city}</span>
        <span class="ccal-tz-item-offset">${offset}</span>
      </li>`;
    }).join('');

    list.querySelectorAll('.ccal-tz-item').forEach(li => {
      li.addEventListener('click', () => selectTz(li.dataset.tz));
    });
  }

  function openTzDropdown() {
    buildTzDropdown();
    const btn  = document.getElementById('ccal-tz-btn');
    const rect = btn.getBoundingClientRect();
    tzDropdown.style.top    = `${rect.bottom + 6 + window.scrollY}px`;
    tzDropdown.style.left   = `${rect.left + window.scrollX}px`;
    tzDropdown.style.width  = `${Math.max(rect.width, 240)}px`;
    tzDropdown.style.display = 'block';
    btn.setAttribute('aria-expanded', 'true');
    renderTzList();
    // Scroll to selected
    setTimeout(() => {
      const sel = tzDropdown.querySelector('.ccal-tz-item-sel');
      if (sel) sel.scrollIntoView({ block: 'nearest' });
      tzDropdown.querySelector('#ccal-tz-search')?.focus();
    }, 30);
  }

  function closeTzDropdown() {
    if (!tzDropdown) return;
    tzDropdown.style.display = 'none';
    document.getElementById('ccal-tz-btn')?.setAttribute('aria-expanded', 'false');
  }

  function selectTz(tz) {
    currentTZ = tz;
    updateTzButton(tz);
    closeTzDropdown();
    availSlots = {};
    fetchPromises = {};
    renderMonth();
    if (selectedDate) {
      showPanel('loading');
      fetchMonth(selectedDate.getFullYear(), selectedDate.getMonth()).then(() => renderSlots(selectedDate));
    }
    fetchMonth(viewYear, viewMonth);
  }

  document.getElementById('ccal-tz-btn').addEventListener('click', () => {
    if (!tzDropdown || tzDropdown.style.display === 'none') openTzDropdown();
    else closeTzDropdown();
  });

  // ── Month navigation ──────────────────────────────────────────────────
  document.getElementById('ccal-prev').addEventListener('click', () => {
    viewMonth--;
    if (viewMonth < 0) { viewMonth = 11; viewYear--; }
    renderMonth();
    fetchMonth(viewYear, viewMonth);
  });

  document.getElementById('ccal-next').addEventListener('click', () => {
    viewMonth++;
    if (viewMonth > 11) { viewMonth = 0; viewYear++; }
    renderMonth();
    fetchMonth(viewYear, viewMonth);
  });

  // ── Boot ──────────────────────────────────────────────────────────────
  updateTzButton(currentTZ);
  renderMonth();
  // Auto-select today
  const today = new Date();
  fetchMonth(viewYear, viewMonth).then(() => selectDay(today));
  showPanel('loading');
})();
</script>

