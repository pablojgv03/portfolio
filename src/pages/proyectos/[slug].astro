---
import Layout from '../../layouts/Layout.astro';
import projectsData from '../../data/projects.json';

export function getStaticPaths() {
  return projectsData.proyectos.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const project = projectsData.proyectos.find((p) => p.slug === slug);
if (!project) return Astro.redirect('/404');

const badgeLabel: Record<string, string> = { web: 'Web', mobile: 'Android', desktop: 'Escritorio' };
const paragraphs = project['large-description'].es.split('\n\n').filter(Boolean);
const screenshots = (project as any).screenshots ?? [];

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": project.title,
  "description": project.description.es,
  "applicationCategory": project.badge === 'mobile' ? 'MobileApplication' : 'WebApplication',
  ...(project.link !== '#' && { "url": project.link }),
  ...(project.image && { "image": `https://pablogomezvillen.com${project.image}` }),
  "author": { "@type": "Person", "name": "Pablo Gómez", "url": "https://pablogomezvillen.com" }
};
---

<Layout
  title={`${project.title} — Proyecto · Pablo Gómez`}
  lang="es"
  description={project.description.es}
  canonical={`https://pablogomezvillen.com/proyectos/${slug}`}
  alternateEs={`https://pablogomezvillen.com/proyectos/${slug}`}
  alternateEn={`https://pablogomezvillen.com/en/proyectos/${slug}`}
  ogImage={project.image || '/img/opengraph.png'}
  jsonLd={[softwareSchema]}
  showHero={false}
>

  <!-- ══════════════════════════════════════
       HERO — imagen de fondo full-bleed
       ══════════════════════════════════════ -->
  <div
    class="pd-hero"
    style={project.image ? `--hero-bg: url('${project.image}')` : ''}
  >
    <div class="pd-hero-inner">
      <nav class="pd-crumb" aria-label="Miga de pan">
        <a href="/">Inicio</a>
        <span aria-hidden="true">›</span>
        <a href="/proyectos">Proyectos</a>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{project.title}</span>
      </nav>

      <span class={`pd-type-chip badge-${project.badge}`}>
        {badgeLabel[project.badge] ?? project.badge}
      </span>

      <h1 class="pd-hero-title">{project.title}</h1>
      <p class="pd-hero-sub">{project.description.es}</p>

      <div class="pd-hero-actions">
        {project.link && project.link !== '#' && (
          <a href={project.link} target="_blank" rel="noopener noreferrer" class="pd-cta pd-cta--primary">
            Ver demo en vivo
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          </a>
        )}
        {project['link-text'] && project['link-text'] !== '#' && (
          <a href={project['link-text']} target="_blank" rel="noopener noreferrer" class="pd-cta pd-cta--ghost">
            GitHub
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/></svg>
          </a>
        )}
      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════
       DESCRIPCIÓN + STACK
       ══════════════════════════════════════ -->
  <section class="section pd-content">
    <div class="pd-body">
      <div class="pd-desc">
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <aside class="pd-aside">
        <p class="pd-aside-label">Stack tecnológico</p>
        <div class="pd-skills">
          {project.skills.map((s) => (
            <span class={`skill ${s.level ?? ''}`}>{s.name}</span>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <!-- ══════════════════════════════════════
       GALERÍA DE CAPTURAS
       ══════════════════════════════════════ -->
  {screenshots.length > 0 && (
    <div class="pd-screens">
      <div class="pd-screens-inner">

        <div class="pd-screens-head">
          <p class="pd-screens-eyebrow">Interfaz real</p>
          <h2 class="pd-screens-title">Capturas de pantalla</h2>
        </div>

        <div class="pd-phones">
          {screenshots.map((s: any, i: number) => (
            <div class={`pd-phone-slot pd-phone-slot--${i}`}>
              <p class="pd-phone-label">{s.title}</p>
              <div class="pd-phone">
                <div class="pd-phone-speaker"></div>
                <div class="pd-phone-screen">
                  <img
                    src={s.src}
                    alt={s.alt}
                    loading="lazy"
                    decoding="async"
                    width="397"
                    height="841"
                  />
                </div>
                <div class="pd-phone-home"></div>
              </div>
              <p class="pd-phone-caption">{s.caption}</p>
            </div>
          ))}
        </div>

      </div>
    </div>
  )}

  <!-- ══════════════════════════════════════
       BOTÓN VOLVER
       ══════════════════════════════════════ -->
  <div class="section pd-back-wrap">
    <a href="/proyectos" class="btn secondary">← Volver a proyectos</a>
  </div>

</Layout>

<style>
/* ───────────────────────────────────────────
   HERO
─────────────────────────────────────────── */
.pd-hero {
  min-height: 72vh;
  background-image:
    linear-gradient(
      160deg,
      rgba(10, 8, 25, 0.55) 0%,
      rgba(10, 8, 25, 0.70) 45%,
      rgba(10, 8, 25, 0.97) 100%
    ),
    var(--hero-bg, linear-gradient(135deg, #1e3c72, #2a5298));
  background-size: cover;
  background-position: center top;
  display: flex;
  align-items: flex-end;
}

.pd-hero-inner {
  width: 100%;
  max-width: 860px;
  margin: 0 auto;
  padding: 64px 24px 56px;
}

.pd-crumb {
  font-size: 0.78rem;
  color: rgba(255,255,255,0.5);
  margin-bottom: 22px;
  display: flex;
  align-items: center;
  gap: 6px;
}
.pd-crumb a {
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  transition: color 0.15s;
}
.pd-crumb a:hover { color: #fff; }

.pd-type-chip {
  display: inline-block;
  padding: 3px 13px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  color: #fff;
  margin-bottom: 16px;
}
.badge-web    { background: rgba(124, 58, 237, 0.85); backdrop-filter: blur(4px); }
.badge-mobile { background: rgba(239, 68, 68, 0.85);  backdrop-filter: blur(4px); }
.badge-desktop{ background: rgba(16, 185, 129, 0.85); backdrop-filter: blur(4px); }

.pd-hero-title {
  font-size: clamp(2.2rem, 5vw, 3.4rem);
  font-weight: 900;
  color: #fff;
  line-height: 1.08;
  letter-spacing: -0.03em;
  margin-bottom: 14px;
}

.pd-hero-sub {
  font-size: 1.05rem;
  color: rgba(255,255,255,0.68);
  line-height: 1.55;
  max-width: 560px;
  margin-bottom: 32px;
}

.pd-hero-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.pd-cta {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 11px 22px;
  border-radius: 10px;
  font-size: 0.9rem;
  font-weight: 700;
  text-decoration: none;
  transition: transform 0.18s, filter 0.18s;
}
.pd-cta:hover { transform: translateY(-2px); filter: brightness(1.1); }
.pd-cta:active { transform: scale(0.97); }

.pd-cta--primary {
  background: linear-gradient(135deg, #7c3aed, #4f46e5);
  color: #fff;
  box-shadow: 0 4px 18px rgba(124,58,237,0.4);
}
.pd-cta--ghost {
  background: rgba(255,255,255,0.1);
  color: #fff;
  border: 1.5px solid rgba(255,255,255,0.25);
  backdrop-filter: blur(6px);
}

/* ───────────────────────────────────────────
   DESCRIPCIÓN + STACK
─────────────────────────────────────────── */
.pd-content { max-width: 860px; margin: 0 auto; padding-top: 48px; }

.pd-body {
  display: grid;
  grid-template-columns: 1fr 210px;
  gap: 48px;
  align-items: start;
}

.pd-desc p {
  line-height: 1.8;
  color: #444;
  font-size: 0.975rem;
  margin-bottom: 1.1em;
}
.pd-desc p:last-child { margin-bottom: 0; }

.pd-aside {
  background: #f8faff;
  border: 1.5px solid #e4ecf8;
  border-radius: 14px;
  padding: 20px;
  position: sticky;
  top: 80px;
}
.pd-aside-label {
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 700;
  color: #7c3aed;
  margin-bottom: 14px;
}
.pd-skills { display: flex; flex-direction: column; gap: 7px; }

/* ───────────────────────────────────────────
   GALERÍA
─────────────────────────────────────────── */
.pd-screens {
  margin-top: 64px;
  background: linear-gradient(170deg, #09090f 0%, #130820 50%, #0a1628 100%);
  padding: 72px 24px 80px;
}

.pd-screens-inner {
  max-width: 860px;
  margin: 0 auto;
}

.pd-screens-head {
  text-align: center;
  margin-bottom: 60px;
}

.pd-screens-eyebrow {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #7c3aed;
  margin-bottom: 10px;
}

.pd-screens-title {
  font-size: clamp(1.7rem, 4vw, 2.4rem);
  font-weight: 900;
  color: #fff;
  letter-spacing: -0.04em;
  line-height: 1;
}

/* Grid de teléfonos */
.pd-phones {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32px;
  align-items: end;
  justify-items: center;
}

.pd-phone-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Rotaciones para dar profundidad */
.pd-phone-slot--0 { transform: rotate(-4deg) translateY(16px); }
.pd-phone-slot--1 { transform: rotate(0deg)  translateY(-10px); }
.pd-phone-slot--2 { transform: rotate(4deg)  translateY(16px); }

/* Etiqueta sobre el móvil */
.pd-phone-label {
  font-size: 0.88rem;
  font-weight: 800;
  color: #fff;
  letter-spacing: -0.01em;
  text-align: center;
  margin-bottom: 18px;
  position: relative;
}
.pd-phone-label::after {
  content: '';
  display: block;
  width: 32px;
  height: 2px;
  background: linear-gradient(90deg, #7c3aed, #a78bfa);
  border-radius: 2px;
  margin: 7px auto 0;
}

/* Marco del móvil */
.pd-phone {
  width: 195px;
  background: #111118;
  border-radius: 44px;
  padding: 14px 10px 16px;
  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,0.07),
    0 0 0 2px rgba(255,255,255,0.04),
    0 30px 60px rgba(0,0,0,0.7),
    0 10px 20px rgba(0,0,0,0.4);
  transition: transform 0.35s cubic-bezier(0.2, 0.9, 0.2, 1),
              box-shadow 0.35s ease;
  cursor: default;
}

.pd-phone-slot:hover .pd-phone {
  transform: scale(1.04) translateY(-10px);
  box-shadow:
    inset 0 0 0 1px rgba(124,58,237,0.3),
    0 0 0 2px rgba(124,58,237,0.12),
    0 40px 80px rgba(0,0,0,0.8),
    0 0 40px rgba(124,58,237,0.15);
}

/* Altavoz / notch superior */
.pd-phone-speaker {
  width: 56px;
  height: 6px;
  background: rgba(255,255,255,0.12);
  border-radius: 3px;
  margin: 0 auto 10px;
}

/* Pantalla */
.pd-phone-screen {
  border-radius: 28px;
  overflow: hidden;
  background: #000;
  line-height: 0;
}
.pd-phone-screen img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 28px;
}

/* Barra home */
.pd-phone-home {
  width: 50px;
  height: 4px;
  background: rgba(255,255,255,0.18);
  border-radius: 2px;
  margin: 12px auto 0;
}

/* Caption */
.pd-phone-caption {
  font-size: 0.74rem;
  color: rgba(255,255,255,0.38);
  text-align: center;
  max-width: 190px;
  line-height: 1.55;
  margin-top: 20px;
}

/* ───────────────────────────────────────────
   VOLVER
─────────────────────────────────────────── */
.pd-back-wrap {
  max-width: 860px;
  margin: 0 auto;
  padding-top: 40px;
  padding-bottom: 8px;
}

/* ───────────────────────────────────────────
   RESPONSIVE
─────────────────────────────────────────── */
@media (max-width: 760px) {
  .pd-body { grid-template-columns: 1fr; }
  .pd-aside { position: static; }

  .pd-phones {
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .pd-phone { width: 100%; max-width: 150px; border-radius: 34px; }
  .pd-phone-speaker { width: 40px; }
  .pd-phone-screen { border-radius: 22px; }
  .pd-phone-screen img { border-radius: 22px; }

  /* Reducir rotaciones en móvil */
  .pd-phone-slot--0 { transform: rotate(-2deg) translateY(8px); }
  .pd-phone-slot--2 { transform: rotate(2deg)  translateY(8px); }
}

@media (max-width: 480px) {
  .pd-hero { min-height: 80vw; }
  .pd-hero-inner { padding: 40px 18px 36px; }
  .pd-phones { gap: 10px; }
  .pd-phone { max-width: 120px; border-radius: 26px; }
  .pd-phone-label { font-size: 0.78rem; }
  .pd-screens { padding: 48px 16px 56px; }
}
</style>
