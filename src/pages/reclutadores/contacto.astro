---
import LayoutReclutadores from '../../layouts/LayoutReclutadores.astro';
---

<LayoutReclutadores title="Contacto — Pablo Gómez | Full Stack Developer">

  <div class="page-banner">
    <h1>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Hablemos
    </h1>
    <p>Cuéntame qué buscas — respondo en menos de 24 horas</p>
  </div>

  <div class="contacto-page">

    <div>
      <h2 style="font-size:1.3rem;font-weight:700;color:#1e3c72;margin-bottom:20px;">Envíame un mensaje</h2>

      <form class="contact-form" action="https://formspree.io/f/xbdboaye" method="POST">
        <div class="contact-form-group">
          <label for="cf-nombre">Nombre *</label>
          <input type="text" id="cf-nombre" name="nombre" required placeholder="Tu nombre" autocomplete="name" />
        </div>

        <div class="contact-form-group">
          <label for="cf-email">Email *</label>
          <input type="email" id="cf-email" name="email" required placeholder="tu@empresa.com" autocomplete="email" />
        </div>

        <div class="contact-form-group">
          <label for="cf-empresa">Empresa (opcional)</label>
          <input type="text" id="cf-empresa" name="empresa" placeholder="Nombre de tu empresa" autocomplete="organization" />
        </div>

        <div class="contact-form-group">
          <label for="cf-tipo">Motivo del contacto *</label>
          <select id="cf-tipo" name="tipo_proyecto" required>
            <option value="" disabled selected>Selecciona una opción...</option>
            <option value="incorporacion">Incorporación como desarrollador</option>
            <option value="freelance">Proyecto freelance / contrato temporal</option>
            <option value="colaboracion">Colaboración puntual</option>
            <option value="otro">Otro</option>
          </select>
        </div>

        <div class="contact-form-group">
          <label for="cf-mensaje">Mensaje *</label>
          <textarea id="cf-mensaje" name="mensaje" required placeholder="Cuéntame en qué puedo ayudarte..."></textarea>
        </div>

        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div id="form-feedback" role="alert" aria-live="polite" style="display:none;padding:12px 16px;border-radius:8px;font-size:0.9rem;margin-bottom:12px"></div>

        <button type="submit" class="contact-form-btn" id="form-submit-btn">
          Enviar mensaje →
        </button>
      </form>
    </div>

    <script>
      const form = document.querySelector('.contact-form');
      const feedback = document.getElementById('form-feedback');
      const btn = document.getElementById('form-submit-btn');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!btn || !feedback) return;
        const originalText = btn.textContent ?? 'Enviar mensaje →';
        btn.textContent = 'Enviando...';
        btn.disabled = true;
        feedback.style.display = 'none';
        try {
          const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          if (res.ok) {
            window.location.href = '/gracias';
          } else {
            const data = await res.json().catch(() => ({}));
            const msg = data.errors?.map((err) => err.message).join('. ') || 'Ha ocurrido un error. Inténtalo de nuevo.';
            showError(msg);
          }
        } catch {
          showError('Error de conexión. Comprueba tu internet e inténtalo de nuevo.');
        }
        function showError(msg) {
          feedback.textContent = msg;
          Object.assign(feedback.style, { display: 'block', background: '#fee2e2', color: '#991b1b', border: '1px solid #fca5a5' });
          btn.textContent = originalText;
          btn.disabled = false;
        }
      });
    </script>

    <div class="contact-info-panel">
      <h3>Información de contacto</h3>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">📧</span>
        <div>
          <span class="contact-info-label">Email</span>
          <a href="mailto:pablogomezvillen@gmail.com" class="contact-info-val">pablogomezvillen@gmail.com</a>
        </div>
      </div>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">💼</span>
        <div>
          <span class="contact-info-label">LinkedIn</span>
          <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer" class="contact-info-val">pablo-gomez-villen</a>
        </div>
      </div>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">📞</span>
        <div>
          <span class="contact-info-label">Teléfono</span>
          <a href="tel:+34622400727" class="contact-info-val">+34 622 400 727</a>
        </div>
      </div>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">📍</span>
        <div>
          <span class="contact-info-label">Ubicación</span>
          <span class="contact-info-val" style="cursor:default">Granada, España<br><small style="font-weight:400;color:#696969">Disponible para trabajo presencial, híbrido o remoto</small></span>
        </div>
      </div>

      <div class="contact-respuesta">
        ⏱️ Tiempo de respuesta habitual: <strong>menos de 24 horas</strong> en días laborables
      </div>
    </div>

  </div>

</LayoutReclutadores>
