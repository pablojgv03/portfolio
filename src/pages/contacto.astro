---
import Layout from '../layouts/Layout.astro';

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.pablogomezvillen.com",
  "name": "Pablo Gómez Villén — Desarrollo Web",
  "description": "Desarrollo de páginas web profesionales y SEO local para negocios en Granada y España",
  "url": "https://www.pablogomezvillen.com",
  "telephone": "+34622400727",
  "email": "pablogomezvillen@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Granada",
    "addressRegion": "Andalucía",
    "addressCountry": "ES"
  },
  "areaServed": ["Granada", "Andalucía", "España"],
  "serviceType": ["Diseño web", "SEO local", "Desarrollo Full Stack"]
};
---

<Layout
  title="Contacto | Pablo Gómez — Desarrollo Web en Granada"
  lang="es"
  description="Pide presupuesto para tu página web o proyecto digital. Respuesta en menos de 24 horas. Sin compromiso."
  canonical="https://www.pablogomezvillen.com/contacto"
  alternateEs="https://www.pablogomezvillen.com/contacto"
  alternateEn="https://www.pablogomezvillen.com/en/contact"
  showHero={false}
  keywords="contacto desarrollador web Granada, presupuesto web, contratar programador Granada"
  jsonLd={[localBusinessSchema]}
>

  <div class="page-banner">
    <h1>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Hablemos
    </h1>
    <p>Cuéntame qué necesitas — respondo en menos de 24 horas</p>
  </div>

  <div class="contacto-page">

    <!-- Formulario -->
    <div>
      <h2 style="font-size:1.3rem;font-weight:700;color:#1e3c72;margin-bottom:20px;">Envíame un mensaje</h2>

      <!--
        Para activar el formulario:
        1. Crea una cuenta gratuita en https://formspree.io
        2. Crea un nuevo formulario y copia tu endpoint
        3. Reemplaza "YOUR_FORM_ID" por tu ID real
      -->
      <form
        class="contact-form"
        action="https://formspree.io/f/xbdboaye"
        method="POST"
      >
        <div class="contact-form-group">
          <label for="cf-nombre">Nombre *</label>
          <input type="text" id="cf-nombre" name="nombre" required placeholder="Tu nombre" autocomplete="name" />
        </div>

        <div class="contact-form-group">
          <label for="cf-email">Email *</label>
          <input type="email" id="cf-email" name="email" required placeholder="tu@email.com" autocomplete="email" />
        </div>

        <div class="contact-form-group">
          <label for="cf-tel">Teléfono (opcional)</label>
          <input type="tel" id="cf-tel" name="telefono" placeholder="+34 600 000 000" autocomplete="tel" />
        </div>

        <div class="contact-form-group">
          <label for="cf-tipo">Tipo de proyecto *</label>
          <select id="cf-tipo" name="tipo_proyecto" required>
            <option value="" disabled selected>Selecciona una opción...</option>
            <option value="web-negocio">Web para mi negocio</option>
            <option value="seo">SEO y posicionamiento local</option>
            <option value="app">App o desarrollo a medida</option>
            <option value="mantenimiento">Mantenimiento web</option>
            <option value="otro">Otro</option>
          </select>
        </div>

        <div class="contact-form-group">
          <label for="cf-plan">Plan de interés</label>
          <select id="cf-plan" name="plan_interes">
            <option value="" selected>Sin preferencia / consultarlo</option>
            <option value="basico">Plan Básico — desde 350 €</option>
            <option value="negocio">Plan Negocio — desde 650 €</option>
            <option value="premium">Plan Premium — precio a consultar</option>
          </select>
        </div>

        <div class="contact-form-group">
          <label for="cf-mensaje">Mensaje *</label>
          <textarea id="cf-mensaje" name="mensaje" required placeholder="Cuéntame en qué puedo ayudarte..."></textarea>
        </div>

        <!-- Honeypot anti-spam: Formspree rechaza el envío si este campo tiene valor -->
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">

        <div id="form-feedback" role="alert" aria-live="polite" style="display:none;padding:12px 16px;border-radius:8px;font-size:0.9rem;margin-bottom:12px"></div>

        <button type="submit" class="contact-form-btn" id="form-submit-btn">
          Enviar mensaje →
        </button>
      </form>
    </div>

    <script>
      const params = new URLSearchParams(window.location.search);
      const plan = params.get('plan');
      if (plan) {
        const select = document.getElementById('cf-plan') as HTMLSelectElement | null;
        if (select) select.value = plan;
      }

      const form = document.querySelector('.contact-form') as HTMLFormElement | null;
      const feedback = document.getElementById('form-feedback') as HTMLElement | null;
      const btn = document.getElementById('form-submit-btn') as HTMLButtonElement | null;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!btn || !feedback) return;

        const originalText = btn.textContent ?? 'Enviar mensaje →';
        btn.textContent = 'Enviando...';
        btn.disabled = true;
        feedback.style.display = 'none';

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });

          if (res.ok) {
            window.location.href = '/gracias';
          } else {
            const data: { errors?: { message: string }[] } = await res.json().catch(() => ({}));
            const msg = data.errors?.map((err) => err.message).join('. ') || 'Ha ocurrido un error. Inténtalo de nuevo o escríbeme por WhatsApp.';
            showError(msg);
          }
        } catch {
          showError('Error de conexión. Comprueba tu internet e inténtalo de nuevo.');
        }

        function showError(msg: string) {
          feedback!.textContent = msg;
          Object.assign(feedback!.style, { display: 'block', background: '#fee2e2', color: '#991b1b', border: '1px solid #fca5a5' });
          btn!.textContent = originalText;
          btn!.disabled = false;
        }
      });
    </script>

    <!-- Info de contacto -->
    <div class="contact-info-panel">
      <h3>Información de contacto</h3>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">💬</span>
        <div>
          <span class="contact-info-label">WhatsApp</span>
          <a
            href="https://wa.me/34622400727?text=Hola%20Pablo%2C%20me%20interesa%20hablar%20sobre%20mi%20web"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-info-val"
          >+34 622 400 727</a>
        </div>
      </div>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">📧</span>
        <div>
          <span class="contact-info-label">Email</span>
          <a href="mailto:pablogomezvillen@gmail.com" class="contact-info-val">pablogomezvillen@gmail.com</a>
        </div>
      </div>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">💼</span>
        <div>
          <span class="contact-info-label">LinkedIn</span>
          <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer" class="contact-info-val">pablo-gomez-villen</a>
        </div>
      </div>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">📍</span>
        <div>
          <span class="contact-info-label">Ubicación</span>
          <span class="contact-info-val" style="cursor:default">Granada, España<br><small style="font-weight:400;color:#696969">Trabajo en remoto con negocios de toda España</small></span>
        </div>
      </div>

      <div class="contact-respuesta">
        ⏱️ Tiempo de respuesta habitual: <strong>menos de 24 horas</strong> en días laborables
      </div>

      <!-- Separador -->
      <div style="border-top:1px solid #e4ecf8;margin:24px 0;"></div>

      <!-- Alternativa: reservar reunión -->
      <div class="contact-booking-alt">
        <p class="contact-booking-alt-title">¿Prefieres hablar directamente?</p>
        <p class="contact-booking-alt-desc">Reserva una llamada gratuita de 20 minutos y charlamos sin compromiso.</p>
        <a href="/reserva" class="contact-booking-alt-btn">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Agendar reunión gratis
        </a>
      </div>
    </div>

  </div>

</Layout>

<style>
  .contact-booking-alt {
    background: #eef4ff;
    border: 1px solid #c7d9f5;
    border-radius: 12px;
    padding: 20px;
    text-align: center;
  }

  .contact-booking-alt-title {
    font-weight: 700;
    color: #1e3c72;
    font-size: 0.95rem;
    margin-bottom: 6px;
  }

  .contact-booking-alt-desc {
    font-size: 0.85rem;
    color: #4b5563;
    margin-bottom: 14px;
    line-height: 1.4;
  }

  .contact-booking-alt-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1e3c72;
    color: #ffce00;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 10px 22px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.18s ease, transform 0.18s ease;
  }

  .contact-booking-alt-btn:hover {
    background: #2a5298;
    transform: translateY(-2px);
  }
</style>
