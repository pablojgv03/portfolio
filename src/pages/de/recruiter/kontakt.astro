---
import LayoutReclutadores from '../../../layouts/LayoutReclutadores.astro';
---

<LayoutReclutadores title="Kontakt — Pablo Gómez | Full-Stack-Entwickler" lang="de">

  <div class="page-banner">
    <h1>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Lass uns reden
    </h1>
    <p>Erzähl mir, wonach du suchst — ich antworte innerhalb von 24 Stunden</p>
  </div>

  <div class="contacto-page">

    <div>
      <h2 style="font-size:1.3rem;font-weight:700;color:#1e3c72;margin-bottom:20px;">Schreib mir eine Nachricht</h2>

      <form class="contact-form" action="https://formspree.io/f/xbdboaye" method="POST">
        <div class="contact-form-group">
          <label for="cf-nombre">Name *</label>
          <input type="text" id="cf-nombre" name="nombre" required placeholder="Dein Name" autocomplete="name" />
        </div>

        <div class="contact-form-group">
          <label for="cf-email">E-Mail *</label>
          <input type="email" id="cf-email" name="email" required placeholder="du@unternehmen.com" autocomplete="email" />
        </div>

        <div class="contact-form-group">
          <label for="cf-empresa">Unternehmen (optional)</label>
          <input type="text" id="cf-empresa" name="empresa" placeholder="Name deines Unternehmens" autocomplete="organization" />
        </div>

        <div class="contact-form-group">
          <label for="cf-tipo">Grund der Kontaktaufnahme *</label>
          <select id="cf-tipo" name="tipo_proyecto" required>
            <option value="" disabled selected>Option wählen...</option>
            <option value="incorporacion">Festanstellung als Entwickler</option>
            <option value="freelance">Freelance / befristeter Vertrag</option>
            <option value="colaboracion">Einmalige Zusammenarbeit</option>
            <option value="otro">Sonstiges</option>
          </select>
        </div>

        <div class="contact-form-group">
          <label for="cf-mensaje">Nachricht *</label>
          <textarea id="cf-mensaje" name="mensaje" required placeholder="Erzähl mir, wie ich dir helfen kann..."></textarea>
        </div>

        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">
        <div id="form-feedback" role="alert" aria-live="polite" style="display:none;padding:12px 16px;border-radius:8px;font-size:0.9rem;margin-bottom:12px"></div>

        <button type="submit" class="contact-form-btn" id="form-submit-btn">
          Nachricht senden →
        </button>
      </form>
    </div>

    <script>
      const form = document.querySelector('.contact-form');
      const feedback = document.getElementById('form-feedback');
      const btn = document.getElementById('form-submit-btn');

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!btn || !feedback) return;
        const originalText = btn.textContent ?? 'Nachricht senden →';
        btn.textContent = 'Wird gesendet...';
        btn.disabled = true;
        feedback.style.display = 'none';
        try {
          const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
          if (res.ok) {
            window.location.href = '/de/danke';
          } else {
            const data = await res.json().catch(() => ({}));
            const msg = data.errors?.map((err) => err.message).join('. ') || 'Etwas ist schiefgelaufen. Bitte versuche es erneut.';
            showError(msg);
          }
        } catch {
          showError('Verbindungsfehler. Prüfe deine Internetverbindung und versuche es erneut.');
        }
        function showError(msg) {
          feedback.textContent = msg;
          Object.assign(feedback.style, { display: 'block', background: '#fee2e2', color: '#991b1b', border: '1px solid #fca5a5' });
          btn.textContent = originalText;
          btn.disabled = false;
        }
      });
    </script>

    <div class="contact-info-panel">
      <h3>Kontaktinformationen</h3>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">📧</span>
        <div>
          <span class="contact-info-label">E-Mail</span>
          <a href="mailto:pablogomezvillen@gmail.com" class="contact-info-val">pablogomezvillen@gmail.com</a>
        </div>
      </div>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">💼</span>
        <div>
          <span class="contact-info-label">LinkedIn</span>
          <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer" class="contact-info-val">pablo-gomez-villen</a>
        </div>
      </div>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">📞</span>
        <div>
          <span class="contact-info-label">Telefon</span>
          <a href="tel:+34622400727" class="contact-info-val">+34 622 400 727</a>
        </div>
      </div>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">📍</span>
        <div>
          <span class="contact-info-label">Standort</span>
          <span class="contact-info-val" style="cursor:default">Granada, Spanien<br><small style="font-weight:400;color:#696969">Vor Ort, hybrid oder komplett remote verfügbar</small></span>
        </div>
      </div>

      <div class="contact-respuesta">
        ⏱️ Übliche Antwortzeit: <strong>unter 24 Stunden</strong> an Werktagen
      </div>
    </div>

  </div>

</LayoutReclutadores>
