---
import '../styles/global.css';
import ContactScript from '../components/ContactScript.astro';

export const prerender = false;
const {
  title,
  lang = 'es',
  showHero = true,
  description,
  canonical,
  keywords,
  ogImage = '/img/opengraph.png',
  jsonLd,
  lcp,
} = Astro.props;

const ogImageAbsolute = `https://pablogomezvillen.com${ogImage}`;
const ogLocale = lang === 'en' ? 'en_US' : 'es_ES';
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="robots" content="index, follow">
    <meta name="author" content="Pablo Gómez">
    {description && <meta name="description" content={description}>}
    {keywords && <meta name="keywords" content={keywords}>}
    {canonical && <link rel="canonical" href={canonical}>}

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:locale" content={ogLocale}>
    <meta property="og:site_name" content="Pablo Gómez - Portfolio">
    <meta property="og:title" content={title}>
    {description && <meta property="og:description" content={description}>}
    {canonical && <meta property="og:url" content={canonical}>}
    <meta property="og:image" content={ogImageAbsolute}>

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    {description && <meta name="twitter:description" content={description}>}
    <meta name="twitter:image" content={ogImageAbsolute}>

    <!-- JSON-LD -->
    {jsonLdList.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <meta name="theme-color" content="#1e3c72">
    <link rel="modulepreload" href="/scripts/i18n.js">
    {lcp && <link rel="preload" href={lcp} as="image" fetchpriority="high">}
  </head>
  <body class="contact-open">
    <!-- Header -->
    <header class="navbar">
      <div class="navbar-container">
        <!-- Logo -->
        <a href="/" class="logo" aria-label="Ir al inicio">
          <img src="/favicon.ico" alt="Pablo Gómez - Portfolio" />
        </a>

        <!-- Menú de escritorio -->
        <nav class="nav-links desktop">
          <!-- PROYECTOS OCULTO temporalmente (en construcción)
          <a href="/proyectos" data-i18n="nav.projects">Proyectos</a>
          -->
          <a href="/experiencia" data-i18n="nav.experience">Experiencia</a>
          <a href="/pablo-gomez-villen" data-i18n="nav.about">Sobre mí</a>
          <a href="/blog" data-i18n="nav.blog">Blog</a>
        </nav>

        <!-- Toggle idioma (solo escritorio) -->
        <div class="lang-toggle desktop-only" aria-label="Cambiar idioma">
          <input type="checkbox" id="lang-switch" />
          <label for="lang-switch" class="lang-label">
            <span class="flag flag-es " onclick="setLanguage('es')"><img src="/img/flags/es.svg" alt="Cambiar idioma a Español"></span>
            <span class="flag flag-en" onclick="setLanguage('en')"><img src="/img/flags/gb.svg" alt="Switch language to English"></span>
            <span class="toggle-slider"></span>
          </label>
        </div>

        <!-- Botón menú móvil -->
        <button class="nav-toggle" aria-label="Abrir menú">☰</button>
      </div>

      <!-- Menú móvil -->
      <nav class="nav-links mobile" id="mobileMenu">
        <div class="menu-header">
          <a href="/" class="logo" aria-label="Ir al inicio">
            <img src="/favicon.ico" alt="Pablo Gómez - Portfolio" />
          </a>
          <button class="close-menu" aria-label="Cerrar menú">✕</button>
        </div>
        <!-- PROYECTOS OCULTO temporalmente (en construcción)
        <a href="/proyectos" data-i18n="nav.projects">Proyectos</a>
        -->
        <a href="/experiencia" data-i18n="nav.experience">Experiencia</a>
        <a href="/pablo-gomez-villen" data-i18n="nav.about">Sobre mí</a>
        <a href="/blog" data-i18n="nav.blog">Blog</a>

        <!-- Toggle idioma (solo móvil) -->
        <div class="lang-toggle mobile-only" aria-label="Cambiar idioma">
          <input type="checkbox" id="lang-switch-mobile" />
          <label for="lang-switch-mobile" class="lang-label">
            <span class="flag flag-es"><img src="/img/flags/es.svg" alt="Cambiar idioma a Español"></span>
            <span class="flag flag-en"><img src="/img/flags/gb.svg" alt="Switch language to English"></span>
            <span class="toggle-slider"></span>
          </label>
        </div>
      </nav>
    </header>

    <!-- Hero -->
    {showHero && (
      <header class="hero">
        <div class="hero-content">
          <h1 data-i18n="hero.greeting">👋 Hola, soy <span>Pablo Gómez</span></h1>
          <p data-i18n="hero.role">Desarrollador Full Stack | PHP · Laravel · JavaScript · MySQL</p>
          <div class="hero-buttons">
            <!-- PROYECTOS OCULTO temporalmente (en construcción)
            <a href="#proyectos" class="btn" data-i18n="hero.btnProjects"></a>
            -->
            <a href="CV_·_Pablo_Gomez_Software-Developer.pdf" target="_blank" class="btn secondary" data-i18n="hero.btnCV">📄 Descargar CV</a>
          </div>
        </div>
      </header>
    )}

    <!-- Slot -->
  <main id="main-content">
    <slot lang={lang} />
  </main>

    <!-- Footer -->
    <footer>
      <p data-i18n="rights">© 2026 Pablo Gómez Villén || Programador Full Stack</p>
    </footer>

    <!-- Contact Script -->
    <ContactScript />

    <!-- Scripts -->
    <script type="module">
      import { loadLanguage, getLanguage, setLanguage } from '/scripts/i18n.js';

      window.addEventListener('DOMContentLoaded', () => {
        const toggle = document.querySelector('.nav-toggle');
        const menu = document.getElementById('mobileMenu');
        const closeBtn = document.querySelector('.close-menu');
        const langSwitches = document.querySelectorAll('#lang-switch, #lang-switch-mobile');

        // --- Menú móvil ---
        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          menu.classList.toggle('show');
          document.body.style.overflow = menu.classList.contains('show') ? 'hidden' : '';
        });

        closeBtn.addEventListener('click', () => {
          menu.classList.remove('show');
          document.body.style.overflow = '';
        });

        document.addEventListener('click', (e) => {
          if (menu.classList.contains('show') && !menu.contains(e.target) && !toggle.contains(e.target)) {
            menu.classList.remove('show');
            document.body.style.overflow = '';
          }
        });

        // --- Idioma ---
        const cookieLang = getLanguage();
        langSwitches.forEach(sw => sw.checked = cookieLang === 'en');

        // El español está pre-renderizado en el HTML, solo cargar para otros idiomas
        if (cookieLang !== 'es') {
          loadLanguage(cookieLang);
        }

        langSwitches.forEach(sw => {
          sw.addEventListener('change', (e) => {
            const checked = e.target.checked;
            langSwitches.forEach(other => other.checked = checked);
            const idioma = checked ? 'en' : 'es';
            setLanguage(idioma);
            loadLanguage(idioma); // Traducir inmediatamente sin recargar
          });
        });
      });
    </script>
  </body>
</html>