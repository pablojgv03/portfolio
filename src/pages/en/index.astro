---
import Layout from '../../layouts/Layout.astro';
import esData from '../../data/i18n/es.json';
import enData from '../../data/i18n/en.json';
import projectsData from '../../data/projects.json';

function fmtDate(d) {
  if (!d || !/^\d{4}-\d{2}-\d{2}$/.test(d)) return d || '';
  const [y, m] = d.split('-');
  return `${ ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][parseInt(m,10)-1] }. ${y}`;
}

// Featured articles: use es.json for featured/date, en.json for content
const featuredPosts = Object.entries(esData.blog)
  .filter(([, p]) => p.featured && !p.hidden)
  .sort(([, a], [, b]) => (b.date || '').localeCompare(a.date || ''))
  .slice(0, 3)
  .map(([slug, p]) => ({ slug, ...p, ...(enData.blog?.[slug] || {}) }));

const en = enData;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Pablo Gómez",
  "jobTitle": "Full Stack Developer",
  "url": "https://pablogomezvillen.com",
  "email": "pablogomezvillen@gmail.com",
  "telephone": "+34622400727",
  "image": "https://pablogomezvillen.com/img/foto-empresa.jpg",
  "address": { "@type": "PostalAddress", "addressLocality": "Granada", "addressCountry": "ES" },
  "sameAs": ["https://www.linkedin.com/in/pablo-gomez-villen"]
};
---

<Layout
  title="Pablo Gómez — Full Stack Developer Laravel & PHP | Portfolio"
  lang="en"
  description="Portfolio of Pablo Gómez, Full Stack Developer specializing in Laravel, PHP, JavaScript and MySQL. Over 1 year of production experience in Granada, Spain."
  canonical="https://pablogomezvillen.com/en/"
  alternateEs="https://pablogomezvillen.com/"
  alternateEn="https://pablogomezvillen.com/en/"
  keywords="Full Stack Developer, Laravel, PHP, JavaScript, MySQL, Google Cloud, ElasticSearch, web developer, Granada, Spain"
  jsonLd={[personSchema]}
  lcp="/img/foto-empresa.webp"
>
  <!-- About -->
  <section id="sobre-mi" class="section">
    <h2>
      <svg class="section-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      {en['section-sobre-mi'].title}
    </h2>
    <div class="about-grid">
      <div class="about-left">
        <picture>
          <source type="image/webp" srcset="/img/foto-empresa.webp">
          <img src="/img/foto-empresa.jpg" alt="Pablo Gómez, Full Stack Developer in Granada" class="avatar" width="140" height="140" fetchpriority="high">
        </picture>
        <div class="about-quick-stats">
          <div class="about-stat">
            <span class="about-stat-num">1+</span>
            <span class="about-stat-lbl">yrs exp.</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-num">2</span>
            <span class="about-stat-lbl">companies</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-num">📍</span>
            <span class="about-stat-lbl">Granada</span>
          </div>
        </div>
      </div>
      <div class="about-text">
        <p>{en['section-sobre-mi'].content}</p>
      </div>
    </div>
  </section>

  <!-- What can I help you with? -->
  <section class="dual-section">
    <div class="dual-section-inner">
      <h2>What can I help you with?</h2>
      <p class="dual-section-sub">I work with two very different types of clients — which one are you?</p>
      <div class="dual-grid">

        <div class="dual-card dual-card--negocio">
          <a href="/en/servicios" class="full-link" aria-label="See my services"></a>
          <span class="dual-card-ico" aria-hidden="true">🏪</span>
          <h3>I have a business and need clients</h3>
          <p>I build a professional website that shows up on Google when someone searches for your business in your city. No jargon, no hassle.</p>
          <ul>
            <li>✅ Modern and fast website</li>
            <li>✅ Local Google optimization</li>
            <li>✅ Google Business Profile</li>
            <li>✅ Monthly maintenance</li>
          </ul>
          <a href="/en/servicios" class="btn-primary btn--icon" style="position:relative;z-index:11">See my services <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>

        <div class="dual-card dual-card--tech">
          <a href="/en/proyectos" class="full-link" aria-label="See my projects"></a>
          <span class="dual-card-ico" aria-hidden="true">💻</span>
          <h3>I'm a company looking for a Full Stack developer</h3>
          <p>1+ year of production experience with Laravel, PHP, JavaScript and MySQL. Real projects, clean code and ability to work in a team.</p>
          <ul>
            <li>✅ Full Stack PHP / Laravel</li>
            <li>✅ Production projects</li>
            <li>✅ REST APIs, MySQL, JS</li>
            <li>✅ Immediately available</li>
          </ul>
          <div class="dual-card-btns">
            <a href="/en/proyectos" class="btn-primary btn--icon">See my projects <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
            <a href="/en/experiencia" class="btn-outlined btn--icon">See my experience <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Projects -->
  <section id="proyectos" class="section bg-light-rounded">
    <h2>
      <svg class="section-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
      {en['section-proyectos'].title}
    </h2>
    <div class="projects">
      {projectsData.proyectos.map((p) => (
        <article class={`project-card${p.image ? ' project-card--with-thumb' : ''}`} data-project-id={String(p.id)}>
          <a href={`/en/proyectos/${p.slug}`} class="full-link" aria-label={`View details for ${p.title}`}></a>
          {p.image && (
            <div class="project-card-thumb">
              <img src={p.image} alt={p.imageAlt || p.title} loading="lazy" decoding="async" width="400" height="210" />
            </div>
          )}
          <div class={p.image ? 'project-card-body' : ''}>
            <div class="meta">
              <span class="center">{p.badge === 'mobile' ? 'Android' : p.badge}</span>
            </div>
            <h3>{p.title}</h3>
            <p class="project-desc">{p.description.en}</p>
            {p.skills && p.skills.length > 0 && (
              <div class="skills" aria-label={`Skills for ${p.title}`}>
                {p.skills.slice(0, 6).map(skill => (
                  <span class={`skill ${skill.level ?? ''}`}>{skill.name}</span>
                ))}
              </div>
            )}
            <div class="links" style="position:relative;z-index:11">
              {p['link-text'] && p['link-text'] !== '#' && (
                <a href={p['link-text']} target="_blank" rel="noopener noreferrer">GitHub →</a>
              )}
              {p.link && p.link !== '#' && (
                <a href={p.link} target="_blank" rel="noopener noreferrer">Demo →</a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Education -->
  <section id="estudios" class="section">
    <h2>
      <svg class="section-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
      {en['section-estudios'].title}
    </h2>
    <div class="projects">

      <div class="project-card card--study">
        <a href="/en/blog/daw" class="full-link" aria-label="Read about DAW studies"></a>
        <h3>{en['section-estudios'].daw}</h3>
        <div class="meta">
          <span class="center">iLERNA</span>
          <span class="period"><span class="start">2025</span>–<span class="end">2026</span></span>
        </div>
        <div class="skills" aria-label="Skills from iLERNA">
          <span class="skill high">PHP</span>
          <span class="skill high">JavaScript</span>
          <span class="skill mid">MySQL</span>
          <span class="skill mid">HTML</span>
          <span class="skill mid">CSS</span>
        </div>
        <span class="tech">DAW | In progress</span>
      </div>

      <div class="project-card card--study">
        <a href="/en/blog/ia-bigdata" class="full-link" aria-label="Read about AI and Big Data specialization"></a>
        <h3>{en['section-estudios']['ia-bd']}</h3>
        <div class="meta">
          <span class="center">Campus Net Manyanet Les Corts</span>
          <span class="period"><span class="start">2025</span>–<span class="end">2025</span></span>
        </div>
        <div class="skills" aria-label="Skills from Campus Net Manyanet">
          <span class="skill high">Python</span>
          <span class="skill mid">Pandas</span>
          <span class="skill mid">ML Modeling</span>
        </div>
        <span class="tech">AI | Big Data</span>
      </div>

      <div class="project-card card--study">
        <a href="/en/blog/dam" class="full-link" aria-label="Read about DAM studies"></a>
        <h3>{en['section-estudios'].dam}</h3>
        <div class="meta">
          <span class="center">IES Francisco Ayala</span>
          <span class="period"><span class="start">2021</span>–<span class="end">2023</span></span>
        </div>
        <div class="skills">
          <span class="skill low">Odoo</span>
          <span class="skill high">SQL</span>
          <span class="skill mid">Hibernate</span>
        </div>
        <span class="tech">Mobile Dev | JavaScript</span>
      </div>

    </div>
  </section>

  <!-- Experience -->
  <section id="experiencia" class="section bg-light-rounded">
    <h2>
      <svg class="section-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
      {en['section-experiencia'].title}
    </h2>
    <div class="projects">
      <div class="project-card card--exp">
        <a href="/experiencia#exp-1" class="full-link" aria-label="View experience at EDUCA EDTECH Group"></a>
        <h3>{en['section-experiencia']['first-job'].title}</h3>
        <p>{en['section-experiencia']['first-job'].period}</p>
        <div class="skills">
          <span class="skill high">Laravel</span>
          <span class="skill high">PHP</span>
          <span class="skill mid">Google Cloud</span>
          <span class="skill low">ElasticSearch</span>
        </div>
        <span class="tech">Laravel | JavaScript | SQL</span>
      </div>

      <div class="project-card card--exp">
        <a href="/experiencia#exp-2" class="full-link" aria-label="View experience at Euroinnova"></a>
        <h3>{en['section-experiencia']['second-job'].title}</h3>
        <p>{en['section-experiencia']['second-job'].period}</p>
        <div class="skills">
          <span class="skill high">Laravel</span>
          <span class="skill high">PHP</span>
          <span class="skill high">MySQL</span>
          <span class="skill mid">JavaScript</span>
        </div>
        <span class="tech">PHP | Laravel | MySQL</span>
      </div>
    </div>
  </section>

  <!-- Featured articles -->
  {featuredPosts.length > 0 && (
    <section id="articulos-destacados" class="section">
      <div class="featured-header">
        <h2>
          <svg class="section-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          {en.featured.title}
        </h2>
        <a href="/en/blog" class="featured-see-all">{en.featured['see-all']}</a>
      </div>
      <div class="featured-grid">
        {featuredPosts.map((p) => (
          <a href={`/en/blog/${p.slug}`} class="featured-card">
            <div class="featured-card-top">
              <span class={`blog-card-category ${p.category === 'Education' ? 'cat-formation' : 'cat-info'}`}>{p.category}</span>
              <span class="featured-card-date">{fmtDate(p.date)}</span>
            </div>
            <h3 class="featured-card-title">{p.title}</h3>
            <p class="featured-card-sub">{(p.subtitle||'').slice(0,95)}{(p.subtitle||'').length>95?'…':''}</p>
            <span class="featured-card-cta">{en.featured.read}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Contact -->
  <section id="contacto" class="section bg-dark">
    <h2><span aria-hidden="true">📩 </span>{en.contact.title}</h2>
    <div class="contacto-footer-cta">
      <p>{en.contact.content}</p>
      <a
        href="https://wa.me/34622400727?text=Hi%20Pablo%2C%20I%27ve%20seen%20your%20portfolio%20and%20I%27d%20like%20to%20talk%20with%20you."
        target="_blank"
        rel="noopener noreferrer"
        class="btn-whatsapp"
        aria-label="Contact via WhatsApp"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Direct WhatsApp
      </a>
      <ul class="contact">
        <li>💼 <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li>📞 <a href="tel:+34622400727">+34 622 400 727</a></li>
        <li>📧 <a href="mailto:pablogomezvillen@gmail.com">pablogomezvillen@gmail.com</a></li>
      </ul>
    </div>
  </section>

  <div class="contact-fixed">
    <div class="contact-fixed-header">
      <p class="contact-fixed-title" role="heading" aria-level="2"><span aria-hidden="true">📩 </span>{en.contact.title}</p>
      <button class="contact-close" aria-label="Close contact">✕</button>
    </div>
    <ul class="contact">
      <li>📞 <a href="tel:+34622400727">+34 622 400 727</a></li>
      <li>📧 <a href="mailto:pablogomezvillen@gmail.com">pablogomezvillen@gmail.com</a></li>
      <li>💼 <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
    </ul>
    <a href="/en/servicios#pricing" class="contact-fixed-cta btn--icon">
      Request a quote
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>
  <button class="contact-mini" aria-label="Open contact"><span aria-hidden="true">📩</span></button>

</Layout>
