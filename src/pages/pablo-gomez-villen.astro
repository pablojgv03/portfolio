---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Pablo Gómez Villén | Desarrollador Full Stack en Granada"
  showHero={false}
  description="Conoce a Pablo Gómez, desarrollador Full Stack de 23 años en Granada. Especializado en Laravel, PHP y JavaScript, con formación en IA y Big Data."
  canonical="https://pablogomezvillen.com/pablo-gomez-villen"
  alternateEs="https://pablogomezvillen.com/pablo-gomez-villen"
  alternateEn="https://pablogomezvillen.com/en/pablo-gomez-villen"
  keywords="sobre mí, Pablo Gómez, desarrollador Granada, Full Stack Laravel PHP, IA Big Data, DAW, programador España"
>

  <canvas id="sm-canvas"></canvas>

  <div class="sm-page">

    <!-- Hero -->
    <section class="sm-hero">
      <div class="sm-hero-inner">
        <picture>
          <source type="image/webp" srcset="/img/foto-empresa.webp">
          <img src="/img/foto-empresa.jpg" alt="Pablo Gómez, Full Stack Developer en Granada" class="sm-photo ani" style="--d:0s">
        </picture>
        <span class="sm-chip ani" style="--d:.05s" data-i18n="sobre-mi.chip">👨‍💻 Sobre mí</span>
        <h1 class="sm-name ani" style="--d:.1s">Pablo <span>Gómez Villén</span></h1>
        <p class="sm-role ani" style="--d:.2s" data-i18n="sobre-mi.role">Desarrollador Full Stack · Soluciones Informáticas · IA &amp; Big Data</p>
        <p class="sm-intro ani" style="--d:.3s" data-i18n="sobre-mi.intro">
          Pablo Gómez Villén, apasionado por construir soluciones digitales que marquen la diferencia.
          Más de un año de experiencia real en producción, siempre aprendiendo y buscando el siguiente reto.
        </p>
      </div>
      <a href="#stats" class="sm-scroll-hint">
        <span data-i18n="sobre-mi.scroll-cta">Conóceme</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </a>
    </section>

    <!-- Stats -->
    <div class="sm-stats" id="stats">
      <div class="sm-stat reveal">
        <div class="sm-stat-val"><span class="counter" data-target="1">1</span><span>+</span></div>
        <div class="sm-stat-lbl" data-i18n="sobre-mi.stats.years">años experiencia</div>
      </div>
      <div class="sm-stat reveal" style="--d:.1s">
        <div class="sm-stat-val"><span class="counter" data-target="2">2</span></div>
        <div class="sm-stat-lbl" data-i18n="sobre-mi.stats.companies">empresas</div>
      </div>
      <div class="sm-stat reveal" style="--d:.2s">
        <div class="sm-stat-val"><span class="counter" data-target="3">3</span></div>
        <div class="sm-stat-lbl" data-i18n="sobre-mi.stats.formations">formaciones</div>
      </div>
      <div class="sm-stat reveal" style="--d:.3s">
        <div class="sm-stat-val"><span class="counter" data-target="10">10</span><span>+</span></div>
        <div class="sm-stat-lbl" data-i18n="sobre-mi.stats.techs">tecnologías</div>
      </div>
    </div>

    <!-- Trayectoria -->
    <section class="sm-section">
      <h2 class="sm-title reveal" data-i18n="sobre-mi.timeline.title">Mi <span>Trayectoria</span></h2>
      <div class="sm-timeline">

        <div class="sm-tl-item reveal">
          <div class="sm-tl-dot own"></div>
          <div class="sm-tl-card own">
            <span class="sm-badge own" data-i18n="sobre-mi.timeline.own.badge">🚀 Marca Personal · Freelance · Remoto</span>
            <h3 data-i18n="sobre-mi.timeline.own.title">Pablo Gómez Villén — Desarrollador Full Stack &amp; Soluciones Digitales</h3>
            <p class="sm-tl-where" data-i18n="sobre-mi.timeline.own.where">2025 – presente</p>
            <p data-i18n="sobre-mi.timeline.own.desc1">Creación de soluciones informáticas a medida para negocios y particulares: desarrollo web, aplicaciones, automatización y herramientas digitales orientadas a resolver necesidades reales.</p>
            <p style="margin-top:.6rem" data-i18n="sobre-mi.timeline.own.desc2">Además del desarrollo técnico, trabajo en la construcción de una marca personal enfocada en visibilidad online, SEO y creación de productos digitales con impacto práctico.</p>
            <div class="sm-tags"><span>Astro</span><span>Laravel</span><span>JavaScript</span><span>SEO</span><span>PHP</span><span>Full Stack</span></div>
          </div>
        </div>

        <div class="sm-tl-item reveal">
          <div class="sm-tl-dot edu now"></div>
          <div class="sm-tl-card now">
            <span class="sm-badge now" data-i18n="sobre-mi.timeline.daw.badge">✨ En curso · 2025 – 2026</span>
            <h3 data-i18n="sobre-mi.timeline.daw.title">Desarrollo de Aplicaciones Web</h3>
            <p class="sm-tl-where" data-i18n="sobre-mi.timeline.daw.org">iLERNA · Online</p>
            <p data-i18n="sobre-mi.timeline.daw.desc">Profundizando en desarrollo web fullstack: PHP, JavaScript, MySQL y diseño web moderno.</p>
            <div class="sm-tags"><span>PHP</span><span>JavaScript</span><span>MySQL</span><span>HTML/CSS</span></div>
          </div>
        </div>

        <div class="sm-tl-item reveal">
          <div class="sm-tl-dot edu"></div>
          <div class="sm-tl-card">
            <span class="sm-badge edu" data-i18n="sobre-mi.timeline.ia.badge">📚 Formación · 2025</span>
            <h3 data-i18n="sobre-mi.timeline.ia.title">Especialización IA y Big Data</h3>
            <p class="sm-tl-where" data-i18n="sobre-mi.timeline.ia.org">Campus Net Manyanet Les Corts · Barcelona</p>
            <p data-i18n="sobre-mi.timeline.ia.desc">Python, Machine Learning y análisis de datos masivos. Proyecto: detección temprana de salud mental en RRSS.</p>
            <div class="sm-tags"><span>Python</span><span>Pandas</span><span>ML</span></div>
          </div>
        </div>

        <div class="sm-tl-item reveal">
          <div class="sm-tl-dot work"></div>
          <div class="sm-tl-card">
            <span class="sm-badge work" data-i18n="sobre-mi.timeline.educa.badge">💼 Experiencia · oct. 2023 – jun. 2024</span>
            <h3 data-i18n="sobre-mi.timeline.educa.title">Programador Full Stack</h3>
            <p class="sm-tl-where" data-i18n="sobre-mi.timeline.educa.org">EDUCA EDTECH Group · Granada · Híbrido</p>
            <p data-i18n="sobre-mi.timeline.educa.desc">Desarrollo y mantenimiento de plataformas educativas en producción: APIs REST, Google Cloud y ElasticSearch.</p>
            <div class="sm-tags"><span>Laravel</span><span>PHP</span><span>Google Cloud</span><span>ElasticSearch</span></div>
          </div>
        </div>

        <div class="sm-tl-item reveal">
          <div class="sm-tl-dot work"></div>
          <div class="sm-tl-card">
            <span class="sm-badge work" data-i18n="sobre-mi.timeline.euroinnova.badge">💼 Experiencia · abr. – oct. 2023</span>
            <h3 data-i18n="sobre-mi.timeline.euroinnova.title">Junior Software Developer</h3>
            <p class="sm-tl-where" data-i18n="sobre-mi.timeline.euroinnova.org">Euroinnova · Granada · Híbrido</p>
            <p data-i18n="sobre-mi.timeline.euroinnova.desc">Desarrollo de plataformas de formación online. Primera experiencia real en producción con Laravel y PHP.</p>
            <div class="sm-tags"><span>Laravel</span><span>PHP</span><span>MySQL</span><span>JavaScript</span></div>
          </div>
        </div>

        <div class="sm-tl-item reveal">
          <div class="sm-tl-dot edu"></div>
          <div class="sm-tl-card">
            <span class="sm-badge edu" data-i18n="sobre-mi.timeline.dam.badge">📚 Formación · 2021 – 2023</span>
            <h3 data-i18n="sobre-mi.timeline.dam.title">Desarrollo de Aplicaciones Multiplataforma</h3>
            <p class="sm-tl-where" data-i18n="sobre-mi.timeline.dam.org">IES Francisco Ayala · Granada</p>
            <p data-i18n="sobre-mi.timeline.dam.desc">Base sólida en programación orientada a objetos, bases de datos SQL y desarrollo móvil Android.</p>
            <div class="sm-tags"><span>Java</span><span>SQL</span><span>Android</span><span>Hibernate</span></div>
          </div>
        </div>

      </div>
    </section>

    <!-- Stack -->
    <section class="sm-section sm-stack-section">
      <h2 class="sm-title reveal" data-i18n="sobre-mi.stack.title">Stack <span>Tecnológico</span></h2>
      <div class="sm-pills">
        <span class="sm-pill sm-pill--high reveal" style="--d:0s">⚡ Laravel</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.05s">🐘 PHP</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.08s">🟨 JavaScript</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.11s">🗄️ MySQL</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.14s">🎨 HTML / CSS</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.17s">☕ Java</span>
        <span class="sm-pill sm-pill--mid reveal" style="--d:.20s">🐍 Python</span>
        <span class="sm-pill sm-pill--mid reveal" style="--d:.23s">☁️ Google Cloud</span>
        <span class="sm-pill sm-pill--mid reveal" style="--d:.26s">🔍 ElasticSearch</span>
        <span class="sm-pill sm-pill--low reveal" style="--d:.29s">🐙 Git</span>
        <span class="sm-pill sm-pill--low reveal" style="--d:.32s">🐳 Docker</span>
        <span class="sm-pill sm-pill--low reveal" style="--d:.35s">🚀 Astro</span>
      </div>
    </section>

    <!-- Hobbies -->
    <section class="sm-section">
      <h2 class="sm-title reveal" data-i18n="sobre-mi.hobbies.title">Fuera del <span>Código</span></h2>
      <p class="sm-subtitle reveal" data-i18n="sobre-mi.hobbies.subtitle">Porque hay vida más allá del teclado...</p>
      <div class="sm-hobbies">
        <div class="sm-hobby reveal" style="--d:0s">
          <div class="sm-hobby-ico">🎾</div>
          <h3 data-i18n="sobre-mi.hobbies.padel.title">Pádel</h3>
          <p data-i18n="sobre-mi.hobbies.padel.desc">En la pista es donde mejor pienso. Me aporta competitividad, estrategia y la descarga perfecta después de un día frente al ordenador.</p>
        </div>
        <div class="sm-hobby reveal" style="--d:.1s">
          <div class="sm-hobby-ico">🏋️</div>
          <h3 data-i18n="sobre-mi.hobbies.gym.title">Gimnasio</h3>
          <p data-i18n="sobre-mi.hobbies.gym.desc">La misma constancia que aplico al entrenamiento la aplico al código. Disciplina diaria para crecer física y mentalmente.</p>
        </div>
        <div class="sm-hobby reveal" style="--d:.2s">
          <div class="sm-hobby-ico">🥾</div>
          <h3 data-i18n="sobre-mi.hobbies.routes.title">Rutas &amp; Naturaleza</h3>
          <p data-i18n="sobre-mi.hobbies.routes.desc">Desconectar de las pantallas para reconectar con el entorno. Las mejores ideas me llegan caminando por la montaña.</p>
        </div>
        <div class="sm-hobby reveal" style="--d:.3s">
          <div class="sm-hobby-ico">🌿</div>
          <h3 data-i18n="sobre-mi.hobbies.bonsai.title">Bonsáis</h3>
          <p data-i18n="sobre-mi.hobbies.bonsai.desc">Cuidar un bonsái enseña que los mejores resultados requieren tiempo y paciencia. Igual que el buen software.</p>
        </div>
        <div class="sm-hobby reveal" style="--d:.4s">
          <div class="sm-hobby-ico">📸</div>
          <h3 data-i18n="sobre-mi.hobbies.photo.title">Fotografía</h3>
          <p data-i18n="sobre-mi.hobbies.photo.desc">Móvil o drone, capturo perspectivas únicas. El ojo compositivo también alimenta el diseño de interfaces.</p>
        </div>
        <div class="sm-hobby reveal" style="--d:.5s">
          <div class="sm-hobby-ico">✈️</div>
          <h3 data-i18n="sobre-mi.hobbies.travel.title">Viajar</h3>
          <p data-i18n="sobre-mi.hobbies.travel.desc">Cada destino amplía la visión del mundo. Nuevas culturas, ideas y formas de hacer las cosas.</p>
        </div>
      </div>
    </section>

  </div>

  <script>
    // ── PARTICLES ──
    const canvas = document.getElementById('sm-canvas');
    const ctx = canvas.getContext('2d');
    const mouse = { x: -9999, y: -9999 };
    const N = 70;
    let particles = [];

    function resize() {
      canvas.width  = window.innerWidth;
      canvas.height = window.innerHeight;
    }

    function initParticles() {
      particles = Array.from({ length: N }, () => ({
        x:  Math.random() * canvas.width,
        y:  Math.random() * canvas.height,
        vx: (Math.random() - .5) * .35,
        vy: (Math.random() - .5) * .35,
        r:  Math.random() * 1.8 + .8,
      }));
    }

    function drawFrame() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];

        const dx   = p.x - mouse.x;
        const dy   = p.y - mouse.y;
        const dist = Math.hypot(dx, dy);
        if (dist < 110 && dist > 0) {
          const f = (110 - dist) / 110;
          p.vx += (dx / dist) * f * .6;
          p.vy += (dy / dist) * f * .6;
        }

        p.vx *= .98;
        p.vy *= .98;
        const spd = Math.hypot(p.vx, p.vy);
        if (spd > 1.8) { p.vx = p.vx / spd * 1.8; p.vy = p.vy / spd * 1.8; }

        p.x += p.vx;
        p.y += p.vy;

        if (p.x < 0) p.x = canvas.width;
        if (p.x > canvas.width)  p.x = 0;
        if (p.y < 0) p.y = canvas.height;
        if (p.y > canvas.height) p.y = 0;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(42,82,152,.75)';
        ctx.fill();

        for (let j = i + 1; j < particles.length; j++) {
          const q = particles[j];
          const d = Math.hypot(p.x - q.x, p.y - q.y);
          if (d < 130) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(q.x, q.y);
            ctx.strokeStyle = `rgba(42,82,152,${(1 - d / 130) * .25})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
      }

      requestAnimationFrame(drawFrame);
    }

    window.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });
    window.addEventListener('resize',    () => { resize(); initParticles(); });

    // ── SMOOTH SCROLL "Conóceme" ──
    document.querySelector('.sm-scroll-hint').addEventListener('click', e => {
      e.preventDefault();
      const target = document.getElementById('stats');
      if (!target) return;
      const start    = window.scrollY;
      const end      = target.getBoundingClientRect().top + window.scrollY - 80;
      const duration = 1500;
      let startTime  = null;

      const easeInOutCubic = t =>
        t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

      const step = timestamp => {
        if (!startTime) startTime = timestamp;
        const elapsed  = timestamp - startTime;
        const progress = Math.min(elapsed / duration, 1);
        window.scrollTo(0, start + (end - start) * easeInOutCubic(progress));
        if (progress < 1) requestAnimationFrame(step);
      };

      requestAnimationFrame(step);
    });

    resize();
    initParticles();
    drawFrame();

    // ── REVEAL on scroll ──
    const revealObs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('revealed');
          revealObs.unobserve(e.target);
        }
      });
    }, { threshold: .12 });

    document.querySelectorAll('.reveal, .ani').forEach(el => revealObs.observe(el));

    // ── COUNTERS ──
    const counterObs = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el     = entry.target;
        const target = parseInt(el.dataset.target);
        let current  = 0;
        const step   = target / 28;
        const id     = setInterval(() => {
          current += step;
          if (current >= target) { current = target; clearInterval(id); }
          el.textContent = Math.floor(current);
        }, 45);
        counterObs.unobserve(el);
      });
    }, { threshold: .5 });

    document.querySelectorAll('.counter').forEach(el => counterObs.observe(el));
  </script>

</Layout>
