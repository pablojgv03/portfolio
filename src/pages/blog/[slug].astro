---
import Layout from '../../layouts/Layout.astro';
import esData from '../../data/i18n/es.json';
import enData from '../../data/i18n/en.json';

export function getStaticPaths() {
  return Object.entries(esData.blog)
    .filter(([, post]) => !post.hidden)
    .map(([slug]) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const postEs = esData.blog[slug];
const postEn = enData.blog?.[slug];

const catClass = postEs.category === 'Formación' ? 'cat-formation' : 'cat-info';
const tagsHtml = (postEs.tags || []).map(t => `<span>${t}</span>`).join('');

function formatDate(dateStr, lang = 'es') {
  if (!dateStr || !/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return dateStr || '';
  const [y, m] = dateStr.split('-');
  const months = lang === 'en'
    ? ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
    : ['ene.','feb.','mar.','abr.','may.','jun.','jul.','ago.','sep.','oct.','nov.','dic.'];
  return `${months[parseInt(m, 10) - 1]} ${y}`;
}

function truncate(str, max = 55) {
  return str.length > max ? str.slice(0, max - 1) + '…' : str;
}

// Related posts: tag-based scoring (substring match, case-insensitive)
const allSlugs = Object.keys(esData.blog).filter(s => s !== slug && !esData.blog[s].hidden);
const myTags   = (postEs.tags || []).map(t => t.toLowerCase());

function tagScore(s) {
  if (!myTags.length) return 0;
  const theirTags = (esData.blog[s].tags || []).map(t => t.toLowerCase());
  let score = 0;
  for (const mt of myTags) {
    if (theirTags.some(tt => mt === tt || mt.includes(tt) || tt.includes(mt))) score++;
  }
  return score;
}

const sortDesc = (a, b) => (esData.blog[b].date || '').localeCompare(esData.blog[a].date || '');
const scored   = allSlugs.map(s => ({ s, score: tagScore(s) }))
  .sort((a, b) => b.score - a.score || sortDesc(a.s, b.s));

const withTags = scored.filter(x => x.score > 0).slice(0, 3).map(x => x.s);
// Fill to 3 using same-category if not enough tag matches
const byCat = allSlugs
  .filter(s => !withTags.includes(s) && esData.blog[s].category === postEs.category)
  .sort(sortDesc);
const relatedSlugs = [...withTags, ...byCat].slice(0, 3);
const relatedEs = relatedSlugs.map(s => ({ slug: s, ...esData.blog[s] }));
const relatedEn = relatedSlugs.map(s => ({ slug: s, ...(enData.blog?.[s] || {}) }));

// JSON-LD: BlogPosting + BreadcrumbList
const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": postEs.title,
  "description": postEs.subtitle || '',
  "datePublished": postEs.date,
  "dateModified": postEs.date,
  "author": {
    "@type": "Person",
    "@id": "https://www.pablogomezvillen.com/pablo-gomez-villen",
    "name": "Pablo Gómez Villén",
    "url": "https://www.pablogomezvillen.com",
    "image": "https://www.pablogomezvillen.com/img/foto-empresa.jpg",
    "jobTitle": "Full Stack Developer",
    "sameAs": [
      "https://www.linkedin.com/in/pablo-gomez-villen",
      "https://www.pablogomezvillen.com"
    ]
  },
  "publisher": {
    "@type": "Person",
    "name": "Pablo Gómez Villén",
    "url": "https://www.pablogomezvillen.com",
    "image": "https://www.pablogomezvillen.com/img/foto-empresa.jpg"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://www.pablogomezvillen.com/blog/${slug}`
  },
  "url": `https://www.pablogomezvillen.com/blog/${slug}`,
  "image": postEs.image ? `https://www.pablogomezvillen.com${postEs.image}` : "https://www.pablogomezvillen.com/img/opengraph.png",
  "keywords": (postEs.tags || []).join(', '),
  "inLanguage": "es-ES",
  "isPartOf": {
    "@type": "Blog",
    "@id": "https://www.pablogomezvillen.com/blog",
    "name": "Blog — Pablo Gómez"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://www.pablogomezvillen.com" },
    { "@type": "ListItem", "position": 2, "name": "Blog",   "item": "https://www.pablogomezvillen.com/blog" },
    { "@type": "ListItem", "position": 3, "name": postEs.title, "item": `https://www.pablogomezvillen.com/blog/${slug}` }
  ]
};
---

<Layout
  title={`${postEs.title} — Pablo Gómez`}
  lang="es"
  showHero={false}
  description={postEs.subtitle || ''}
  canonical={`https://www.pablogomezvillen.com/blog/${slug}`}
  alternateEn={`https://www.pablogomezvillen.com/en/blog/${slug}`}
  alternateEs={`https://www.pablogomezvillen.com/blog/${slug}`}
  keywords={(postEs.tags || []).join(', ')}
  ogType="article"
  ogArticleDate={postEs.date}
  ogImage={postEs.image || '/img/opengraph.png'}
  jsonLd={[blogPosting, breadcrumbSchema]}
  lcp={postEs.image}
>

  <div id="view-post">

    <div class="blog-post-banner">
      <div class="blog-post-banner-inner">

        <!-- Breadcrumb dentro del banner (visible sobre fondo oscuro) -->
        <nav class="blog-breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/" id="bc-home">Inicio</a></li>
            <li><a href="/blog" id="bc-blog">Blog</a></li>
            <li aria-current="page" id="bc-current">{truncate(postEs.title)}</li>
          </ol>
        </nav>

        <div class="blog-post-header-meta">
          <span class={`blog-category-badge ${catClass}`} id="blog-category">{postEs.category}</span>
          <span class="blog-read-time" id="blog-read-time">{postEs.readTime ? `⏱ ${postEs.readTime}` : ''}</span>
        </div>
        <h1 class="blog-post-title" id="blog-post-title">{postEs.title}</h1>
        <p class="blog-post-subtitle" id="blog-post-subtitle">{postEs.subtitle}</p>
        <div class="blog-post-tags" id="blog-post-tags" set:html={tagsHtml}></div>
      </div>
    </div>

    <div class="reading-progress-bar" id="reading-progress" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>

    <article class="blog-article">
      <div class="blog-article-meta">
        <a href="/blog" class="blog-back-link" id="blog-back-link">← Blog</a>
        <time class="blog-date" id="blog-date" datetime={postEs.date}>{formatDate(postEs.date)}</time>
      </div>
      {postEs.image && (
        <figure class="blog-hero-image">
          <img
            src={postEs.image}
            alt={postEs.imageAlt || postEs.title}
            id="blog-hero-img"
            width="1200"
            height="630"
            fetchpriority="high"
            decoding="async"
          />
        </figure>
      )}
      <div class="blog-article-body" id="blog-content" set:html={postEs.content}></div>
      <div class="blog-article-footer">
        <a href="/blog" class="btn secondary" id="blog-back-btn">← Volver al blog</a>
      </div>
    </article>

    <!-- Author bio -->
    <div class="author-bio" id="author-bio">
      <picture>
        <source srcset="/img/foto-empresa.webp" type="image/webp">
        <img src="/img/foto-empresa.jpg" alt="Pablo Gómez Villén, Full Stack Developer" class="author-bio-avatar" width="80" height="80">
      </picture>
      <div class="author-bio-content">
        <p class="author-bio-label" id="author-bio-label">Escrito por</p>
        <p class="author-bio-name">Pablo Gómez Villén</p>
        <p class="author-bio-role">Full Stack Developer · Laravel, PHP, JavaScript</p>
        <p class="author-bio-text" id="author-bio-text">Desarrollador Full Stack con más de un año de experiencia en producción. Especializado en PHP (Laravel), JavaScript y MySQL. Comparte su aprendizaje y experiencias técnicas en este blog.</p>
        <div class="author-bio-links">
          <a href="https://www.linkedin.com/in/pablo-gomez-villen" class="author-bio-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="/pablo-gomez-villen" class="author-bio-link" id="author-bio-about">Sobre mí</a>
        </div>
      </div>
    </div>

    <!-- Artículos relacionados (server-rendered — Google lo rastrea) -->
    {relatedEs.length > 0 && (
      <aside class="blog-related">
        <h2 class="blog-related-title" id="related-title">Artículos relacionados</h2>
        <div class="blog-related-grid">
          {relatedEs.map((p, i) => (
            <a href={`/blog/${p.slug}`} class="blog-related-card" data-ri={i}>
              <span class={`blog-related-cat ${p.category === 'Formación' ? 'cat-formation' : 'cat-info'}`} data-rc={i}>{p.category}</span>
              <h3 class="blog-related-card-title" data-rt={i}>{p.title}</h3>
              <span class="blog-related-date" data-rd={i}>{formatDate(p.date)}</span>
            </a>
          ))}
        </div>
      </aside>
    )}

  </div>

</Layout>

<script define:vars={{ postEn, relatedEn }}>
  function getLang() {
    const c = document.cookie.split('; ').find(r => r.startsWith('lang='));
    return c ? c.split('=')[1] : (localStorage.getItem('lang') || 'es');
  }

  function fmtDate(dateStr, lang) {
    if (!dateStr || !/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return dateStr || '';
    const [y, m] = dateStr.split('-');
    const months = lang === 'en'
      ? ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']
      : ['ene.','feb.','mar.','abr.','may.','jun.','jul.','ago.','sep.','oct.','nov.','dic.'];
    return `${months[parseInt(m, 10) - 1]} ${y}`;
  }

  if (getLang() === 'en' && postEn) {
    const isFormationEn = postEn.category === 'Education';

    const catEl = document.getElementById('blog-category');
    catEl.textContent = postEn.category || '';
    catEl.className   = `blog-category-badge ${isFormationEn ? 'cat-formation' : 'cat-info'}`;

    document.getElementById('blog-post-title').textContent    = postEn.title;
    document.getElementById('blog-post-subtitle').textContent = postEn.subtitle || '';
    document.getElementById('blog-read-time').textContent     = postEn.readTime ? `⏱ ${postEn.readTime}` : '';
    document.getElementById('blog-date').textContent          = fmtDate(postEn.date || '', 'en');
    document.getElementById('blog-content').innerHTML         = postEn.content;
    document.getElementById('blog-back-btn').textContent      = '← Back to blog';
    document.getElementById('blog-back-link').textContent     = '← Blog';
    document.title = `${postEn.title} — Pablo Gómez`;

    const bcHome = document.getElementById('bc-home');
    if (bcHome) bcHome.textContent = 'Home';
    const bcCurrent = document.getElementById('bc-current');
    if (bcCurrent) {
      const t = postEn.title || '';
      bcCurrent.textContent = t.length > 55 ? t.slice(0, 54) + '…' : t;
    }

    const relatedTitle = document.getElementById('related-title');
    if (relatedTitle) relatedTitle.textContent = 'Related articles';

    (relatedEn || []).forEach((p, i) => {
      if (!p) return;
      const catEl   = document.querySelector(`[data-rc="${i}"]`);
      const titleEl = document.querySelector(`[data-rt="${i}"]`);
      const dateEl  = document.querySelector(`[data-rd="${i}"]`);
      if (catEl) {
        catEl.textContent = p.category || '';
        catEl.className   = `blog-related-cat ${p.category === 'Education' ? 'cat-formation' : 'cat-info'}`;
      }
      if (titleEl) titleEl.textContent = p.title || '';
      if (dateEl)  dateEl.textContent  = fmtDate(p.date || '', 'en');
    });

    if (postEn.tags) {
      document.getElementById('blog-post-tags').innerHTML = postEn.tags.map(t => `<span>${t}</span>`).join('');
    }

    // Author bio — translate to EN
    const bioLabel = document.getElementById('author-bio-label');
    const bioText  = document.getElementById('author-bio-text');
    const bioAbout = document.getElementById('author-bio-about');
    if (bioLabel) bioLabel.textContent = 'Written by';
    if (bioText)  bioText.textContent  = 'Full Stack Developer with over a year of production experience. Specialized in PHP (Laravel), JavaScript and MySQL. Shares learning and technical insights on this blog.';
    if (bioAbout) { bioAbout.textContent = 'About me'; bioAbout.href = '/en/pablo-gomez-villen'; }
  }

  // Reading progress bar
  const bar = document.getElementById('reading-progress');
  const article = document.querySelector('.blog-article');
  if (bar && article) {
    window.addEventListener('scroll', () => {
      const rect = article.getBoundingClientRect();
      const total = article.offsetHeight - window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      const pct = Math.min(100, total > 0 ? (scrolled / total) * 100 : 0);
      bar.style.width = pct + '%';
      bar.setAttribute('aria-valuenow', Math.round(pct));
    }, { passive: true });
  }
</script>

<style>
  .blog-hero-image {
    margin: 0 0 2rem;
    border-radius: 12px;
    overflow: hidden;
    line-height: 0;
  }

  .blog-hero-image img {
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: #2563eb;
    z-index: 9999;
    transition: width 0.1s linear;
  }
</style>
