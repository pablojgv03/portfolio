---
import '../styles/global.css';
import ContactScript from '../components/ContactScript.astro';

const { title, lcp, lang = 'es' } = Astro.props;

const isEN = lang === 'en';
const base = isEN ? '/recruiter' : '/reclutadores';
const cvFile = isEN ? 'CV_Pablo_Gomez_Villen_Software-Developer.pdf' : 'CV_Full-stack_Pablo_Gomez_Villen_Desarrollador.pdf';

const links = isEN
  ? { about: '/recruiter/about', exp: '/recruiter/experience', proj: '/recruiter/projects' }
  : { about: '/reclutadores/pablo-gomez-villen', exp: '/reclutadores/experiencia', proj: '/reclutadores/proyectos' };

const t = isEN
  ? { about: 'About me', exp: 'Experience', proj: 'Projects', cv: 'Download CV', badge: 'Recruiter Section', web: 'View full website', contact: 'Contact', close: 'Close contact', open: 'Open contact' }
  : { about: 'Sobre mí', exp: 'Experiencia', proj: 'Proyectos', cv: 'Descargar CV', badge: 'Sección Reclutadores', web: 'Ver web completa', contact: 'Contacto', close: 'Cerrar contacto', open: 'Abrir contacto' };

const path = Astro.url.pathname.replace(/\/$/, '');

// Mapeo de rutas ES ↔ EN para el toggle de idioma
const langAlternate = (() => {
  if (isEN) {
    if (path === '/recruiter' || path === '/recruiter/about') return '/reclutadores/pablo-gomez-villen';
    if (path === '/recruiter/experience') return '/reclutadores/experiencia';
    if (path.startsWith('/recruiter/projects/')) return '/reclutadores/proyectos/' + path.split('/recruiter/projects/')[1];
    if (path === '/recruiter/projects') return '/reclutadores/proyectos';
    if (path === '/recruiter/contact') return '/reclutadores/contacto';
    return '/reclutadores';
  } else {
    if (path === '/reclutadores' || path === '/reclutadores/pablo-gomez-villen') return '/recruiter/about';
    if (path === '/reclutadores/experiencia') return '/recruiter/experience';
    if (path.startsWith('/reclutadores/proyectos/')) return '/recruiter/projects/' + path.split('/reclutadores/proyectos/')[1];
    if (path === '/reclutadores/proyectos') return '/recruiter/projects';
    if (path === '/reclutadores/contacto') return '/recruiter/contact';
    return '/recruiter';
  }
})();

const navActive = (href: string) => {
  if (href === links.proj) {
    return path === href || path.startsWith(href + '/') ? 'nav-current nav-current--exact' : undefined;
  }
  return path === href ? 'nav-current nav-current--exact' : undefined;
};
const navCurrent = (href: string) => navActive(href) ? 'page' : undefined;
---

<html lang={lang}>
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-P2LZVQLK');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow">
    <meta name="lang-alternate" content={langAlternate}>
    <meta name="author" content="Pablo Gómez">
    {lcp && <link rel="preload" as="image" href={lcp}>}
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <style>
      .rec-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.68rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #5b21b6;
        background: #ede9fe;
        border: 1px solid #c4b5fd;
        border-radius: 999px;
        padding: 3px 10px;
        margin-left: 6px;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .rec-web-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 0.72rem;
        font-weight: 600;
        color: #4b5563;
        background: #f3f4f6;
        border: 1px solid #d1d5db;
        border-radius: 999px;
        padding: 3px 11px;
        margin-left: 6px;
        white-space: nowrap;
        flex-shrink: 0;
        text-decoration: none;
        transition: background 0.15s, color 0.15s;
      }
      .rec-web-btn:hover { background: #e5e7eb; color: #111827; }
      @media (max-width: 700px) { .rec-badge, .rec-web-btn { display: none; } }
    </style>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P2LZVQLK"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <a href="#main-content" class="skip-link">{isEN ? 'Skip to main content' : 'Saltar al contenido principal'}</a>

    <header class="navbar">
      <div class="navbar-container">
        <a href={isEN ? '/recruiter' : '/reclutadores'} class="logo" aria-label={isEN ? 'Recruiter section home' : 'Inicio sección reclutadores'}>
          <picture>
            <source srcset="/favicon.webp" type="image/webp">
            <img src="/favicon.png" alt="Pablo Gómez - Portfolio" width="32" height="32" />
          </picture>
        </a>
        <span class="rec-badge">{t.badge}</span>
        <a href={isEN ? '/en/' : '/'} class="rec-web-btn">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          {t.web}
        </a>

        <nav class="nav-links desktop">
          <a href={isEN ? '/recruiter' : '/reclutadores'}>{isEN ? 'Home' : 'Inicio'}</a>
          <a href={links.proj} class={navActive(links.proj)}>{isEN ? 'Projects' : 'Proyectos'}</a>
          <a href={links.exp} class={navActive(links.exp)}>{isEN ? 'Experience' : 'Experiencia'}</a>
          <a href={links.about} class={navActive(links.about)}>{isEN ? 'About me' : 'Sobre mí'}</a>
          <a href={isEN ? '/recruiter/contact' : '/reclutadores/contacto'} class={navActive(isEN ? '/recruiter/contact' : '/reclutadores/contacto')}>{isEN ? 'Contact' : 'Contacto'}</a>
        </nav>

        <div class="lang-toggle desktop-only" aria-label={isEN ? 'Change language' : 'Cambiar idioma'}>
          <input type="checkbox" id="lang-switch" />
          <label for="lang-switch" class="lang-label">
            <span class="flag flag-es"><img src="/img/flags/es.svg" alt={isEN ? 'Switch to Spanish' : 'Cambiar idioma a Español'} loading="lazy"></span>
            <span class="flag flag-en"><img src="/img/flags/gb.svg" alt={isEN ? 'Switch to English' : 'Switch language to English'} loading="lazy"></span>
            <span class="toggle-slider"></span>
          </label>
        </div>

        <button class="nav-toggle" aria-label={isEN ? 'Open menu' : 'Abrir menú'}>☰</button>
      </div>

      <nav class="nav-links mobile" id="mobileMenu">
        <div class="menu-header">
          <a href={isEN ? '/recruiter' : '/reclutadores'} class="logo" aria-label={isEN ? 'Recruiter section home' : 'Inicio sección reclutadores'}>
            <picture>
              <source srcset="/favicon.webp" type="image/webp">
              <img src="/favicon.png" alt="Pablo Gómez - Portfolio" width="32" height="32" />
            </picture>
          </a>
          <button class="close-menu" aria-label={isEN ? 'Close menu' : 'Cerrar menú'}>✕</button>
        </div>
        <a href={isEN ? '/recruiter' : '/reclutadores'}>{isEN ? 'Home' : 'Inicio'}</a>
        <a href={links.proj} class={navActive(links.proj)}>{isEN ? 'Projects' : 'Proyectos'}</a>
        <a href={links.exp} class={navActive(links.exp)}>{isEN ? 'Experience' : 'Experiencia'}</a>
        <a href={links.about} class={navActive(links.about)}>{isEN ? 'About me' : 'Sobre mí'}</a>
        <a href={isEN ? '/recruiter/contact' : '/reclutadores/contacto'} class={navActive(isEN ? '/recruiter/contact' : '/reclutadores/contacto')}>{isEN ? 'Contact' : 'Contacto'}</a>

        <div class="lang-toggle mobile-only" aria-label={isEN ? 'Change language' : 'Cambiar idioma'}>
          <input type="checkbox" id="lang-switch-mobile" />
          <label for="lang-switch-mobile" class="lang-label">
            <span class="flag flag-es"><img src="/img/flags/es.svg" alt={isEN ? 'Switch to Spanish' : 'Cambiar idioma a Español'}></span>
            <span class="flag flag-en"><img src="/img/flags/gb.svg" alt={isEN ? 'Switch to English' : 'Switch language to English'}></span>
            <span class="toggle-slider"></span>
          </label>
        </div>

        <div class="mobile-socials" aria-label="Redes sociales">
          <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="mobile-social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <p>© 2026 Pablo Gómez Villén || Programador Full Stack</p>
      <div class="footer-socials" aria-label="Redes sociales">
        <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="footer-social-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://www.instagram.com/pablogomez.dev?igsh=bXlwODg0b2Q1djBz" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="footer-social-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@pablogomez.dev?_r=1&_t=ZN-96joekIjghC" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="footer-social-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.53V6.77a4.85 4.85 0 01-1.01-.08z"/></svg>
        </a>
      </div>
    </footer>

    <button id="scroll-top-btn" aria-label={isEN ? 'Back to top' : 'Volver arriba'} title={isEN ? 'Back to top' : 'Volver arriba'}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <div class="contact-fixed" aria-hidden="true">
      <div class="contact-fixed-header">
        <p class="contact-fixed-title" role="heading" aria-level="2">
          <span aria-hidden="true">📩 </span>{t.contact}
        </p>
        <button class="contact-close" aria-label={t.close}>✕</button>
      </div>
      <ul class="contact">
        <li>📞 <a href="tel:+34622400727">+34 622 400 727</a></li>
        <li>📧 <a href="mailto:pablogomezvillen@gmail.com">pablogomezvillen@gmail.com</a></li>
        <li class="contact-socials-row">
          <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="contact-social-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </li>
      </ul>
      <a href="mailto:pablogomezvillen@gmail.com" class="contact-fixed-cta btn--icon">
        {isEN ? 'Send email' : 'Enviar correo'}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
    <button class="contact-mini" aria-label={t.open} aria-expanded="false">
      <span aria-hidden="true">📩</span>
    </button>

    <ContactScript />

    <script type="module">
      window.addEventListener('DOMContentLoaded', () => {
        const toggle = document.querySelector('.nav-toggle');
        const menu = document.getElementById('mobileMenu');
        const closeBtn = document.querySelector('.close-menu');

        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          menu.classList.toggle('show');
          document.body.style.overflow = menu.classList.contains('show') ? 'hidden' : '';
        });

        closeBtn.addEventListener('click', () => {
          menu.classList.remove('show');
          document.body.style.overflow = '';
        });

        document.addEventListener('click', (e) => {
          if (menu.classList.contains('show') && !menu.contains(e.target) && !toggle.contains(e.target)) {
            menu.classList.remove('show');
            document.body.style.overflow = '';
          }
        });

        // Toggle de idioma: navega a la URL equivalente en el otro idioma
        const altUrl = document.querySelector('meta[name="lang-alternate"]')?.getAttribute('content') || '/';
        const isEnPage = window.location.pathname.startsWith('/recruiter');
        document.querySelectorAll('#lang-switch, #lang-switch-mobile').forEach(sw => {
          /** @type {HTMLInputElement} */ (sw).checked = isEnPage;
          sw.addEventListener('change', () => { window.location.href = altUrl; });
        });

        const navbar = document.querySelector('.navbar');
        window.addEventListener('scroll', () => {
          navbar.classList.toggle('navbar--scrolled', window.scrollY > 20);
        }, { passive: true });

        const scrollBtn = document.getElementById('scroll-top-btn');
        if (scrollBtn) {
          let lastY = window.scrollY;
          window.addEventListener('scroll', () => {
            const currentY = window.scrollY;
            if (currentY > 300 && currentY < lastY) scrollBtn.classList.add('visible');
            else scrollBtn.classList.remove('visible');
            lastY = currentY;
          }, { passive: true });
          scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
        }
      });
    </script>
  </body>
</html>
