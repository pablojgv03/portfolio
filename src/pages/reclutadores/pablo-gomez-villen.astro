---
import LayoutReclutadores from '../../layouts/LayoutReclutadores.astro';
---

<LayoutReclutadores title="Pablo Gómez Villén | Full Stack Developer">

  <canvas id="sm-canvas"></canvas>

  <div class="sm-page">

    <section class="sm-hero">
      <div class="sm-hero-inner">
        <picture>
          <source type="image/webp" srcset="/img/foto-empresa.webp">
          <img src="/img/foto-empresa.jpg" alt="Pablo Gómez, Full Stack Developer en Granada" class="sm-photo ani" style="--d:0s">
        </picture>
        <span class="sm-chip ani" style="--d:.05s">👨‍💻 Sobre mí</span>
        <h1 class="sm-name ani" style="--d:.1s">Pablo <span>Gómez Villén</span></h1>
        <p class="sm-role ani" style="--d:.2s">Desarrollador Full Stack · Soluciones Informáticas · IA &amp; Big Data</p>
        <p class="sm-intro ani" style="--d:.3s">
          Pablo Gómez Villén, apasionado por construir soluciones digitales que marquen la diferencia.
          Más de un año de experiencia real en producción, siempre aprendiendo y buscando el siguiente reto.
        </p>
      </div>
      <a href="#stats" class="sm-scroll-hint">
        <span>Conóceme</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </a>
    </section>

    <div class="sm-stats" id="stats">
      <div class="sm-stat reveal">
        <div class="sm-stat-val"><span class="counter" data-target="1">1</span><span>+</span></div>
        <div class="sm-stat-lbl">años experiencia</div>
      </div>
      <div class="sm-stat reveal" style="--d:.1s">
        <div class="sm-stat-val"><span class="counter" data-target="2">2</span></div>
        <div class="sm-stat-lbl">empresas</div>
      </div>
      <div class="sm-stat reveal" style="--d:.2s">
        <div class="sm-stat-val"><span class="counter" data-target="3">3</span></div>
        <div class="sm-stat-lbl">formaciones</div>
      </div>
      <div class="sm-stat reveal" style="--d:.3s">
        <div class="sm-stat-val"><span class="counter" data-target="10">10</span><span>+</span></div>
        <div class="sm-stat-lbl">tecnologías</div>
      </div>
    </div>

    <div class="sm-quick-links reveal">
      <a href="/reclutadores/proyectos" class="sm-ql-card">
        <div class="sm-ql-icon">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
        </div>
        <div class="sm-ql-text">
          <strong>Mis proyectos</strong>
          <span>Trabajo real aplicado</span>
        </div>
        <svg class="sm-ql-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="/reclutadores/experiencia" class="sm-ql-card">
        <div class="sm-ql-icon sm-ql-icon--exp">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        </div>
        <div class="sm-ql-text">
          <strong>Experiencia laboral</strong>
          <span>+1 año en producción</span>
        </div>
        <svg class="sm-ql-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <section class="sm-section">
      <h2 class="sm-title reveal">Mi <span>Trayectoria</span></h2>
      <div class="sm-timeline">

        <div class="sm-tl-item reveal">
          <div class="sm-tl-dot own"></div>
          <div class="sm-tl-card own">
            <span class="sm-badge own">🚀 Marca Personal · Freelance · Remoto</span>
            <h3>Pablo Gómez Villén — Desarrollador Full Stack &amp; Soluciones Digitales</h3>
            <p class="sm-tl-where">2025 – presente</p>
            <p>Creación de soluciones informáticas a medida para negocios y particulares: desarrollo web, aplicaciones, automatización y herramientas digitales orientadas a resolver necesidades reales.</p>
            <p style="margin-top:.6rem">Además del desarrollo técnico, trabajo en la construcción de una marca personal enfocada en visibilidad online, SEO y creación de productos digitales con impacto práctico.</p>
            <div class="sm-tags"><span>Astro</span><span>Laravel</span><span>JavaScript</span><span>SEO</span><span>PHP</span><span>Full Stack</span></div>
          </div>
        </div>

        <div class="sm-tl-item reveal">
          <div class="sm-tl-dot edu now"></div>
          <div class="sm-tl-card now">
            <span class="sm-badge now">✨ En curso · 2025 – 2026</span>
            <h3>Desarrollo de Aplicaciones Web</h3>
            <p class="sm-tl-where">iLERNA · Online</p>
            <p>Profundizando en desarrollo web fullstack: PHP, JavaScript, MySQL y diseño web moderno.</p>
            <div class="sm-tags"><span>PHP</span><span>JavaScript</span><span>MySQL</span><span>HTML/CSS</span></div>
          </div>
        </div>

        <div class="sm-tl-item reveal">
          <div class="sm-tl-dot edu"></div>
          <div class="sm-tl-card">
            <span class="sm-badge edu">📚 Formación · 2025</span>
            <h3>Especialización IA y Big Data</h3>
            <p class="sm-tl-where">Campus Net Manyanet Les Corts · Barcelona</p>
            <p>Python, Machine Learning y análisis de datos masivos. Proyecto: detección temprana de salud mental en RRSS.</p>
            <div class="sm-tags"><span>Python</span><span>Pandas</span><span>ML</span></div>
          </div>
        </div>

        <div class="sm-tl-item reveal">
          <div class="sm-tl-dot work"></div>
          <div class="sm-tl-card">
            <span class="sm-badge work">💼 Experiencia · oct. 2023 – jun. 2024</span>
            <h3>Programador Full Stack</h3>
            <p class="sm-tl-where">EDUCA EDTECH Group · Granada · Híbrido</p>
            <p>Desarrollo y mantenimiento de plataformas educativas en producción: APIs REST, Google Cloud y ElasticSearch.</p>
            <div class="sm-tags"><span>Laravel</span><span>PHP</span><span>Google Cloud</span><span>ElasticSearch</span></div>
          </div>
        </div>

        <div class="sm-tl-item reveal">
          <div class="sm-tl-dot work"></div>
          <div class="sm-tl-card">
            <span class="sm-badge work">💼 Experiencia · abr. – oct. 2023</span>
            <h3>Junior Software Developer</h3>
            <p class="sm-tl-where">Euroinnova · Granada · Híbrido</p>
            <p>Desarrollo de plataformas de formación online. Primera experiencia real en producción con Laravel y PHP.</p>
            <div class="sm-tags"><span>Laravel</span><span>PHP</span><span>MySQL</span><span>JavaScript</span></div>
          </div>
        </div>

        <div class="sm-tl-item reveal">
          <div class="sm-tl-dot edu"></div>
          <div class="sm-tl-card">
            <span class="sm-badge edu">📚 Formación · 2021 – 2023</span>
            <h3>Desarrollo de Aplicaciones Multiplataforma</h3>
            <p class="sm-tl-where">IES Francisco Ayala · Granada</p>
            <p>Base sólida en programación orientada a objetos, bases de datos SQL y desarrollo móvil Android.</p>
            <div class="sm-tags"><span>Java</span><span>SQL</span><span>Android</span><span>Hibernate</span></div>
          </div>
        </div>

      </div>
    </section>

    <section class="sm-section sm-stack-section">
      <h2 class="sm-title reveal">Stack <span>Tecnológico</span></h2>
      <div class="sm-pills">
        <span class="sm-pill sm-pill--high reveal" style="--d:0s">⚡ Laravel</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.05s">🐘 PHP</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.08s">🟨 JavaScript</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.11s">🗄️ MySQL</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.14s">🎨 HTML / CSS</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.17s">☕ Java</span>
        <span class="sm-pill sm-pill--mid reveal" style="--d:.20s">🐍 Python</span>
        <span class="sm-pill sm-pill--mid reveal" style="--d:.23s">☁️ Google Cloud</span>
        <span class="sm-pill sm-pill--mid reveal" style="--d:.26s">🔍 ElasticSearch</span>
        <span class="sm-pill sm-pill--low reveal" style="--d:.29s">🐙 Git</span>
        <span class="sm-pill sm-pill--low reveal" style="--d:.32s">🐳 Docker</span>
        <span class="sm-pill sm-pill--low reveal" style="--d:.35s">🚀 Astro</span>
      </div>
    </section>

    <section class="sm-section">
      <h2 class="sm-title reveal">Fuera del <span>Código</span></h2>
      <p class="sm-subtitle reveal">Porque hay vida más allá del teclado...</p>
      <div class="sm-hobbies">
        <div class="sm-hobby reveal" style="--d:0s">
          <div class="sm-hobby-ico">🎾</div>
          <h3>Pádel</h3>
          <p>En la pista es donde mejor pienso. Me aporta competitividad, estrategia y la descarga perfecta después de un día frente al ordenador.</p>
        </div>
        <div class="sm-hobby reveal" style="--d:.1s">
          <div class="sm-hobby-ico">🏋️</div>
          <h3>Gimnasio</h3>
          <p>La misma constancia que aplico al entrenamiento la aplico al código. Disciplina diaria para crecer física y mentalmente.</p>
        </div>
        <div class="sm-hobby reveal" style="--d:.2s">
          <div class="sm-hobby-ico">🥾</div>
          <h3>Rutas &amp; Naturaleza</h3>
          <p>Desconectar de las pantallas para reconectar con el entorno. Las mejores ideas me llegan caminando por la montaña.</p>
        </div>
        <div class="sm-hobby reveal" style="--d:.3s">
          <div class="sm-hobby-ico">🌿</div>
          <h3>Bonsáis</h3>
          <p>Cuidar un bonsái enseña que los mejores resultados requieren tiempo y paciencia. Igual que el buen software.</p>
        </div>
        <div class="sm-hobby reveal" style="--d:.4s">
          <div class="sm-hobby-ico">📸</div>
          <h3>Fotografía</h3>
          <p>Móvil o drone, capturo perspectivas únicas. El ojo compositivo también alimenta el diseño de interfaces.</p>
        </div>
        <div class="sm-hobby reveal" style="--d:.5s">
          <div class="sm-hobby-ico">✈️</div>
          <h3>Viajar</h3>
          <p>Cada destino amplía la visión del mundo. Nuevas culturas, ideas y formas de hacer las cosas.</p>
        </div>
      </div>
    </section>

  </div>

  <script>
    const canvas = document.getElementById('sm-canvas');
    const ctx = canvas.getContext('2d');
    const mouse = { x: -9999, y: -9999 };
    const N = 70;
    let particles = [];

    function resize() {
      const oldW = canvas.width || window.innerWidth;
      const oldH = canvas.height || window.innerHeight;
      canvas.width  = window.innerWidth;
      canvas.height = window.innerHeight;
      if (particles.length) {
        const scaleX = canvas.width / oldW;
        const scaleY = canvas.height / oldH;
        for (const p of particles) { p.x *= scaleX; p.y *= scaleY; }
      }
    }

    function initParticles() {
      particles = Array.from({ length: N }, () => ({
        x:  Math.random() * canvas.width,
        y:  Math.random() * canvas.height,
        vx: (Math.random() - .5) * .35,
        vy: (Math.random() - .5) * .35,
        r:  Math.random() * 1.8 + .8,
      }));
    }

    function drawFrame() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        const dx = p.x - mouse.x, dy = p.y - mouse.y;
        const dist = Math.hypot(dx, dy);
        if (dist < 110 && dist > 0) {
          const f = (110 - dist) / 110;
          p.vx += (dx / dist) * f * .6;
          p.vy += (dy / dist) * f * .6;
        }
        p.vx *= .98; p.vy *= .98;
        const spd = Math.hypot(p.vx, p.vy);
        if (spd > 1.8) { p.vx = p.vx / spd * 1.8; p.vy = p.vy / spd * 1.8; }
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0) p.x = canvas.width;
        if (p.x > canvas.width)  p.x = 0;
        if (p.y < 0) p.y = canvas.height;
        if (p.y > canvas.height) p.y = 0;
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(42,82,152,.75)';
        ctx.fill();
        for (let j = i + 1; j < particles.length; j++) {
          const q = particles[j];
          const d = Math.hypot(p.x - q.x, p.y - q.y);
          if (d < 130) {
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(q.x, q.y);
            ctx.strokeStyle = `rgba(42,82,152,${(1 - d / 130) * .25})`;
            ctx.lineWidth = 1;
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(drawFrame);
    }

    if (!('ontouchstart' in window)) {
      window.addEventListener('mousemove', e => { mouse.x = e.clientX; mouse.y = e.clientY; });
    }

    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(resize, 120);
    });

    document.querySelector('.sm-scroll-hint').addEventListener('click', e => {
      e.preventDefault();
      const target = document.getElementById('stats');
      if (!target) return;
      const top = target.getBoundingClientRect().top + window.scrollY - 80;
      window.scrollTo({ top, behavior: 'smooth' });
    });

    resize();
    initParticles();
    drawFrame();

    const revealObs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('revealed'); revealObs.unobserve(e.target); }
      });
    }, { threshold: .12 });
    document.querySelectorAll('.reveal, .ani').forEach(el => revealObs.observe(el));

    const counterObs = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el = entry.target;
        const target = parseInt(el.dataset.target);
        let current = 0;
        const step = target / 28;
        const id = setInterval(() => {
          current += step;
          if (current >= target) { current = target; clearInterval(id); }
          el.textContent = Math.floor(current);
        }, 45);
        counterObs.unobserve(el);
      });
    }, { threshold: .5 });
    document.querySelectorAll('.counter').forEach(el => counterObs.observe(el));
  </script>

</LayoutReclutadores>
