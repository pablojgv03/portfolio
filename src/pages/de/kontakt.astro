---
import Layout from '../../layouts/Layout.astro';

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.pablogomezvillen.com",
  "name": "Pablo Gómez Villén — Webentwicklung",
  "description": "Professionelle Webentwicklung und lokales SEO für Unternehmen in Granada und Spanien",
  "url": "https://www.pablogomezvillen.com",
  "telephone": "+34622400727",
  "email": "pablogomezvillen@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Granada",
    "addressRegion": "Andalucía",
    "addressCountry": "ES"
  },
  "areaServed": ["Granada", "Andalucía", "España"],
  "serviceType": ["Webdesign", "Lokales SEO", "Full-Stack-Entwicklung"]
};
---

<Layout
  title="Kontakt | Pablo Gómez — Webentwickler in Granada"
  lang="de"
  description="Fordere ein Angebot für deine Website oder dein digitales Projekt an. Antwort innerhalb von 24 Stunden. Unverbindlich."
  canonical="https://www.pablogomezvillen.com/de/kontakt"
  alternateEs="https://www.pablogomezvillen.com/contacto"
  alternateEn="https://www.pablogomezvillen.com/en/contact"
  alternateDe="https://www.pablogomezvillen.com/de/kontakt"
  showHero={false}
  keywords="Kontakt Webentwickler Granada, Website-Angebot, Programmierer Granada beauftragen"
  jsonLd={[localBusinessSchema]}
>

  <div class="page-banner">
    <h1>
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Lass uns reden
    </h1>
    <p>Erzähl mir, was du brauchst — ich antworte innerhalb von 24 Stunden</p>
  </div>

  <div class="contact-booking-alt contact-booking-alt--top">
    <p class="contact-booking-alt-title">Lieber direkt sprechen?</p>
    <p class="contact-booking-alt-desc">Buche ein kostenloses 20-minütiges Gespräch, ganz unverbindlich.</p>
    <a href="/de/termin" class="contact-booking-alt-btn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      Kostenloses Treffen buchen
    </a>
  </div>

  <div class="contacto-page">

    <!-- Formular -->
    <div>
      <h2 style="font-size:1.3rem;font-weight:700;color:#1e3c72;margin-bottom:20px;">Schreib mir eine Nachricht</h2>

      <form
        class="contact-form"
        action="https://formspree.io/f/xbdboaye"
        method="POST"
      >
        <div class="contact-form-group">
          <label for="cf-nombre">Name *</label>
          <input type="text" id="cf-nombre" name="nombre" required placeholder="Dein Name" autocomplete="name" />
        </div>

        <div class="contact-form-group">
          <label for="cf-email">E-Mail *</label>
          <input type="email" id="cf-email" name="email" required placeholder="du@email.com" autocomplete="email" />
        </div>

        <div class="contact-form-group">
          <label for="cf-tel">Telefon (optional)</label>
          <input type="tel" id="cf-tel" name="telefono" placeholder="+49 151 00000000" autocomplete="tel" />
        </div>

        <div class="contact-form-group">
          <label for="cf-tipo">Projektart *</label>
          <select id="cf-tipo" name="tipo_proyecto" required>
            <option value="" disabled selected>Option wählen...</option>
            <option value="web-negocio">Website für mein Unternehmen</option>
            <option value="seo">SEO & lokale Suche</option>
            <option value="app">App oder individuelle Entwicklung</option>
            <option value="mantenimiento">Website-Wartung</option>
            <option value="otro">Sonstiges</option>
          </select>
        </div>

        <div class="contact-form-group">
          <label for="cf-plan">Interessanter Plan</label>
          <select id="cf-plan" name="plan_interes">
            <option value="" selected>Keine Präferenz / lass uns sprechen</option>
            <option value="basico">Basic-Plan — ab 350 €</option>
            <option value="negocio">Business-Plan — ab 650 €</option>
            <option value="premium">Premium-Plan — Preis auf Anfrage</option>
          </select>
        </div>

        <div class="contact-form-group">
          <label for="cf-mensaje">Nachricht *</label>
          <textarea id="cf-mensaje" name="mensaje" required placeholder="Erzähl mir, wie ich dir helfen kann..."></textarea>
        </div>

        <!-- Honeypot anti-spam -->
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">

        <div id="form-feedback" role="alert" aria-live="polite" style="display:none;padding:12px 16px;border-radius:8px;font-size:0.9rem;margin-bottom:12px"></div>

        <button type="submit" class="contact-form-btn" id="form-submit-btn">
          Nachricht senden →
        </button>
      </form>
    </div>

    <script>
      const params = new URLSearchParams(window.location.search);
      const plan = params.get('plan');
      if (plan) {
        const select = document.getElementById('cf-plan') as HTMLSelectElement | null;
        if (select) select.value = plan;
      }

      const form = document.querySelector('.contact-form') as HTMLFormElement | null;
      const feedback = document.getElementById('form-feedback') as HTMLElement | null;
      const btn = document.getElementById('form-submit-btn') as HTMLButtonElement | null;

      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!btn || !feedback) return;

        const originalText = btn.textContent ?? 'Nachricht senden →';
        btn.textContent = 'Wird gesendet...';
        btn.disabled = true;
        feedback.style.display = 'none';

        try {
          const res = await fetch(form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: { Accept: 'application/json' },
          });

          if (res.ok) {
            window.location.href = '/de/danke';
          } else {
            const data: { errors?: { message: string }[] } = await res.json().catch(() => ({}));
            const msg = data.errors?.map((err) => err.message).join('. ') || 'Etwas ist schiefgelaufen. Bitte versuche es erneut oder schreib mir auf WhatsApp.';
            showError(msg);
          }
        } catch {
          showError('Verbindungsfehler. Prüfe deine Internetverbindung und versuche es erneut.');
        }

        function showError(msg: string) {
          feedback!.textContent = msg;
          Object.assign(feedback!.style, { display: 'block', background: '#fee2e2', color: '#991b1b', border: '1px solid #fca5a5' });
          btn!.textContent = originalText;
          btn!.disabled = false;
        }
      });
    </script>

    <!-- Kontaktinfo -->
    <div class="contact-info-panel">
      <h3>Kontaktinformationen</h3>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">💬</span>
        <div>
          <span class="contact-info-label">WhatsApp</span>
          <a
            href="https://wa.me/34622400727?text=Hallo%20Pablo%2C%20ich%20interessiere%20mich%20f%C3%BCr%20ein%20Gespr%C3%A4ch%20%C3%BCber%20meine%20Website"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-info-val"
          >+34 622 400 727</a>
        </div>
      </div>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">📧</span>
        <div>
          <span class="contact-info-label">E-Mail</span>
          <a href="mailto:pablogomezvillen@gmail.com" class="contact-info-val">pablogomezvillen@gmail.com</a>
        </div>
      </div>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">💼</span>
        <div>
          <span class="contact-info-label">LinkedIn</span>
          <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer" class="contact-info-val">pablo-gomez-villen</a>
        </div>
      </div>

      <div class="contact-info-item">
        <span class="contact-info-ico" aria-hidden="true">📍</span>
        <div>
          <span class="contact-info-label">Standort</span>
          <span class="contact-info-val" style="cursor:default">Granada, Spanien<br><small style="font-weight:400;color:#696969">Remote-Arbeit mit Unternehmen in ganz Spanien</small></span>
        </div>
      </div>

      <div class="contact-respuesta">
        ⏱️ Übliche Antwortzeit: <strong>unter 24 Stunden</strong> an Werktagen
      </div>
    </div>

  </div>

  <style>
  .contact-booking-alt {
    background: #eef4ff;
    border: 1px solid #c7d9f5;
    border-radius: 12px;
    padding: 20px;
    text-align: center;
  }

  .contact-booking-alt--top {
    max-width: 700px;
    margin: 56px auto 32px;
    padding: 28px 32px;
  }

  .contact-booking-alt-title {
    font-weight: 700;
    color: #1e3c72;
    font-size: 0.95rem;
    margin-bottom: 6px;
  }

  .contact-booking-alt-desc {
    font-size: 0.85rem;
    color: #4b5563;
    margin-bottom: 14px;
    line-height: 1.4;
  }

  .contact-booking-alt-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1e3c72;
    color: #ffce00;
    font-weight: 700;
    font-size: 0.9rem;
    padding: 10px 22px;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.18s ease, transform 0.18s ease;
  }

  .contact-booking-alt-btn:hover {
    background: #2a5298;
    transform: translateY(-2px);
  }
  </style>

</Layout>
