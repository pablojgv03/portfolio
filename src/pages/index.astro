---
import Layout from '../layouts/Layout.astro';
import esData from '../data/i18n/es.json';
import projectsData from '../data/projects.json';

const lang = 'es';

function fmtDate(d) {
  if (!d || !/^\d{4}-\d{2}-\d{2}$/.test(d)) return d || '';
  const [y, m] = d.split('-');
  return `${ ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'][parseInt(m,10)-1] }. ${y}`;
}

const featuredEs = Object.entries(esData.blog)
  .filter(([, p]) => p.featured && !p.hidden)
  .sort(([, a], [, b]) => (b.date || '').localeCompare(a.date || ''))
  .slice(0, 3)
  .map(([slug, p]) => ({ slug, ...p }));

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.pablogomezvillen.com/pablo-gomez-villen",
  "name": "Pablo Gómez Villén",
  "jobTitle": "Full Stack Developer",
  "url": "https://www.pablogomezvillen.com",
  "email": "pablogomezvillen@gmail.com",
  "telephone": "+34622400727",
  "image": "https://www.pablogomezvillen.com/img/foto-empresa.jpg",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Granada",
    "addressRegion": "Andalucía",
    "addressCountry": "ES"
  },
  "knowsAbout": [
    "Desarrollo web", "SEO local", "PHP", "Laravel", "JavaScript",
    "MySQL", "Full Stack Development", "Google Business Profile",
    "Inteligencia Artificial", "Big Data", "APIs REST"
  ],
  "alumniOf": [
    {
      "@type": "EducationalOrganization",
      "name": "IES Francisco Ayala",
      "description": "Técnico Superior en Desarrollo de Aplicaciones Multiplataforma (DAM)"
    },
    {
      "@type": "EducationalOrganization",
      "name": "Campus Net Manyanet Les Corts",
      "description": "Especialización en Inteligencia Artificial y Big Data"
    },
    {
      "@type": "EducationalOrganization",
      "name": "iLERNA",
      "description": "Técnico Superior en Desarrollo de Aplicaciones Web (DAW, en curso)"
    }
  ],
  "hasOccupation": {
    "@type": "Occupation",
    "name": "Full Stack Developer",
    "occupationLocation": { "@type": "City", "name": "Granada" },
    "skills": "PHP, Laravel, JavaScript, MySQL, Astro, SEO local"
  },
  "sameAs": [
    "https://www.linkedin.com/in/pablo-gomez-villen",
    "https://www.pablogomezvillen.com/pablo-gomez-villen"
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Pablo Gómez - Portfolio",
  "url": "https://www.pablogomezvillen.com"
};
---

<Layout
  title="Pablo Gómez — Desarrollador Web y SEO Local en Granada | Full Stack PHP Laravel"
  lang={lang}
  description="Desarrollo páginas web profesionales para negocios en Granada y España. SEO local, Google Business y soluciones Full Stack con PHP, Laravel y JavaScript."
  canonical="https://www.pablogomezvillen.com/"
  alternateEn="https://www.pablogomezvillen.com/en/"
  alternateEs="https://www.pablogomezvillen.com/"
  keywords="desarrollador web Granada, Full Stack Developer, Laravel, PHP, JavaScript, MySQL, SEO local Granada, página web negocio Granada"
  jsonLd={[personSchema, websiteSchema]}
  lcp="/img/foto-empresa.webp"
>
  <!-- Sobre mí -->
  <section id="sobre-mi" class="section">
    <h2 data-i18n="section-sobre-mi.title">
      <svg class="section-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      Sobre mí
    </h2>
    <div class="about-grid">
      <div class="about-left">
        <picture>
          <source type="image/webp" srcset="/img/foto-empresa.webp">
          <img src="/img/foto-empresa.jpg" alt="Pablo Gómez, Full Stack Developer en Granada" class="avatar" width="140" height="140" fetchpriority="high">
        </picture>
        <div class="about-quick-stats">
          <div class="about-stat">
            <span class="about-stat-num">1+</span>
            <span class="about-stat-lbl">años exp.</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-num">2</span>
            <span class="about-stat-lbl">empresas</span>
          </div>
          <div class="about-stat">
            <span class="about-stat-num">📍</span>
            <span class="about-stat-lbl">Granada</span>
          </div>
        </div>
      </div>
      <div class="about-text">
        <p data-i18n="section-sobre-mi.content">Desarrollador Full Stack con más de un año de experiencia en producción, especializado en PHP (Laravel), JavaScript y MySQL. He trabajado en dos proyectos reales de principio a fin en empresas del sector edtech, desde el diseño de bases de datos hasta la integración de APIs REST y la mejora de rendimiento front-end. Formación complementaria en Especialización en IA y Big Data, y actualmente cursando DAW (jun. 2026). Busco incorporarme a un equipo donde seguir creciendo como desarrollador Full Stack.</p>
      </div>
    </div>
  </section>

  <!-- ¿En qué puedo ayudarte? -->
  <section class="dual-section">
    <div class="dual-section-inner">
      <h2>¿En qué puedo ayudarte?</h2>
      <p class="dual-section-sub">Trabajo con dos tipos de clientes muy diferentes — ¿cuál eres tú?</p>
      <div class="dual-grid">

        <div class="dual-card dual-card--negocio">
          <a href="/servicios" class="full-link" aria-label="Ver mis servicios"></a>
          <span class="dual-card-ico" aria-hidden="true">🏪</span>
          <h3>Tengo un negocio y necesito clientes</h3>
          <p>Te hago una web profesional que aparezca en Google cuando alguien busque tu negocio en tu ciudad. Sin tecnicismos, sin complicaciones.</p>
          <ul>
            <li>✅ Página web moderna y rápida</li>
            <li>✅ Optimización para Google local</li>
            <li>✅ Google Business Profile</li>
            <li>✅ Mantenimiento mensual</li>
          </ul>
          <a href="/servicios" class="btn-primary btn--icon" style="position:relative;z-index:11">Ver mis servicios <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>

        <div class="dual-card dual-card--tech">
          <a href="/proyectos" class="full-link" aria-label="Ver mis proyectos"></a>
          <span class="dual-card-ico" aria-hidden="true">💻</span>
          <h3>Soy empresa y busco un desarrollador Full Stack</h3>
          <p>+1 año de experiencia en producción con Laravel, PHP, JavaScript y MySQL. Proyectos reales, código limpio y capacidad para trabajar en equipo.</p>
          <ul>
            <li>✅ Full Stack PHP / Laravel</li>
            <li>✅ Proyectos en producción</li>
            <li>✅ APIs REST, MySQL, JS</li>
            <li>✅ Disponible inmediatamente</li>
          </ul>
          <div class="dual-card-btns">
            <a href="/proyectos" class="btn-primary btn--icon">Ver mis proyectos <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
            <a href="/experiencia" class="btn-outlined btn--icon">Ver mi experiencia <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Proyectos -->
  <section id="proyectos" class="section bg-light-rounded">
    <h2 data-i18n="section-proyectos.title">
      <svg class="section-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
      Proyectos
    </h2>
    <div class="projects">
      {projectsData.proyectos.map((p) => (
        <article class={`project-card${p.image ? ' project-card--with-thumb' : ''}`} data-project-id={String(p.id)}>
          <a href={`/proyectos/${p.slug}`} class="full-link" aria-label={`Ver detalle de ${p.title}`}></a>
          {p.image && (
            <div class="project-card-thumb">
              <img src={p.image} alt={p.imageAlt || p.title} loading="lazy" decoding="async" width="400" height="210" />
            </div>
          )}
          <div class={p.image ? 'project-card-body' : ''}>
            <div class="meta">
              <span class="center">{p.badge === 'mobile' ? 'Android' : p.badge}</span>
            </div>
            <h3>{p.title}</h3>
            <p class="project-desc">{p.description.es}</p>
            {p.skills && p.skills.length > 0 && (
              <div class="skills" aria-label={`Aptitudes de ${p.title}`}>
                {p.skills.slice(0, 6).map(skill => (
                  <span class={`skill ${skill.level ?? ''}`}>{skill.name}</span>
                ))}
              </div>
            )}
            <div class="links" style="position:relative;z-index:11">
              {p['link-text'] && p['link-text'] !== '#' && (
                <a href={p['link-text']} target="_blank" rel="noopener noreferrer">GitHub →</a>
              )}
              {p.link && p.link !== '#' && (
                <a href={p.link} target="_blank" rel="noopener noreferrer">Demo →</a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Estudios -->
  <section id="estudios" class="section">
    <h2 data-i18n="section-estudios.title">
      <svg class="section-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
      Estudios
    </h2>
    <div class="projects">

      <div class="project-card card--study">
        <a href="/blog/daw" class="full-link" aria-label="Ver estudios DAW"></a>
        <h3 data-i18n="section-estudios.daw">Desarrollo de Aplicaciones Web</h3>
        <div class="meta">
          <span class="center">iLERNA</span>
          <span class="period"><span class="start">2025</span>–<span class="end">2026</span></span>
        </div>
        <div class="skills" aria-label="Aptitudes obtenidas en iLERNA">
          <span class="skill high">PHP</span>
          <span class="skill high">JavaScript</span>
          <span class="skill mid">MySQL</span>
          <span class="skill mid">HTML</span>
          <span class="skill mid">CSS</span>
        </div>
        <span class="tech">DAW | En curso</span>
      </div>

      <div class="project-card card--study">
        <a href="/blog/ia-bigdata" class="full-link" aria-label="Ver especialización en IA y Big Data"></a>
        <h3 data-i18n="section-estudios.ia-bd">Especialización en IA y Big Data</h3>
        <div class="meta">
          <span class="center">Campus Net Manyanet Les Corts</span>
          <span class="period"><span class="start">2025</span>–<span class="end">2025</span></span>
        </div>
        <div class="skills" aria-label="Aptitudes obtenidas en Campus Net Manyanet">
          <span class="skill high">Python</span>
          <span class="skill mid">Pandas</span>
          <span class="skill mid">Modelado ML</span>
        </div>
        <span class="tech">IA | Big Data</span>
      </div>

      <div class="project-card card--study">
        <a href="/blog/dam" class="full-link" aria-label="Ver estudios DAM"></a>
        <h3 data-i18n="section-estudios.dam">Desarrollo de Aplicaciones Multiplataforma</h3>
        <div class="meta">
          <span class="center">IES Francisco Ayala</span>
          <span class="period"><span class="start">2021</span>–<span class="end">2023</span></span>
        </div>
        <div class="skills">
          <span class="skill low">Odoo</span>
          <span class="skill high">SQL</span>
          <span class="skill mid">Hibernate</span>
        </div>
        <span class="tech">Desarrollo móvil | JavaScript</span>
      </div>

    </div>
  </section>

  <!-- Experiencia -->
  <section id="experiencia" class="section bg-light-rounded">
    <h2 data-i18n="section-experiencia.title">
      <svg class="section-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
      Experiencia
    </h2>
    <div class="projects">
      <div class="project-card card--exp">
        <a href="/experiencia#exp-1" class="full-link" aria-label="Ver experiencia en EDUCA EDTECH Group"></a>
        <h3 data-i18n="section-experiencia.first-job.title">Programador Full Stack — EDUCA EDTECH Group</h3>
        <p data-i18n="section-experiencia.first-job.period">oct. 2023 – jun. 2024 · 9 meses · Híbrido</p>
        <div class="skills">
          <span class="skill high">Laravel</span>
          <span class="skill high">PHP</span>
          <span class="skill mid">Google Cloud</span>
          <span class="skill low">ElasticSearch</span>
        </div>
        <span class="tech">Laravel | JavaScript | SQL</span>
      </div>

      <div class="project-card card--exp">
        <a href="/experiencia#exp-2" class="full-link" aria-label="Ver experiencia en Euroinnova"></a>
        <h3 data-i18n="section-experiencia.second-job.title">Junior Software Developer — Euroinnova</h3>
        <p data-i18n="section-experiencia.second-job.period">abr. 2023 – oct. 2023 · 7 meses · Híbrido</p>
        <div class="skills">
          <span class="skill high">Laravel</span>
          <span class="skill high">PHP</span>
          <span class="skill high">MySQL</span>
          <span class="skill mid">JavaScript</span>
        </div>
        <span class="tech">PHP | Laravel | MySQL</span>
      </div>
    </div>
  </section>

  <!-- Artículos destacados -->
  {featuredEs.length > 0 && (
    <section id="articulos-destacados" class="section">
      <div class="featured-header">
        <h2 id="featured-title" data-i18n="featured.title">
          <svg class="section-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          Artículos destacados
        </h2>
        <a href="/blog" class="featured-see-all" id="featured-see-all" data-i18n="featured.see-all">Ver todos →</a>
      </div>
      <div class="featured-grid">
        {featuredEs.map((p, i) => (
          <a href={`/blog/${p.slug}`} class="featured-card" data-fi={i}>
            <div class="featured-card-top">
              <span class={`blog-card-category ${p.category === 'Formación' ? 'cat-formation' : 'cat-info'}`} data-fcat={i}>{p.category}</span>
              <span class="featured-card-date" data-fdate={i}>{fmtDate(p.date)}</span>
            </div>
            <h3 class="featured-card-title" data-ftitle={i}>{p.title}</h3>
            <p class="featured-card-sub" data-fsub={i}>{(p.subtitle||'').slice(0,95)}{(p.subtitle||'').length>95?'…':''}</p>
            <span class="featured-card-cta" data-fcta={i} data-i18n="featured.read">Leer artículo →</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Contacto -->
  <section id="contacto" class="section bg-dark">
    <h2 data-i18n="contact.title"><span aria-hidden="true">📩 </span>¿Hablamos?</h2>
    <div class="contacto-footer-cta">
      <p data-i18n="contact.content">
        Si tienes un negocio y quieres más clientes online,
        <strong>escríbeme y te respondo hoy</strong>.<br>
        También estoy disponible para proyectos de desarrollo Full Stack.
      </p>
      <a
        href="https://wa.me/34622400727?text=Hola%20Pablo%2C%20me%20interesa%20hablar%20sobre%20mi%20web"
        target="_blank"
        rel="noopener noreferrer"
        class="btn-whatsapp"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        WhatsApp directo
      </a>
      <ul class="contact">
        <li>💼 <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
        <li>📞 <a href="tel:+34622400727">+34 622 400 727</a></li>
        <li>📧 <a href="mailto:pablogomezvillen@gmail.com">pablogomezvillen@gmail.com</a></li>
      </ul>
    </div>
  </section>



</Layout>
