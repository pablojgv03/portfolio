---
import Layout from '../../../layouts/Layout.astro';
import en from '../../../data/i18n/en.json';
import es from '../../../data/i18n/es.json';

// Pass both datasets to the client script
const allPosts = { en: en.blog, es: es.blog };
---

<Layout
  title="Blog — Pablo Gómez | Technology and Development"
  lang="en"
  showHero={false}
  description="Pablo Gómez's blog on web development, AI and Big Data. Articles about Laravel, PHP, education, AI specialization and more."
  canonical="https://pablogomezvillen.com/en/blog"
  alternateEs="https://pablogomezvillen.com/blog"
  alternateEn="https://pablogomezvillen.com/en/blog"
  keywords="blog, web development, Laravel, PHP, AI, Big Data, programming, technology"
>

  <div id="view-index">

    <div class="blog-index-banner">
      <div class="blog-index-banner-inner">
        <span class="blog-index-eyebrow">Blog</span>
        <h1 class="blog-index-title">Articles</h1>
        <p class="blog-index-subtitle">Development, technology and education — thoughts from the trenches.</p>
      </div>
    </div>

    <div class="blog-index-content">

      <div class="blog-filters-bar">
        <div class="blog-search-wrap">
          <svg class="blog-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input type="search" id="blog-search" class="blog-search-input" placeholder="Search articles…">
        </div>
        <div class="blog-filters-row">
          <div class="blog-cat-filters" id="blog-cat-filters"></div>
          <div class="blog-sort-wrap" id="blog-sort-wrap"></div>
        </div>
      </div>

      <div class="blog-grid" id="blog-grid"></div>
      <p class="blog-no-results" id="blog-no-results" style="display:none"></p>

    </div>
  </div>

</Layout>

<script define:vars={{ allPosts }}>
  /* redirect old ?slug= URLs */
  const oldSlug = new URLSearchParams(window.location.search).get('slug');
  if (oldSlug) window.location.replace(`/en/blog/${oldSlug}`);

  const posts = allPosts['en'] || allPosts['es'];

  const T = {
    all: 'All', formation: 'Education', informative: 'Informative',
    readMore: 'Read more', noResults: 'No articles match your filters.',
    newest: 'Newest', oldest: 'Oldest',
  };

  const allList = Object.entries(posts || {})
    .filter(([, p]) => !p.hidden)
    .map(([s, p], i) => ({ slug: s, _idx: i, ...p }));

  buildFilters(allList);
  renderCards(allList);

  function buildFilters(allList) {
    const wrap     = document.getElementById('blog-cat-filters');
    const sortWrap = document.getElementById('blog-sort-wrap');
    if (!wrap) return;

    const cats = [
      { label: T.all, value: '' },
      { label: T.formation, value: 'Education' },
      { label: T.informative, value: 'Informative' },
    ];

    wrap.innerHTML = cats.map((c, i) =>
      `<button class="blog-cat-btn${i === 0 ? ' active' : ''}" data-cat="${c.value}">${c.label}</button>`
    ).join('');

    if (sortWrap) {
      sortWrap.innerHTML = `
        <button class="blog-sort-btn active" data-sort="newest">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
          ${T.newest}
        </button>
        <button class="blog-sort-btn" data-sort="oldest">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          ${T.oldest}
        </button>`;
    }

    let curCat = '', curSearch = '', curSort = 'newest';

    wrap.querySelectorAll('.blog-cat-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        wrap.querySelectorAll('.blog-cat-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        curCat = btn.dataset.cat;
        filter();
      });
    });

    if (sortWrap) {
      sortWrap.querySelectorAll('.blog-sort-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          sortWrap.querySelectorAll('.blog-sort-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          curSort = btn.dataset.sort;
          filter();
        });
      });
    }

    document.getElementById('blog-search').addEventListener('input', e => {
      curSearch = e.target.value;
      filter();
    });

    function toSortKey(dateStr) {
      if (!dateStr) return '0000-00-00';
      if (/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return dateStr;
      const m = dateStr.match(/\d{4}/);
      return m ? `${m[0]}-00-00` : '0000-00-00';
    }

    function filter() {
      let list = allList.slice();
      if (curCat) list = list.filter(p => p.category === curCat);
      if (curSearch.trim()) {
        const q = curSearch.toLowerCase();
        list = list.filter(p =>
          p.title.toLowerCase().includes(q) ||
          (p.subtitle || '').toLowerCase().includes(q) ||
          (p.tags || []).some(t => t.toLowerCase().includes(q))
        );
      }
      if (curSort === 'newest') {
        list.sort((a, b) => toSortKey(b.date).localeCompare(toSortKey(a.date)) || (a._idx - b._idx));
      } else {
        list.sort((a, b) => toSortKey(a.date).localeCompare(toSortKey(b.date)) || (a._idx - b._idx));
      }
      renderCards(list);
    }
  }

  function formatDisplayDate(dateStr) {
    if (!dateStr || !/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return dateStr || '';
    const [year, month] = dateStr.split('-');
    const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    return `${months[parseInt(month, 10) - 1]} ${year}`;
  }

  function renderCards(list) {
    const grid = document.getElementById('blog-grid');
    const noResult = document.getElementById('blog-no-results');
    if (!grid) return;

    if (!list.length) {
      noResult.textContent = T.noResults;
      noResult.style.display = 'block';
      grid.innerHTML = '';
      return;
    }
    noResult.style.display = 'none';

    grid.innerHTML = list.map(p => {
      const isFormation = p.category === 'Education';
      const catClass = isFormation ? 'cat-formation' : 'cat-info';
      const tags = (p.tags || []).slice(0, 3).map(t => `<span>${t}</span>`).join('');
      const dateDisplay = formatDisplayDate(p.date);
      return `
        <article class="blog-card" role="link" tabindex="0"
          onclick="location.href='/en/blog/${p.slug}'"
          onkeydown="if(event.key==='Enter')location.href='/en/blog/${p.slug}'">
          <div class="blog-card-top">
            <span class="blog-card-category ${catClass}">${p.category || ''}</span>
            <span class="blog-card-date">${dateDisplay}</span>
          </div>
          <h2 class="blog-card-title">${p.title}</h2>
          <p class="blog-card-subtitle">${p.subtitle || ''}</p>
          <div class="blog-card-tags">${tags}</div>
          <div class="blog-card-footer">
            <span class="blog-card-read-time">${p.readTime ? `⏱ ${p.readTime}` : ''}</span>
            <span class="blog-card-read-link">${T.readMore} →</span>
          </div>
        </article>`;
    }).join('');
  }
</script>
