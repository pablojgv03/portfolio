---
import LayoutReclutadores from '../../../layouts/LayoutReclutadores.astro';
import esData from '../../../data/i18n/es.json';

export function getStaticPaths() {
  return ['daw', 'ia-bigdata', 'dam'].map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = esData.blog[slug];
if (!post) return Astro.redirect('/reclutadores');

const catClass = post.category === 'Formación' ? 'cat-formation' : post.category === 'Para negocios' ? 'cat-business' : 'cat-info';
const tagsHtml = (post.tags || []).map(t => `<span>${t}</span>`).join('');

function formatDate(dateStr: string) {
  if (!dateStr || !/^\d{4}-\d{2}-\d{2}$/.test(dateStr)) return dateStr || '';
  const [y, m] = dateStr.split('-');
  return `${ ['ene.','feb.','mar.','abr.','may.','jun.','jul.','ago.','sep.','oct.','nov.','dic.'][parseInt(m,10)-1] } ${y}`;
}

function truncate(str: string, max = 55) {
  return str.length > max ? str.slice(0, max - 1) + '…' : str;
}

function buildToc(html: string) {
  if (!html) return { headings: [] as {id:string;text:string}[], html: '' };
  const headings: {id:string;text:string}[] = [];
  const used: Record<string,number> = {};
  const processed = html.replace(/<h2([^>]*)>([\s\S]*?)<\/h2>/g, (_, attrs, inner) => {
    const display = inner.replace(/<[^>]+>/g, '').trim();
    let base = display.toLowerCase()
      .normalize('NFD').replace(/[̀-ͯ]/g, '')
      .replace(/[¿?¡!]/g, '').replace(/[^a-z0-9\s]/g, '')
      .trim().replace(/\s+/g, '-').slice(0, 55);
    let id = base;
    if (used[id]) { used[id]++; id = `${base}-${used[id]}`; } else { used[id] = 1; }
    headings.push({ id, text: display });
    return `<h2${attrs} id="${id}">${inner}</h2>`;
  });
  return { headings, html: processed };
}

const { headings: toc, html: content } = buildToc(post.content);
const showToc = toc.length >= 3;
---

<LayoutReclutadores title={`${post.title} — Pablo Gómez`} lcp={post.image}>

  <div id="view-post">

    <div class="blog-post-banner">
      <div class="blog-post-banner-inner">
        <nav class="blog-breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/reclutadores">Inicio</a></li>
            <li aria-current="page">{truncate(post.title)}</li>
          </ol>
        </nav>
        <div class="blog-post-header-meta">
          <span class={`blog-category-badge ${catClass}`}>{post.category}</span>
          <span class="blog-read-time">{post.readTime ? `⏱ ${post.readTime}` : ''}</span>
        </div>
        <h1 class="blog-post-title">{post.title}</h1>
        <p class="blog-post-subtitle">{post.subtitle}</p>
        <div class="blog-post-tags" set:html={tagsHtml}></div>
      </div>
    </div>

    <div class="reading-progress-bar" id="reading-progress" role="progressbar" aria-label="Progreso de lectura" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>

    <div class="blog-post-layout">
      <article class="blog-article">
        <div class="blog-article-meta">
          <a href="/reclutadores" class="blog-back-link">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
            Volver
          </a>
          <time class="blog-date" datetime={post.date}>{formatDate(post.date)}</time>
        </div>
        {post.image && (
          <figure class="blog-hero-image">
            <img src={post.image} alt={post.imageAlt || post.title} width="1200" height="630" fetchpriority="high" decoding="async" />
          </figure>
        )}
        {post.quickAnswer && (
          <div class="blog-quick-answer" role="note">
            <span class="blog-quick-answer-label">Respuesta directa</span>
            <p>{post.quickAnswer}</p>
          </div>
        )}
        {showToc && (
          <nav class="blog-toc blog-toc--inline" aria-label="Tabla de contenidos">
            <p class="blog-toc-title">Contenido</p>
            <ol>
              {toc.map(({ id, text }) => <li><a href={`#${id}`}>{text}</a></li>)}
            </ol>
          </nav>
        )}
        <div class="blog-article-body" set:html={content}></div>
      </article>

      <aside class="blog-sidebar" aria-label="Información del artículo">
        {post.excerpt && (
          <div class="sidebar-excerpt">
            <span class="sidebar-excerpt-label">Sobre este artículo</span>
            <p>{post.excerpt}</p>
          </div>
        )}
        {showToc && (
          <nav class="blog-toc" aria-label="Tabla de contenidos">
            <p class="blog-toc-title">Contenido</p>
            <ol>
              {toc.map(({ id, text }) => <li><a href={`#${id}`}>{text}</a></li>)}
            </ol>
          </nav>
        )}
      </aside>
    </div>

    <div class="blog-article-footer">
      <a href="/reclutadores" class="btn secondary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Volver
      </a>
    </div>

    <div class="author-bio">
      <picture>
        <source srcset="/img/foto-empresa.webp" type="image/webp">
        <img src="/img/foto-empresa.jpg" alt="Pablo Gómez Villén, Full Stack Developer" class="author-bio-avatar" width="80" height="80">
      </picture>
      <div class="author-bio-content">
        <p class="author-bio-label">Escrito por</p>
        <p class="author-bio-name">Pablo Gómez Villén</p>
        <p class="author-bio-role">Full Stack Developer · Laravel, PHP, JavaScript</p>
        <p class="author-bio-text">Desarrollador Full Stack con más de un año de experiencia en producción. Especializado en PHP (Laravel), JavaScript y MySQL.</p>
        <div class="author-bio-links">
          <a href="https://www.linkedin.com/in/pablo-gomez-villen" class="author-bio-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href="/reclutadores/pablo-gomez-villen" class="author-bio-link">Sobre mí</a>
        </div>
      </div>
    </div>

  </div>

</LayoutReclutadores>

<script>
  const bar = document.getElementById('reading-progress');
  const article = document.querySelector('.blog-article');
  if (bar && article) {
    window.addEventListener('scroll', () => {
      const rect = article.getBoundingClientRect();
      const total = article.offsetHeight - window.innerHeight;
      const scrolled = Math.max(0, -rect.top);
      const pct = Math.min(100, total > 0 ? (scrolled / total) * 100 : 0);
      bar.style.width = pct + '%';
      bar.setAttribute('aria-valuenow', String(Math.round(pct)));
    }, { passive: true });
  }

  const headings = Array.from(document.querySelectorAll('#view-post h2[id]'));
  const tocLinks = Array.from(document.querySelectorAll('.blog-toc a[href^="#"]'));
  if (headings.length && tocLinks.length) {
    function updateActiveToc() {
      const threshold = window.scrollY + window.innerHeight * 0.28;
      let activeIdx = 0;
      for (let i = 0; i < headings.length; i++) {
        if ((headings[i] as HTMLElement).offsetTop <= threshold) activeIdx = i; else break;
      }
      tocLinks.forEach(a => {
        const idx = headings.findIndex(h => '#' + h.id === a.getAttribute('href'));
        a.classList.toggle('toc-active', idx === activeIdx);
      });
    }
    window.addEventListener('scroll', updateActiveToc, { passive: true });
    updateActiveToc();
  }
</script>

<style>
  .blog-hero-image { margin: 0 0 2rem; border-radius: 12px; overflow: hidden; line-height: 0; }
  .blog-hero-image img { width: 100%; height: auto; aspect-ratio: 1200/630; object-fit: cover; object-position: top; display: block; }
  .blog-post-layout { display: grid; grid-template-columns: 1fr 310px; gap: 2rem; max-width: 1160px; margin: 0 auto; padding: 0 1.5rem; align-items: start; }
  :global(.blog-post-layout .blog-article) { max-width: none; margin: 0; padding: 0; }
  .blog-sidebar { position: sticky; top: 5.5rem; }
  .sidebar-excerpt { border: 1px solid #e2e8f0; border-radius: 10px; padding: 1rem 1.1rem; margin-bottom: 1.1rem; background: #f8fafc; }
  .sidebar-excerpt-label { display: block; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #2563eb; margin-bottom: 0.5rem; }
  .sidebar-excerpt p { margin: 0; font-size: 0.875rem; line-height: 1.65; color: #334155; }
  .blog-toc--inline { display: none; }
  .blog-toc { border: 1px solid #e2e8f0; border-radius: 10px; padding: 1rem 1.25rem 1rem 1rem; margin: 0 0 2rem; background: #f8fafc; }
  .blog-toc-title { font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #2563eb; margin: 0 0 0.6rem; }
  .blog-toc ol { margin: 0; padding-left: 1.4rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .blog-toc li { font-size: 0.9rem; line-height: 1.4; }
  .blog-toc a { color: #334155; text-decoration: none; transition: color 0.15s; }
  .blog-toc a:hover, .blog-toc a.toc-active { color: #2563eb; font-weight: 600; text-decoration: underline; }
  .blog-quick-answer { border-left: 4px solid #2563eb; background: #eff6ff; border-radius: 0 10px 10px 0; padding: 1rem 1.25rem; margin: 0 0 2rem; }
  .blog-quick-answer-label { display: block; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #2563eb; margin-bottom: 0.4rem; }
  .blog-quick-answer p { margin: 0; font-size: 0.97rem; line-height: 1.65; color: #1e3a5f; }
  .reading-progress-bar { position: fixed; top: 0; left: 0; height: 3px; width: 0%; background: #2563eb; z-index: 9999; transition: width 0.1s linear; }
  @media (max-width: 1024px) {
    .blog-post-layout { grid-template-columns: 1fr; padding: 0; }
    .blog-sidebar { display: none; }
    .blog-toc--inline { display: block; }
    :global(.blog-post-layout .blog-article) { max-width: 760px; width: 100%; margin: 0 auto; padding: 0 28px; }
  }
  @media (max-width: 480px) { :global(.blog-post-layout .blog-article) { padding: 0 16px; } }
</style>
