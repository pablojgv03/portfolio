---
import LayoutReclutadores from '../../../layouts/LayoutReclutadores.astro';
---

<LayoutReclutadores title="Pablo Gómez Villén | Full-Stack-Entwickler" lang="de">

  <canvas id="sm-canvas"></canvas>

  <div class="sm-page">

    <section class="sm-hero">
      <div class="sm-hero-inner">
        <picture>
          <source type="image/webp" srcset="/img/foto-empresa.webp">
          <img src="/img/foto-empresa.jpg" alt="Pablo Gómez, Full-Stack-Entwickler in Granada" class="sm-photo ani" style="--d:0s">
        </picture>
        <span class="sm-chip ani" style="--d:.05s">👨‍💻 Über mich</span>
        <h1 class="sm-name ani" style="--d:.1s">Pablo <span>Gómez Villén</span></h1>
        <p class="sm-role ani" style="--d:.2s">Full-Stack-Entwickler · IT-Lösungen · KI &amp; Big Data</p>
        <p class="sm-intro ani" style="--d:.3s">
          Mit Leidenschaft für digitale Lösungen, die einen echten Unterschied machen.
          Über ein Jahr reale Produktionserfahrung, immer lernbereit und auf der Suche nach der nächsten Herausforderung.
        </p>
      </div>
      <a href="#stats" class="sm-scroll-hint">
        <span>Mehr erfahren</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
      </a>
    </section>

    <div class="sm-stats" id="stats">
      <div class="sm-stat reveal"><div class="sm-stat-val"><span class="counter" data-target="1">1</span><span>+</span></div><div class="sm-stat-lbl">Jahre Erfahrung</div></div>
      <div class="sm-stat reveal" style="--d:.1s"><div class="sm-stat-val"><span class="counter" data-target="2">2</span></div><div class="sm-stat-lbl">Unternehmen</div></div>
      <div class="sm-stat reveal" style="--d:.2s"><div class="sm-stat-val"><span class="counter" data-target="3">3</span></div><div class="sm-stat-lbl">Qualifikationen</div></div>
      <div class="sm-stat reveal" style="--d:.3s"><div class="sm-stat-val"><span class="counter" data-target="10">10</span><span>+</span></div><div class="sm-stat-lbl">Technologien</div></div>
    </div>

    <div class="sm-quick-links reveal">
      <a href="/de/recruiter/projekte" class="sm-ql-card">
        <div class="sm-ql-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg></div>
        <div class="sm-ql-text"><strong>Meine Projekte</strong><span>Reale angewandte Arbeit</span></div>
        <svg class="sm-ql-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="/de/recruiter/erfahrung" class="sm-ql-card">
        <div class="sm-ql-icon sm-ql-icon--exp"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></div>
        <div class="sm-ql-text"><strong>Berufserfahrung</strong><span>+1 Jahr in Produktion</span></div>
        <svg class="sm-ql-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>

    <section class="sm-section">
      <h2 class="sm-title reveal">Mein <span>Werdegang</span></h2>
      <div class="sm-timeline">
        <div class="sm-tl-item reveal"><div class="sm-tl-dot own"></div><div class="sm-tl-card own"><span class="sm-badge own">🚀 Eigene Marke · Freelance · Remote</span><h3>Pablo Gómez Villén — Full-Stack-Entwickler &amp; digitale Lösungen</h3><p class="sm-tl-where">2025 – heute</p><p>Entwicklung maßgeschneiderter IT-Lösungen für Unternehmen und Privatpersonen: Webentwicklung, Anwendungen, Automatisierung und digitale Tools für reale Bedürfnisse.</p><div class="sm-tags"><span>Astro</span><span>Laravel</span><span>JavaScript</span><span>SEO</span><span>PHP</span><span>Full Stack</span></div></div></div>
        <div class="sm-tl-item reveal"><div class="sm-tl-dot edu now"></div><div class="sm-tl-card now"><span class="sm-badge now">✨ Laufend · 2025 – 2026</span><h3>Entwicklung von Webanwendungen</h3><p class="sm-tl-where">iLERNA · Online</p><p>Vertiefung in Full-Stack-Webentwicklung: PHP, JavaScript, MySQL und modernes Webdesign.</p><div class="sm-tags"><span>PHP</span><span>JavaScript</span><span>MySQL</span><span>HTML/CSS</span></div></div></div>
        <div class="sm-tl-item reveal"><div class="sm-tl-dot edu"></div><div class="sm-tl-card"><span class="sm-badge edu">📚 Ausbildung · 2025</span><h3>Spezialisierung KI &amp; Big Data</h3><p class="sm-tl-where">Campus Net Manyanet Les Corts · Barcelona</p><p>Python, Machine Learning und Massendatenanalyse. Projekt: Früherkennung mentaler Gesundheit in sozialen Netzwerken.</p><div class="sm-tags"><span>Python</span><span>Pandas</span><span>ML</span></div></div></div>
        <div class="sm-tl-item reveal"><div class="sm-tl-dot work"></div><div class="sm-tl-card"><span class="sm-badge work">💼 Erfahrung · Okt. 2023 – Jun. 2024</span><h3>Full-Stack-Entwickler</h3><p class="sm-tl-where">EDUCA EDTECH Group · Granada · Hybrid</p><p>Entwicklung und Wartung von Bildungsplattformen in Produktion: REST-APIs, Google Cloud und ElasticSearch.</p><div class="sm-tags"><span>Laravel</span><span>PHP</span><span>Google Cloud</span><span>ElasticSearch</span></div></div></div>
        <div class="sm-tl-item reveal"><div class="sm-tl-dot work"></div><div class="sm-tl-card"><span class="sm-badge work">💼 Erfahrung · Apr. – Okt. 2023</span><h3>Junior Software Developer</h3><p class="sm-tl-where">Euroinnova · Granada · Hybrid</p><p>Entwicklung von Online-Weiterbildungsplattformen. Erste reale Produktionserfahrung mit Laravel und PHP.</p><div class="sm-tags"><span>Laravel</span><span>PHP</span><span>MySQL</span><span>JavaScript</span></div></div></div>
        <div class="sm-tl-item reveal"><div class="sm-tl-dot edu"></div><div class="sm-tl-card"><span class="sm-badge edu">📚 Ausbildung · 2021 – 2023</span><h3>Entwicklung plattformübergreifender Anwendungen</h3><p class="sm-tl-where">IES Francisco Ayala · Granada</p><p>Solide Grundlagen in objektorientierter Programmierung, SQL-Datenbanken und mobiler Android-Entwicklung.</p><div class="sm-tags"><span>Java</span><span>SQL</span><span>Android</span><span>Hibernate</span></div></div></div>
      </div>
    </section>

    <section class="sm-section sm-stack-section">
      <h2 class="sm-title reveal">Technologie-<span>Stack</span></h2>
      <div class="sm-pills">
        <span class="sm-pill sm-pill--high reveal" style="--d:0s">⚡ Laravel</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.05s">🐘 PHP</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.08s">🟨 JavaScript</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.11s">🗄️ MySQL</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.14s">🎨 HTML / CSS</span>
        <span class="sm-pill sm-pill--high reveal" style="--d:.17s">☕ Java</span>
        <span class="sm-pill sm-pill--mid reveal" style="--d:.20s">🐍 Python</span>
        <span class="sm-pill sm-pill--mid reveal" style="--d:.23s">☁️ Google Cloud</span>
        <span class="sm-pill sm-pill--mid reveal" style="--d:.26s">🔍 ElasticSearch</span>
        <span class="sm-pill sm-pill--low reveal" style="--d:.29s">🐙 Git</span>
        <span class="sm-pill sm-pill--low reveal" style="--d:.32s">🐳 Docker</span>
        <span class="sm-pill sm-pill--low reveal" style="--d:.35s">🚀 Astro</span>
      </div>
    </section>

    <section class="sm-section">
      <h2 class="sm-title reveal">Außerhalb des <span>Codes</span></h2>
      <p class="sm-subtitle reveal">Denn es gibt Leben jenseits der Tastatur...</p>
      <div class="sm-hobbies">
        <div class="sm-hobby reveal" style="--d:0s"><div class="sm-hobby-ico">🎾</div><h3>Padel</h3><p>Auf der Platz denke ich am klarsten. Es bringt mir Wettbewerbsgeist, Strategie und den perfekten Ausgleich nach einem Tag am Rechner.</p></div>
        <div class="sm-hobby reveal" style="--d:.1s"><div class="sm-hobby-ico">🏋️</div><h3>Fitnessstudio</h3><p>Die gleiche Beständigkeit, die ich im Training anwende, wende ich auch im Code an. Tägliche Disziplin, um körperlich und mental zu wachsen.</p></div>
        <div class="sm-hobby reveal" style="--d:.2s"><div class="sm-hobby-ico">🥾</div><h3>Wandern &amp; Natur</h3><p>Abschalten von Bildschirmen, um sich mit der Umgebung zu verbinden. Die besten Ideen kommen mir beim Wandern in den Bergen.</p></div>
        <div class="sm-hobby reveal" style="--d:.3s"><div class="sm-hobby-ico">🌿</div><h3>Bonsai</h3><p>Die Pflege eines Bonsai lehrt, dass die besten Ergebnisse Zeit und Geduld brauchen. Genau wie gute Software.</p></div>
        <div class="sm-hobby reveal" style="--d:.4s"><div class="sm-hobby-ico">📸</div><h3>Fotografie</h3><p>Ob mit dem Handy oder der Drohne, ich halte einzigartige Perspektiven fest. Der Blick für Komposition prägt auch mein Interface-Design.</p></div>
        <div class="sm-hobby reveal" style="--d:.5s"><div class="sm-hobby-ico">✈️</div><h3>Reisen</h3><p>Jedes Reiseziel erweitert den Blick auf die Welt. Neue Kulturen, Ideen und Herangehensweisen.</p></div>
      </div>
    </section>

  </div>

  <script>
    const canvas = document.getElementById('sm-canvas');
    const ctx = canvas.getContext('2d');
    const mouse = { x: -9999, y: -9999 };
    const N = 70;
    let particles = [];
    function resize() { const oldW = canvas.width||window.innerWidth, oldH = canvas.height||window.innerHeight; canvas.width=window.innerWidth; canvas.height=window.innerHeight; if(particles.length){const sX=canvas.width/oldW,sY=canvas.height/oldH; for(const p of particles){p.x*=sX;p.y*=sY;}} }
    function initParticles() { particles=Array.from({length:N},()=>({x:Math.random()*canvas.width,y:Math.random()*canvas.height,vx:(Math.random()-.5)*.35,vy:(Math.random()-.5)*.35,r:Math.random()*1.8+.8})); }
    function drawFrame() { ctx.clearRect(0,0,canvas.width,canvas.height); for(let i=0;i<particles.length;i++){const p=particles[i];const dx=p.x-mouse.x,dy=p.y-mouse.y;const dist=Math.hypot(dx,dy);if(dist<110&&dist>0){const f=(110-dist)/110;p.vx+=(dx/dist)*f*.6;p.vy+=(dy/dist)*f*.6;} p.vx*=.98;p.vy*=.98;const spd=Math.hypot(p.vx,p.vy);if(spd>1.8){p.vx=p.vx/spd*1.8;p.vy=p.vy/spd*1.8;} p.x+=p.vx;p.y+=p.vy;if(p.x<0)p.x=canvas.width;if(p.x>canvas.width)p.x=0;if(p.y<0)p.y=canvas.height;if(p.y>canvas.height)p.y=0;ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fillStyle='rgba(42,82,152,.75)';ctx.fill();for(let j=i+1;j<particles.length;j++){const q=particles[j];const d=Math.hypot(p.x-q.x,p.y-q.y);if(d<130){ctx.beginPath();ctx.moveTo(p.x,p.y);ctx.lineTo(q.x,q.y);ctx.strokeStyle=`rgba(42,82,152,${(1-d/130)*.25})`;ctx.lineWidth=1;ctx.stroke();}}} requestAnimationFrame(drawFrame); }
    if(!('ontouchstart'in window))window.addEventListener('mousemove',e=>{mouse.x=e.clientX;mouse.y=e.clientY;});
    let resizeTimer; window.addEventListener('resize',()=>{clearTimeout(resizeTimer);resizeTimer=setTimeout(resize,120);});
    document.querySelector('.sm-scroll-hint').addEventListener('click',e=>{e.preventDefault();const t=document.getElementById('stats');if(!t)return;window.scrollTo({top:t.getBoundingClientRect().top+window.scrollY-80,behavior:'smooth'});});
    resize(); initParticles(); drawFrame();
    const revObs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('revealed');revObs.unobserve(e.target);}});},{threshold:.12});
    document.querySelectorAll('.reveal,.ani').forEach(el=>revObs.observe(el));
    const cObs=new IntersectionObserver(entries=>{entries.forEach(entry=>{if(!entry.isIntersecting)return;const el=entry.target;const target=parseInt(el.dataset.target);let current=0;const step=target/28;const id=setInterval(()=>{current+=step;if(current>=target){current=target;clearInterval(id);}el.textContent=Math.floor(current);},45);cObs.unobserve(el);});},{threshold:.5});
    document.querySelectorAll('.counter').forEach(el=>cObs.observe(el));
  </script>

</LayoutReclutadores>
