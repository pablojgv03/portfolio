---
import Layout from '../../../layouts/Layout.astro';
import esData from '../../../data/i18n/es.json';
import enData from '../../../data/i18n/en.json';

function fmtDate(d) {
  if (!d || !/^\d{4}-\d{2}-\d{2}$/.test(d)) return d || '';
  const [y, m] = d.split('-');
  return `${ ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][parseInt(m,10)-1] } ${y}`;
}

const sections = [
  {
    id: 'what-do-you-need',
    title: 'What does your business need?',
    desc: 'Before investing, understand which type of digital presence fits your business and your budget.',
    slugs: ['digitalizacion-empresas','precio-pagina-web-granada','landing-page-vs-pagina-web-negocio','app-movil-vs-web-granada','php-medida-vs-wordpress'],
  },
  {
    id: 'by-sector',
    title: 'Websites by business type',
    desc: 'Practical guides for the most common sectors: restaurants, clinics and online stores.',
    slugs: ['web-restaurantes-granada','web-clinicas-granada','tienda-online-granada'],
  },
  {
    id: 'seo-visibility',
    title: 'Local SEO and visibility',
    desc: 'How to appear on Google when someone in Granada searches for what you offer.',
    slugs: ['seo-local-granada','google-my-business-granada','velocidad-web-seo-granada','reputacion-online-granada','lighthouse-100-negocio-local'],
  },
  {
    id: 'design-performance',
    title: 'Design, performance and maintenance',
    desc: 'A website that loads fast, turns visits into customers and stays reliable over time.',
    slugs: ['diseno-web-que-convierte','errores-web-pymes-granada','mantenimiento-web-granada','automatizacion-negocios-granada'],
  },
  {
    id: 'hiring',
    title: 'Hiring and process',
    desc: 'How working with a local freelance developer works and what you can expect from the process.',
    slugs: ['como-es-trabajar-conmigo','freelance-programador-granada','kit-digital-granada-pagina-web','desarrollador-web-granada'],
  },
];

const sectionData = sections.map(s => ({
  ...s,
  posts: s.slugs
    .filter(slug => esData.blog[slug] && !esData.blog[slug].hidden && enData.blog?.[slug]?.title)
    .map(slug => ({ slug, ...enData.blog[slug], date: esData.blog[slug].date })),
}));

const allPosts = sectionData.flatMap(s => s.posts);

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Website for businesses in Granada — Complete guide",
  "description": "Resources and articles on how to have a professional and effective website if you run a local business in Granada.",
  "url": "https://www.pablogomezvillen.com/en/blog/web-for-businesses-granada",
  "itemListElement": allPosts.map((p, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `https://www.pablogomezvillen.com/en/blog/${p.slug}`,
    "name": p.title,
  })),
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.pablogomezvillen.com/en/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.pablogomezvillen.com/en/blog" },
    { "@type": "ListItem", "position": 3, "name": "Web for businesses in Granada", "item": "https://www.pablogomezvillen.com/en/blog/web-for-businesses-granada" },
  ],
};
---

<Layout
  title="Website for Businesses in Granada — Complete Guide 2025 | Pablo Gómez"
  lang="en"
  showHero={false}
  description="Everything you need to know to have a professional website in Granada: real prices, local SEO, design that converts and ongoing maintenance. Complete guide for local businesses."
  canonical="https://www.pablogomezvillen.com/en/blog/web-for-businesses-granada"
  alternateEn="https://www.pablogomezvillen.com/en/blog/web-for-businesses-granada"
  alternateEs="https://www.pablogomezvillen.com/blog/web-para-negocios-granada"
  keywords="website for businesses granada, local business website, web development granada, website price granada, local SEO granada, freelance developer granada"
  ogType="website"
  jsonLd={[itemList, breadcrumbSchema]}
>

  <div id="view-pillar">

    <div class="pillar-banner">
      <div class="pillar-banner-inner">
        <nav class="blog-breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/en/">Home</a></li>
            <li><a href="/en/blog">Blog</a></li>
            <li aria-current="page">Web for businesses</li>
          </ol>
        </nav>
        <span class="pillar-eyebrow">Complete guide</span>
        <h1 class="pillar-title">Website for businesses in Granada</h1>
        <p class="pillar-subtitle">Everything you need to build a professional and effective digital presence — from choosing the right type of website to ranking on Google.</p>
        <div class="pillar-stats">
          <span>{allPosts.length} articles</span>
          <span>·</span>
          <span>5 topics</span>
          <span>·</span>
          <span>Updated {fmtDate(allPosts[0]?.date)}</span>
        </div>
      </div>
    </div>

    <div class="pillar-layout">
    <div class="pillar-main">

      <div class="pillar-intro">
        <p>If you run a business in Granada and are thinking about getting (or improving) your website, this guide brings together everything I have written on the subject: from how much it costs and what type of site you need, to how to rank on Google and which mistakes to avoid. Each section links to specific articles so you can go deeper on whatever interests you most.</p>
      </div>

      <nav class="pillar-toc pillar-toc--inline" aria-label="Section index">
        <p class="pillar-toc-title">In this guide</p>
        <ol>
          {sections.map(s => (
            <li><a href={`#${s.id}`}>{s.title}</a></li>
          ))}
        </ol>
      </nav>

      {sectionData.map(section => (
        <section class="pillar-section" id={section.id}>
          <div class="pillar-section-header">
            <h2 class="pillar-section-title">{section.title}</h2>
            <p class="pillar-section-desc">{section.desc}</p>
          </div>
          <div class="pillar-cards">
            {section.posts.map(p => (
              <a href={`/en/blog/${p.slug}`} class="pillar-card">
                {p.image && (
                  <div class="pillar-card-thumb">
                    <img src={p.image} alt={p.imageAlt || p.title} width="400" height="210" loading="lazy" decoding="async" />
                  </div>
                )}
                <div class="pillar-card-body">
                  <h3 class="pillar-card-title">{p.title}</h3>
                  <p class="pillar-card-excerpt">{p.excerpt || p.subtitle || ''}</p>
                  <span class="pillar-card-meta">
                    {p.readTime ? `⏱ ${p.readTime}` : ''}
                    {p.readTime && p.date ? ' · ' : ''}
                    {fmtDate(p.date)}
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))}

      <div class="pillar-cta">
        <h2 class="pillar-cta-title">Need a website for your business?</h2>
        <p class="pillar-cta-desc">I'm a freelance developer based in Granada. I'll help you get a professional, fast website that shows up on Google — no nonsense, no overpricing.</p>
        <div class="pillar-cta-actions">
          <a href="/en/servicios" class="btn primary">View services</a>
          <a href="/en/contacto" class="btn secondary">Get in touch</a>
        </div>
      </div>

    </div>

    <aside class="pillar-sidebar" aria-label="Guide index">
      <nav class="pillar-toc" aria-label="Section index">
        <p class="pillar-toc-title">In this guide</p>
        <ol>
          {sections.map(s => (
            <li><a href={`#${s.id}`}>{s.title}</a></li>
          ))}
        </ol>
      </nav>
    </aside>
    </div>
  </div>

</Layout>

<script>
  const sections = Array.from(document.querySelectorAll('.pillar-section[id]'));
  const tocLinks = Array.from(document.querySelectorAll('.pillar-sidebar .pillar-toc a[href^="#"], .pillar-toc--inline a[href^="#"]'));
  if (sections.length && tocLinks.length) {
    const BLEND = 0.65;
    function applyTocIntensity(link, t) {
      const dark = document.documentElement.classList.contains('dark');
      const r = dark ? Math.round(148 - 52 * t) : Math.round(71 - 34 * t);
      const g = dark ? Math.round(163 +  2 * t) : Math.round(85 + 14 * t);
      const b = dark ? Math.round(184 + 66 * t) : Math.round(105 + 130 * t);
      link.style.color = `rgb(${r},${g},${b})`;
      link.style.fontWeight = t > 0.5 ? '600' : '';
    }
    function updateActiveToc() {
      const vp = window.innerHeight;
      const threshold = window.scrollY + vp * 0.28;
      let activeIdx = 0;
      for (let i = 0; i < sections.length; i++) {
        if (sections[i].offsetTop <= threshold) activeIdx = i;
        else break;
      }
      const nxt = sections[activeIdx + 1];
      let blend = 0;
      if (nxt) {
        const blendStart = nxt.offsetTop - BLEND * vp;
        const raw = Math.max(0, Math.min(1, (threshold - blendStart) / (BLEND * vp)));
        blend = raw * raw * (3 - 2 * raw);
      }
      tocLinks.forEach(a => {
        const idx = sections.findIndex(s => '#' + s.id === a.getAttribute('href'));
        const t = idx === activeIdx ? 1 - blend : idx === activeIdx + 1 ? blend : 0;
        applyTocIntensity(a, t);
      });
    }
    window.addEventListener('scroll', updateActiveToc, { passive: true });
    updateActiveToc();
  }
</script>

<style>
  .pillar-banner {
    margin-top: -20px;
    background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 60%, #1e40af 100%);
    color: #fff;
    padding: 3.5rem 1.5rem 3rem;
  }

  .pillar-banner-inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .pillar-eyebrow {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #93c5fd;
    margin-bottom: 0.75rem;
  }

  .pillar-title {
    font-size: clamp(1.75rem, 4vw, 2.6rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 0.9rem;
    color: #fff;
  }

  .pillar-subtitle {
    font-size: 1.05rem;
    line-height: 1.65;
    color: #bfdbfe;
    margin: 0 0 1.25rem;
    max-width: 640px;
  }

  .pillar-stats {
    display: flex;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: #93c5fd;
    flex-wrap: wrap;
  }

  .pillar-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 2rem;
    max-width: 1160px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
    align-items: start;
  }

  .pillar-main { min-width: 0; }

  .pillar-sidebar {
    position: sticky;
    top: 5.5rem;
  }

  .pillar-intro {
    font-size: 1.05rem;
    line-height: 1.75;
    color: #334155;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #e2e8f0;
  }

  :global(.dark) .pillar-intro { color: #cbd5e1; border-color: #334155; }

  .pillar-toc {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 0;
  }

  .pillar-toc--inline {
    display: none;
    margin-bottom: 2rem;
  }

  :global(.dark) .pillar-toc { background: #1e293b; border-color: #334155; }

  .pillar-toc-title {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #2563eb;
    margin: 0 0 0.75rem;
  }

  :global(.dark) .pillar-toc-title { color: #94a3b8; }

  .pillar-toc ol {
    margin: 0;
    padding-left: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pillar-toc li { font-size: 0.95rem; }

  .pillar-toc a {
    color: #334155;
    text-decoration: none;
  }

  .pillar-toc a:hover { color: #2563eb; text-decoration: underline; }

  :global(.dark) .pillar-toc a { color: #cbd5e1; }
  :global(.dark) .pillar-toc a:hover { color: #60a5fa; }

  .pillar-toc a.toc-active { color: #2563eb; font-weight: 600; }
  :global(.dark) .pillar-toc a.toc-active { color: #60a5fa; }

  .pillar-section {
    margin-bottom: 3.5rem;
    scroll-margin-top: 5.5rem;
  }

  .pillar-section-header {
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid #2563eb;
  }

  .pillar-section-title {
    font-size: 1.35rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.4rem;
  }

  :global(.dark) .pillar-section-title { color: #f1f5f9; }

  .pillar-section-desc {
    font-size: 0.95rem;
    color: #64748b;
    margin: 0;
    line-height: 1.55;
  }

  :global(.dark) .pillar-section-desc { color: #94a3b8; }

  .pillar-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  .pillar-card {
    display: flex;
    flex-direction: column;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    background: #fff;
    transition: box-shadow 0.18s, transform 0.18s, border-color 0.18s;
  }

  .pillar-card:hover {
    box-shadow: 0 6px 24px rgba(37,99,235,0.10);
    transform: translateY(-2px);
    border-color: #93c5fd;
  }

  :global(.dark) .pillar-card { background: #1e293b; border-color: #334155; }
  :global(.dark) .pillar-card:hover { border-color: #60a5fa; box-shadow: 0 6px 24px rgba(96,165,250,0.10); }

  .pillar-card-thumb {
    width: 100%;
    aspect-ratio: 400 / 210;
    overflow: hidden;
    background: #f1f5f9;
  }

  .pillar-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
    transition: transform 0.3s;
  }

  .pillar-card:hover .pillar-card-thumb img { transform: scale(1.04); }

  .pillar-card-body {
    padding: 1rem 1.1rem 1.1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.4rem;
  }

  .pillar-card-title {
    font-size: 0.97rem;
    font-weight: 600;
    color: #0f172a;
    line-height: 1.4;
    margin: 0;
  }

  :global(.dark) .pillar-card-title { color: #f1f5f9; }

  .pillar-card-excerpt {
    font-size: 0.83rem;
    color: #64748b;
    line-height: 1.55;
    margin: 0;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.dark) .pillar-card-excerpt { color: #94a3b8; }

  .pillar-card-meta {
    font-size: 0.78rem;
    color: #94a3b8;
    margin-top: 0.25rem;
  }

  .pillar-cta {
    background: linear-gradient(135deg, #eff6ff, #dbeafe);
    border: 1px solid #bfdbfe;
    border-radius: 16px;
    padding: 2.5rem 2rem;
    text-align: center;
    margin-top: 1rem;
  }

  :global(.dark) .pillar-cta { background: linear-gradient(135deg, #1e3050, #1e293b); border-color: #334155; }

  .pillar-cta-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.75rem;
  }

  :global(.dark) .pillar-cta-title { color: #f1f5f9; }

  .pillar-cta-desc {
    font-size: 1rem;
    color: #334155;
    line-height: 1.65;
    margin: 0 auto 1.5rem;
    max-width: 520px;
  }

  :global(.dark) .pillar-cta-desc { color: #cbd5e1; }

  .pillar-cta-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 1024px) {
    .pillar-layout {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem 3rem;
    }
    .pillar-sidebar { display: none; }
    .pillar-toc--inline { display: block; }
  }

  @media (max-width: 640px) {
    .pillar-banner {
    margin-top: -20px; padding: 2.5rem 1rem 2rem; }
    .pillar-layout { padding: 1.5rem 1rem 3rem; }
    .pillar-cards { grid-template-columns: 1fr; }
    .pillar-cta { padding: 1.75rem 1.25rem; }
  }
</style>
