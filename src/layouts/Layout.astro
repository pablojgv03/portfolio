    <!-- Scripts -->
    <script type="module">
      window.addEventListener('DOMContentLoaded', () => {
        const toggle = document.querySelector('.nav-toggle');
        const menu = document.getElementById('mobileMenu');
        const closeBtn = document.querySelector('.close-menu');

        // --- Menú móvil ---
        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          menu.classList.toggle('show');
          document.body.style.overflow = menu.classList.contains('show') ? 'hidden' : '';
        });

        closeBtn.addEventListener('click', () => {
          menu.classList.remove('show');
          document.body.style.overflow = '';
        });

        document.addEventListener('click', (e) => {
          if (menu.classList.contains('show') && !menu.contains(e.target) && !toggle.contains(e.target)) {
            menu.classList.remove('show');
            document.body.style.overflow = '';
          }
        });

        // --- Idioma (URL-based) ---
        const langSwitches = document.querySelectorAll('#lang-switch, #lang-switch-mobile');
        const isEnPage = window.location.pathname.startsWith('/en');
        langSwitches.forEach(sw => sw.checked = isEnPage);
        // Sincronizar cookie con la URL actual
        document.cookie = `lang=${isEnPage ? 'en' : 'es'}; path=/; max-age=31536000`;

        // Toggle: navegar a la URL del idioma alternativo
        langSwitches.forEach(sw => {
          sw.addEventListener('change', (e) => {
            const toEN = e.target.checked;
            langSwitches.forEach(other => other.checked = toEN);
            document.cookie = `lang=${toEN ? 'en' : 'es'}; path=/; max-age=31536000`;
            const path = window.location.pathname;
            if (toEN) {
              const altEn = document.querySelector('link[rel="alternate"][hreflang="en"]')?.getAttribute('href');
              window.location.href = altEn ? new URL(altEn).pathname : '/en' + (path === '/' ? '' : path);
            } else {
              const altEs = document.querySelector('link[rel="alternate"][hreflang="es"]')?.getAttribute('href');
              window.location.href = altEs ? new URL(altEs).pathname : (path.replace(/^\/en/, '') || '/');
            }
          });
        });

        // --- Navbar backdrop-blur al hacer scroll ---
        const navbar = document.querySelector('.navbar');
        window.addEventListener('scroll', () => {
          navbar.classList.toggle('navbar--scrolled', window.scrollY > 20);
        }, { passive: true });

        // --- Scroll to top ---
        const scrollBtn = document.getElementById('scroll-top-btn');
        if (scrollBtn) {
          let lastY = window.scrollY;
          window.addEventListener('scroll', () => {
            const currentY = window.scrollY;
            if (currentY > 300 && currentY < lastY) {
              scrollBtn.classList.add('visible');
            } else {
              scrollBtn.classList.remove('visible');
            }
            lastY = currentY;
          }, { passive: true });

          scrollBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // --- Smooth scroll flecha hero ---
        const scrollArrow = document.querySelector('.hero-scroll-arrow');
        if (scrollArrow) {
          scrollArrow.addEventListener('click', e => {
            e.preventDefault();
            const target = document.getElementById('main-content');
            if (!target) return;
            const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth';
            const top = target.getBoundingClientRect().top + window.scrollY - 80;
            window.scrollTo({ top, behavior });
          });
        }

        // --- Scroll reveal para tarjetas ---
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const vh = window.innerHeight;
          document.querySelectorAll('.project-card, .featured-card').forEach(el => {
            if (el.getBoundingClientRect().top > vh * 0.88) {
              el.classList.add('scroll-reveal');
            }
          });
          const revObs = new IntersectionObserver(entries => {
            entries.forEach(e => {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                revObs.unobserve(e.target);
              }
            });
          }, { threshold: 0.05 });
          document.querySelectorAll('.scroll-reveal').forEach(el => revObs.observe(el));
        }
      });
    </script>
  </body>
