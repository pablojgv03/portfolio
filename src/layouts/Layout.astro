---
import '../styles/global.css';
import ContactScript from '../components/ContactScript.astro';
import ExitIntentPopup from '../components/ExitIntentPopup.astro';
import enData from '../data/i18n/en.json';

export const prerender = false;
const {
  title,
  lang = 'es',
  showHero = true,
  description,
  canonical,
  keywords,
  ogImage = '/img/opengraph.png',
  ogType = 'website',
  ogArticleDate,
  jsonLd,
  lcp,
  alternateEn,
  alternateEs,
  footerText,
  noindex = false,
} = Astro.props;

const isEN = lang === 'en';
const basePath = isEN ? '/en' : '';

const ogImageAbsolute = `https://www.pablogomezvillen.com${ogImage}`;
const ogLocale = isEN ? 'en_US' : 'es_ES';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const normalizedPath = currentPath.replace(/^\/en/, '') || '/';
const hideContactWidget = normalizedPath === '/contacto' || normalizedPath === '/contact' || normalizedPath === '/pablo-gomez-villen';
const navClass = (href: string) => {
  let match: boolean;
  if (href === '/') {
    match = normalizedPath === '/';
  } else if (href === '/proyectos') {
    match = normalizedPath === '/proyectos';
  } else {
    match = normalizedPath.startsWith(href);
  }
  if (!match) return undefined;
  const exact = normalizedPath === href || normalizedPath === href + '/';
  return exact ? 'nav-current nav-current--exact' : 'nav-current';
};
const navCurrent = (href: string) => navClass(href) ? 'page' : undefined;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const navHome       = isEN ? enData.nav.home       : 'Inicio';
const navServices   = isEN ? 'Services'             : 'Servicios';
const navProjects   = isEN ? enData.nav.projects    : 'Proyectos';
const navExperience = isEN ? enData.nav.experience  : 'Experiencia';
const navAbout      = isEN ? enData.nav.about       : 'Sobre mí';
const navContact    = isEN ? 'Contact'              : 'Contacto';
const heroGreeting  = isEN ? enData.hero.greeting   : 'Pablo Gómez, <span>Desarrollador Web</span> y SEO Local en Granada';
const heroRole      = isEN
  ? enData.hero.role
  : 'Creo webs que posicionan en Google y convierten visitas en clientes.<span class="hero-role-sub">También desarrollo aplicaciones a medida con PHP, Laravel y JavaScript.</span>';
const heroBtnCV     = isEN ? enData.hero.btnCV      : 'Descargar CV';
const cvFile        = isEN ? 'CV_Pablo_Gomez_Villen_Software-Developer.pdf' : 'CV_Full-stack_Pablo_Gomez_Villen_Desarrollador.pdf';
const defaultRightsText = isEN ? enData.rights : '© 2026 Pablo Gómez Villén || Programador Full Stack';
const rightsText       = footerText ?? defaultRightsText;
const heroBtnProjects  = isEN ? 'View projects'        : 'Ver proyectos';
const heroAvailability = isEN ? 'Available for work'   : 'Disponible para trabajar';
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'}>
    <meta name="author" content="Pablo Gómez">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    {description && <meta name="description" content={description}>}
    {keywords && <meta name="keywords" content={keywords}>}
    {canonical && <link rel="canonical" href={canonical}>}
    {alternateEs && <link rel="alternate" hreflang="es" href={alternateEs}>}
    {alternateEn && <link rel="alternate" hreflang="en" href={alternateEn}>}
    {(alternateEs || alternateEn) && <link rel="alternate" hreflang="x-default" href={alternateEs ?? canonical}>}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType}>
    <meta property="og:locale" content={ogLocale}>
    <meta property="og:site_name" content="Pablo Gómez — Desarrollo Web Granada">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:title" content={title}>
    {description && <meta property="og:description" content={description}>}
    {canonical && <meta property="og:url" content={canonical}>}
    <meta property="og:image" content={ogImageAbsolute}>
    {ogType === 'article' && ogArticleDate && <meta property="article:published_time" content={ogArticleDate}>}
    {ogType === 'article' && ogArticleDate && <meta property="article:modified_time" content={ogArticleDate}>}
    {ogType === 'article' && <meta property="article:author" content="https://www.pablogomezvillen.com/pablo-gomez-villen">}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    {description && <meta name="twitter:description" content={description}>}
    <meta name="twitter:image" content={ogImageAbsolute}>

    <!-- JSON-LD -->
    {jsonLdList.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/manifest.json">
    <link rel="alternate" type="application/rss+xml" title="Blog — Pablo Gómez Villén" href="/rss.xml">
    <meta name="theme-color" content="#2563eb">
    {lcp && <link rel="preload" href={lcp} as="image" fetchpriority="high">}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <!-- Header -->
    <header class="navbar">
      <div class="navbar-container">
        <!-- Logo -->
        <a href="/" class="logo" aria-label="Ir al inicio">
          <picture>
            <source srcset="/favicon.webp" type="image/webp">
            <img src="/favicon.png" alt="Pablo Gómez - Portfolio" width="32" height="32" />
          </picture>
        </a>

        <!-- Menú de escritorio -->
        <nav class="nav-links desktop">
          <a href={`${basePath}/`} class={navClass('/')} aria-current={navCurrent('/')}>{navHome}</a>
          <a href={`${basePath}/servicios`} class={`nav-link-services${navClass('/servicios') ? ' nav-current' : ''}`} aria-current={navCurrent('/servicios')}>{navServices}</a>
          <a href={`${basePath}/proyectos`} class={navClass('/proyectos')} aria-current={navCurrent('/proyectos')}>{navProjects}</a>
          <a href={`${basePath}/experiencia`} class={navClass('/experiencia')} aria-current={navCurrent('/experiencia')}>{navExperience}</a>
          <a href={`${basePath}/pablo-gomez-villen`} class={navClass('/pablo-gomez-villen')} aria-current={navCurrent('/pablo-gomez-villen')}>{navAbout}</a>
          <a href={`${basePath}/blog`} class={navClass('/blog')} aria-current={navCurrent('/blog')}>Blog</a>
          <a href={isEN ? '/en/contact' : '/contacto'} class={`nav-link-contact${navClass('/contacto') ? ' nav-current' : ''}`} aria-current={navCurrent('/contacto')}>{navContact}</a>
        </nav>

        <!-- Toggle idioma (solo escritorio) -->
        <div class="lang-toggle desktop-only" aria-label="Cambiar idioma">
          <input type="checkbox" id="lang-switch" />
          <label for="lang-switch" class="lang-label">
            <span class="flag flag-es"><img src="/img/flags/es.svg" alt="Cambiar idioma a Español" loading="lazy"></span>
            <span class="flag flag-en"><img src="/img/flags/gb.svg" alt="Switch language to English" loading="lazy"></span>
            <span class="toggle-slider"></span>
          </label>
        </div>

        <!-- Botón menú móvil -->
        <button class="nav-toggle" aria-label="Abrir menú">☰</button>
      </div>

      <!-- Menú móvil -->
      <nav class="nav-links mobile" id="mobileMenu">
        <div class="menu-header">
          <a href={`${basePath}/`} class="logo" aria-label="Go to homepage">
            <picture>
              <source srcset="/favicon.webp" type="image/webp">
              <img src="/favicon.png" alt="Pablo Gómez - Portfolio" width="32" height="32" />
            </picture>
          </a>
          <button class="close-menu" aria-label="Cerrar menú">✕</button>
        </div>
        <a href={`${basePath}/`} class={navClass('/')} aria-current={navCurrent('/')}>{navHome}</a>
        <a href={`${basePath}/servicios`} class={`nav-link-services${navClass('/servicios') ? ' nav-current' : ''}`} aria-current={navCurrent('/servicios')}>{navServices}</a>
        <a href={`${basePath}/proyectos`} class={navClass('/proyectos')} aria-current={navCurrent('/proyectos')}>{navProjects}</a>
        <a href={`${basePath}/experiencia`} class={navClass('/experiencia')} aria-current={navCurrent('/experiencia')}>{navExperience}</a>
        <a href={`${basePath}/pablo-gomez-villen`} class={navClass('/pablo-gomez-villen')} aria-current={navCurrent('/pablo-gomez-villen')}>{navAbout}</a>
        <a href={`${basePath}/blog`} class={navClass('/blog')} aria-current={navCurrent('/blog')}>Blog</a>
        <a href={isEN ? '/en/contact' : '/contacto'} class={`nav-link-contact${navClass('/contacto') ? ' nav-current' : ''}`} aria-current={navCurrent('/contacto')}>{navContact}</a>

        <!-- Toggle idioma (solo móvil) -->
        <div class="lang-toggle mobile-only" aria-label="Cambiar idioma">
          <input type="checkbox" id="lang-switch-mobile" />
          <label for="lang-switch-mobile" class="lang-label">
            <span class="flag flag-es"><img src="/img/flags/es.svg" alt="Cambiar idioma a Español"></span>
            <span class="flag flag-en"><img src="/img/flags/gb.svg" alt="Switch language to English"></span>
            <span class="toggle-slider"></span>
          </label>
        </div>

        <!-- Redes sociales (solo móvil) -->
        <div class="mobile-socials" aria-label="Redes sociales">
          <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="mobile-social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.instagram.com/pablogomez.dev?igsh=bXlwODg0b2Q1djBz" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="mobile-social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://www.tiktok.com/@pablogomez.dev?_r=1&_t=ZN-96joekIjghC" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="mobile-social-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.53V6.77a4.85 4.85 0 01-1.01-.08z"/></svg>
          </a>
        </div>
      </nav>
    </header>

    <!-- Hero -->
    {showHero && (
      <header class="hero">
        <div class="hero-content">
          <div class="hero-status">
            <span class="hero-status-dot"></span>
            <span>{heroAvailability}</span>
          </div>
          <h1 set:html={heroGreeting}></h1>
          <p set:html={heroRole}></p>
          <div class="hero-chips">
            <span>Laravel</span>
            <span>PHP</span>
            <span>JavaScript</span>
            <span>MySQL</span>
            <span>Astro</span>
          </div>
          <div class="hero-buttons">
            <a href={`${basePath}/proyectos`} class="btn">{heroBtnProjects}</a>
            <a href={isEN ? '/en/servicios' : '/servicios'} class="btn btn-services">{isEN ? '💼 I need a website' : '💼 Necesito una web'}</a>
            <a id="cv-link" href={`/${cvFile}`} download target="_blank" rel="noopener noreferrer" class="btn secondary btn--icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              {heroBtnCV}
            </a>
          </div>
          <a href="#main-content" class="hero-scroll-arrow" aria-label={isEN ? 'Scroll down' : 'Ver contenido'}>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </a>
        </div>
      </header>
    )}

    <!-- Slot -->
  <main id="main-content">
    <slot lang={lang} />
  </main>

    <!-- Footer -->
    <footer>
      <p>{rightsText}</p>
      <div class="footer-socials" aria-label="Redes sociales">
        <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="footer-social-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://www.instagram.com/pablogomez.dev?igsh=bXlwODg0b2Q1djBz" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="footer-social-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="https://www.tiktok.com/@pablogomez.dev?_r=1&_t=ZN-96joekIjghC" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="footer-social-link">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.53V6.77a4.85 4.85 0 01-1.01-.08z"/></svg>
        </a>
      </div>
    </footer>

    <!-- Scroll to top -->
    <button id="scroll-top-btn" aria-label="Volver arriba" title="Volver arriba">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <!-- Contact fixed widget -->
    {!hideContactWidget && (
      <>
        <div class="contact-fixed">
          <div class="contact-fixed-header">
            <p class="contact-fixed-title" role="heading" aria-level="2">
              <span aria-hidden="true">📩 </span>{isEN ? 'Contact' : 'Contacto'}
            </p>
            <button class="contact-close" aria-label={isEN ? 'Close contact' : 'Cerrar contacto'}>✕</button>
          </div>
          <ul class="contact">
            <li>📞 <a href="tel:+34622400727">+34 622 400 727</a></li>
            <li>📧 <a href="mailto:pablogomezvillen@gmail.com">pablogomezvillen@gmail.com</a></li>
            <li class="contact-socials-row">
              <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="contact-social-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
