---
import '../styles/global.css';
import ContactScript from '../components/ContactScript.astro';
import ExitIntentPopup from '../components/ExitIntentPopup.astro';
import enData from '../data/i18n/en.json';

export const prerender = false;
const {
  title,
  lang = 'es',
  showHero = true,
  description,
  canonical,
  keywords,
  ogImage = '/img/opengraph.png',
  ogType = 'website',
  ogArticleDate,
  jsonLd,
  lcp,
  alternateEn,
  alternateEs,
  footerText,
} = Astro.props;

const isEN = lang === 'en';
const basePath = isEN ? '/en' : '';

const ogImageAbsolute = `https://www.pablogomezvillen.com${ogImage}`;
const ogLocale = isEN ? 'en_US' : 'es_ES';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const normalizedPath = currentPath.replace(/^\/en/, '') || '/';
const hideContactWidget = normalizedPath === '/contacto' || normalizedPath === '/contact' || normalizedPath === '/pablo-gomez-villen';
const navClass = (href: string) => {
  let match: boolean;
  if (href === '/') {
    match = normalizedPath === '/';
  } else if (href === '/proyectos') {
    match = normalizedPath === '/proyectos';
  } else {
    match = normalizedPath.startsWith(href);
  }
  return match ? 'nav-current' : undefined;
};
const navCurrent = (href: string) => navClass(href) ? 'page' : undefined;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const navHome       = isEN ? enData.nav.home       : 'Inicio';
const navServices   = isEN ? 'Services'             : 'Servicios';
const navProjects   = isEN ? enData.nav.projects    : 'Proyectos';
const navExperience = isEN ? enData.nav.experience  : 'Experiencia';
const navAbout      = isEN ? enData.nav.about       : 'Sobre mí';
const navContact    = isEN ? 'Contact'              : 'Contacto';
const heroGreeting  = isEN ? enData.hero.greeting   : 'Pablo Gómez, <span>Desarrollador Web</span> y SEO Local en Granada';
const heroRole      = isEN
  ? enData.hero.role
  : 'Creo webs que posicionan en Google y convierten visitas en clientes.<span class="hero-role-sub">También desarrollo aplicaciones a medida con PHP, Laravel y JavaScript.</span>';
const heroBtnCV     = isEN ? enData.hero.btnCV      : 'Descargar CV';
const cvFile        = isEN ? 'CV_Pablo_Gomez_Villen_Software-Developer.pdf' : 'CV_Full-stack_Pablo_Gomez_Villen_Desarrollador.pdf';
const defaultRightsText = isEN ? enData.rights : '© 2026 Pablo Gómez Villén || Programador Full Stack';
const rightsText       = footerText ?? defaultRightsText;
const heroBtnProjects  = isEN ? 'View projects'        : 'Ver proyectos';
const heroAvailability = isEN ? 'Available for work'   : 'Disponible para trabajar';
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="robots" content="index, follow">
    <meta name="author" content="Pablo Gómez">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    {description && <meta name="description" content={description}>}
    {keywords && <meta name="keywords" content={keywords}>}
    {canonical && <link rel="canonical" href={canonical}>}
    {alternateEs && <link rel="alternate" hreflang="es" href={alternateEs}>}
    {alternateEn && <link rel="alternate" hreflang="en" href={alternateEn}>}
    {(alternateEs || alternateEn) && <link rel="alternate" hreflang="x-default" href={alternateEs ?? canonical}>}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType}>
    <meta property="og:locale" content={ogLocale}>
    <meta property="og:site_name" content="Pablo Gómez — Desarrollo Web Granada">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:title" content={title}>
    {description && <meta property="og:description" content={description}>}
    {canonical && <meta property="og:url" content={canonical}>}
    <meta property="og:image" content={ogImageAbsolute}>
    {ogType === 'article' && ogArticleDate && <meta property="article:published_time" content={ogArticleDate}>}
    {ogType === 'article' && ogArticleDate && <meta property="article:modified_time" content={ogArticleDate}>}
    {ogType === 'article' && <meta property="article:author" content="https://www.pablogomezvillen.com/pablo-gomez-villen">}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    {description && <meta name="twitter:description" content={description}>}
    <meta name="twitter:image" content={ogImageAbsolute}>

    <!-- JSON-LD -->
    {jsonLdList.map(schema => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="manifest" href="/manifest.json">
    <link rel="alternate" type="application/rss+xml" title="Blog — Pablo Gómez Villén" href="/rss.xml">
    <meta name="theme-color" content="#2563eb">
    {lcp && <link rel="preload" href={lcp} as="image" fetchpriority="high">}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <!-- Header -->
    <header class="navbar">
      <div class="navbar-container">
        <!-- Logo -->
        <a href="/" class="logo" aria-label="Ir al inicio">
          <img src="/favicon.png" alt="Pablo Gómez - Portfolio" />
        </a>

        <!-- Menú de escritorio -->
        <nav class="nav-links desktop">
          <a href={`${basePath}/`} class={navClass('/')} aria-current={navCurrent('/')}>{navHome}</a>
          <a href={`${basePath}/servicios`} class={`nav-link-services${navClass('/servicios') ? ' nav-current' : ''}`} aria-current={navCurrent('/servicios')}>{navServices}</a>
          <a href={`${basePath}/proyectos`} class={navClass('/proyectos')} aria-current={navCurrent('/proyectos')}>{navProjects}</a>
          <a href={`${basePath}/experiencia`} class={navClass('/experiencia')} aria-current={navCurrent('/experiencia')}>{navExperience}</a>
          <a href={`${basePath}/pablo-gomez-villen`} class={navClass('/pablo-gomez-villen')} aria-current={navCurrent('/pablo-gomez-villen')}>{navAbout}</a>
          <a href={`${basePath}/blog`} class={navClass('/blog')} aria-current={navCurrent('/blog')}>Blog</a>
          <a href={isEN ? '/en/contact' : '/contacto'} class={`nav-link-contact${navClass('/contacto') ? ' nav-current' : ''}`} aria-current={navCurrent('/contacto')}>{navContact}</a>
        </nav>

        <!-- Toggle idioma (solo escritorio) -->
        <div class="lang-toggle desktop-only" aria-label="Cambiar idioma">
          <input type="checkbox" id="lang-switch" />
          <label for="lang-switch" class="lang-label">
            <span class="flag flag-es"><img src="/img/flags/es.svg" alt="Cambiar idioma a Español" loading="lazy"></span>
            <span class="flag flag-en"><img src="/img/flags/gb.svg" alt="Switch language to English" loading="lazy"></span>
            <span class="toggle-slider"></span>
          </label>
        </div>

        <!-- Botón menú móvil -->
        <button class="nav-toggle" aria-label="Abrir menú">☰</button>
      </div>

      <!-- Menú móvil -->
      <nav class="nav-links mobile" id="mobileMenu">
        <div class="menu-header">
          <a href={`${basePath}/`} class="logo" aria-label="Go to homepage">
            <img src="/favicon.png" alt="Pablo Gómez - Portfolio" />
          </a>
          <button class="close-menu" aria-label="Cerrar menú">✕</button>
        </div>
        <a href={`${basePath}/`} class={navClass('/')} aria-current={navCurrent('/')}>{navHome}</a>
        <a href={`${basePath}/servicios`} class={`nav-link-services${navClass('/servicios') ? ' nav-current' : ''}`} aria-current={navCurrent('/servicios')}>{navServices}</a>
        <a href={`${basePath}/proyectos`} class={navClass('/proyectos')} aria-current={navCurrent('/proyectos')}>{navProjects}</a>
        <a href={`${basePath}/experiencia`} class={navClass('/experiencia')} aria-current={navCurrent('/experiencia')}>{navExperience}</a>
        <a href={`${basePath}/pablo-gomez-villen`} class={navClass('/pablo-gomez-villen')} aria-current={navCurrent('/pablo-gomez-villen')}>{navAbout}</a>
        <a href={`${basePath}/blog`} class={navClass('/blog')} aria-current={navCurrent('/blog')}>Blog</a>
        <a href={isEN ? '/en/contact' : '/contacto'} class={`nav-link-contact${navClass('/contacto') ? ' nav-current' : ''}`} aria-current={navCurrent('/contacto')}>{navContact}</a>

        <!-- Toggle idioma (solo móvil) -->
        <div class="lang-toggle mobile-only" aria-label="Cambiar idioma">
          <input type="checkbox" id="lang-switch-mobile" />
          <label for="lang-switch-mobile" class="lang-label">
            <span class="flag flag-es"><img src="/img/flags/es.svg" alt="Cambiar idioma a Español"></span>
            <span class="flag flag-en"><img src="/img/flags/gb.svg" alt="Switch language to English"></span>
            <span class="toggle-slider"></span>
          </label>
        </div>
      </nav>
    </header>

    <!-- Hero -->
    {showHero && (
      <header class="hero">
        <div class="hero-content">
          <div class="hero-status">
            <span class="hero-status-dot"></span>
            <span>{heroAvailability}</span>
          </div>
          <h1 set:html={heroGreeting}></h1>
          <p set:html={heroRole}></p>
          <div class="hero-chips">
            <span>Laravel</span>
            <span>PHP</span>
            <span>JavaScript</span>
            <span>MySQL</span>
            <span>Astro</span>
          </div>
          <div class="hero-buttons">
            <a href={`${basePath}/proyectos`} class="btn">{heroBtnProjects}</a>
            <a href={isEN ? '/en/servicios' : '/servicios'} class="btn btn-services">{isEN ? '💼 I need a website' : '💼 Necesito una web'}</a>
            <a id="cv-link" href={`/${cvFile}`} download target="_blank" rel="noopener noreferrer" class="btn secondary btn--icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              {heroBtnCV}
            </a>
          </div>
          <a href="#main-content" class="hero-scroll-arrow" aria-label={isEN ? 'Scroll down' : 'Ver contenido'}>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </a>
        </div>
      </header>
    )}

    <!-- Slot -->
  <main id="main-content">
    <slot lang={lang} />
  </main>

    <!-- Footer -->
    <footer>
      <p>{rightsText}</p>
    </footer>

    <!-- Scroll to top -->
    <button id="scroll-top-btn" aria-label="Volver arriba" title="Volver arriba">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <!-- Contact fixed widget -->
    {!hideContactWidget && (
      <>
        <div class="contact-fixed">
          <div class="contact-fixed-header">
            <p class="contact-fixed-title" role="heading" aria-level="2">
              <span aria-hidden="true">📩 </span>{isEN ? 'Contact' : 'Contacto'}
            </p>
            <button class="contact-close" aria-label={isEN ? 'Close contact' : 'Cerrar contacto'}>✕</button>
          </div>
          <ul class="contact">
            <li>📞 <a href="tel:+34622400727">+34 622 400 727</a></li>
            <li>📧 <a href="mailto:pablogomezvillen@gmail.com">pablogomezvillen@gmail.com</a></li>
            <li>💼 <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          </ul>
          <a href={isEN ? '/en/servicios#pricing' : '/servicios#precios'} class="contact-fixed-cta btn--icon">
            {isEN ? 'Request a quote' : 'Pedir presupuesto'}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
        <button class="contact-mini" aria-label={isEN ? 'Open contact' : 'Abrir contacto'}>
          <span aria-hidden="true">📩</span>
        </button>
      </>
    )}

    <!-- Contact Script -->
    <ContactScript />

    <!-- Exit Intent Popup -->
    <ExitIntentPopup lang={lang} />

    <!-- Scripts -->
    <script type="module">
      window.addEventListener('DOMContentLoaded', () => {
        const toggle = document.querySelector('.nav-toggle');
        const menu = document.getElementById('mobileMenu');
        const closeBtn = document.querySelector('.close-menu');

        // --- Menú móvil ---
        toggle.addEventListener('click', (e) => {
          e.stopPropagation();
          menu.classList.toggle('show');
          document.body.style.overflow = menu.classList.contains('show') ? 'hidden' : '';
        });

        closeBtn.addEventListener('click', () => {
          menu.classList.remove('show');
          document.body.style.overflow = '';
        });

        document.addEventListener('click', (e) => {
          if (menu.classList.contains('show') && !menu.contains(e.target) && !toggle.contains(e.target)) {
            menu.classList.remove('show');
            document.body.style.overflow = '';
          }
        });

        // --- Idioma (URL-based) ---
        const langSwitches = document.querySelectorAll('#lang-switch, #lang-switch-mobile');
        const isEnPage = window.location.pathname.startsWith('/en');
        langSwitches.forEach(sw => sw.checked = isEnPage);
        // Sincronizar cookie con la URL actual
        document.cookie = `lang=${isEnPage ? 'en' : 'es'}; path=/; max-age=31536000`;

        // Toggle: navegar a la URL del idioma alternativo
        langSwitches.forEach(sw => {
          sw.addEventListener('change', (e) => {
            const toEN = e.target.checked;
            langSwitches.forEach(other => other.checked = toEN);
            document.cookie = `lang=${toEN ? 'en' : 'es'}; path=/; max-age=31536000`;
            const path = window.location.pathname;
            if (toEN) {
              // ES → EN: añadir prefijo /en
              const enPath = '/en' + (path === '/' ? '' : path);
              window.location.href = enPath;
            } else {
              // EN → ES: quitar prefijo /en
              const esPath = path.replace(/^\/en/, '') || '/';
              window.location.href = esPath;
            }
          });
        });

        // --- Navbar backdrop-blur al hacer scroll ---
        const navbar = document.querySelector('.navbar');
        window.addEventListener('scroll', () => {
          navbar.classList.toggle('navbar--scrolled', window.scrollY > 20);
        }, { passive: true });

        // --- Scroll to top ---
        const scrollBtn = document.getElementById('scroll-top-btn');
        if (scrollBtn) {
          let lastY = window.scrollY;
          window.addEventListener('scroll', () => {
            const currentY = window.scrollY;
            if (currentY > 300 && currentY < lastY) {
              scrollBtn.classList.add('visible');
            } else {
              scrollBtn.classList.remove('visible');
            }
            lastY = currentY;
          }, { passive: true });

          scrollBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        }

        // --- Smooth scroll flecha hero ---
        const scrollArrow = document.querySelector('.hero-scroll-arrow');
        if (scrollArrow) {
          scrollArrow.addEventListener('click', e => {
            e.preventDefault();
            const target = document.getElementById('main-content');
            if (!target) return;
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              target.scrollIntoView();
              return;
            }
            const start    = window.scrollY;
            const end      = target.getBoundingClientRect().top + window.scrollY - 80;
            const duration = 1500;
            let startTime  = null;
            const ease = t => t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t+2, 3) / 2;
            const step = ts => {
              if (!startTime) startTime = ts;
              const progress = Math.min((ts - startTime) / duration, 1);
              window.scrollTo(0, start + (end - start) * ease(progress));
              if (progress < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          });
        }

        // --- Scroll reveal para tarjetas ---
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          const vh = window.innerHeight;
          document.querySelectorAll('.project-card, .featured-card').forEach(el => {
            if (el.getBoundingClientRect().top > vh * 0.88) {
              el.classList.add('scroll-reveal');
            }
          });
          const revObs = new IntersectionObserver(entries => {
            entries.forEach(e => {
              if (e.isIntersecting) {
                e.target.classList.add('visible');
                revObs.unobserve(e.target);
              }
            });
          }, { threshold: 0.05 });
          document.querySelectorAll('.scroll-reveal').forEach(el => revObs.observe(el));
        }
      });
    </script>
  </body>
</html>