---
// Exit-intent CTA popup — aparece al salir o volver de otra pestaña, máx. 1 vez/día
---

<div
  id="exit-popup"
  class="exit-popup"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-popup-title"
>
  <button class="exit-popup-close" aria-label="Cerrar popup">✕</button>
  <p class="exit-popup-eyebrow">¡Antes de irte!</p>
  <h2 class="exit-popup-title" id="exit-popup-title">¿Hablamos?</h2>
  <p class="exit-popup-desc">
    Cuéntame tu proyecto o envíame tu oferta.<br />Respondo en menos de 24h.
  </p>
  <div class="exit-popup-btns">
    <a href="tel:+34622400727" class="exit-btn exit-btn--call">
      📞 Llamar
    </a>
    <a
      href="https://wa.me/34622400727?text=Hola%20Pablo%2C%20he%20visto%20tu%20portfolio%20y%20me%20gustar%C3%ADa%20hablar%20contigo."
      target="_blank"
      rel="noopener noreferrer"
      class="exit-btn exit-btn--wa"
    >
      💬 WhatsApp
    </a>
  </div>
</div>

<style>
  .exit-popup {
    position: fixed;
    bottom: 24px;
    right: 24px;
    width: 276px;
    background: #fff;
    border-radius: 16px;
    padding: 20px 20px 18px;
    box-shadow:
      0 20px 56px rgba(0, 0, 0, 0.18),
      0 4px 14px rgba(0, 0, 0, 0.08);
    border-top: 4px solid #1e3c72;
    z-index: 500;
    /* hidden by default */
    opacity: 0;
    transform: translateY(14px);
    pointer-events: none;
    transition:
      opacity 260ms ease,
      transform 320ms cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  .exit-popup.exit-popup--visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .exit-popup-close {
    position: absolute;
    top: 10px;
    right: 12px;
    background: none;
    border: none;
    font-size: 0.95rem;
    color: #bbb;
    cursor: pointer;
    padding: 3px 7px;
    border-radius: 6px;
    line-height: 1;
    transition: color 0.18s, background 0.18s;
  }

  .exit-popup-close:hover {
    color: #555;
    background: #f2f2f2;
  }

  .exit-popup-close:focus-visible {
    outline: 2px solid #2a5298;
    outline-offset: 2px;
  }

  .exit-popup-eyebrow {
    font-size: 0.67rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #2a5298;
    margin-bottom: 4px;
  }

  .exit-popup-title {
    font-size: 1.22rem;
    font-weight: 800;
    color: #1e3c72;
    margin-bottom: 6px;
    line-height: 1.15;
  }

  .exit-popup-desc {
    font-size: 0.86rem;
    color: #666;
    line-height: 1.55;
    margin-bottom: 16px;
  }

  .exit-popup-btns {
    display: flex;
    gap: 8px;
  }

  .exit-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 9px 10px;
    border-radius: 10px;
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: filter 0.18s, transform 0.14s;
  }

  .exit-btn:hover {
    filter: brightness(1.1);
  }

  .exit-btn:active {
    transform: scale(0.96);
  }

  .exit-btn:focus-visible {
    outline: 2px solid #ffce00;
    outline-offset: 2px;
  }

  .exit-btn--call {
    background: #1e3c72;
    color: #fff;
  }

  .exit-btn--wa {
    background: #25d366;
    color: #fff;
  }

  @media (max-width: 380px) {
    .exit-popup {
      right: 10px;
      left: 10px;
      width: auto;
      bottom: 16px;
    }
  }
</style>

<script>
  (() => {
    const LS_KEY = 'cta_popup_ts';
    const ONE_DAY = 86_400_000;
    const popup = document.getElementById('exit-popup');
    if (!popup) return;

    let shownThisSession = false;

    function canShow() {
      const ts = localStorage.getItem(LS_KEY);
      return !ts || Date.now() - Number(ts) > ONE_DAY;
    }

    function showPopup() {
      if (shownThisSession || !canShow()) return;
      shownThisSession = true;
      localStorage.setItem(LS_KEY, String(Date.now()));

      // Cierra el panel de contacto flotante si estuviera abierto
      document.body.classList.remove('contact-open');

      popup.classList.add('exit-popup--visible');
      popup.removeAttribute('aria-hidden');
    }

    function closePopup() {
      popup.classList.remove('exit-popup--visible');
      popup.setAttribute('aria-hidden', 'true');
    }

    popup
      .querySelector('.exit-popup-close')
      ?.addEventListener('click', closePopup);

    // Cerrar con Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && popup.classList.contains('exit-popup--visible')) {
        closePopup();
      }
    });

    // Exit intent: cursor sale por la parte superior del viewport
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY <= 0) showPopup();
    });

    // Vuelta de otra pestaña: espera 3s en la página para evitar falsos positivos al cargar
    let listenForTabReturn = false;
    setTimeout(() => {
      listenForTabReturn = true;
    }, 3000);

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && listenForTabReturn) {
        showPopup();
      }
    });
  })();
</script>
