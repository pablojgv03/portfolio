---
import Layout from '../layouts/Layout.astro';
// PROYECTOS OCULTO temporalmente (en construcción)
// import projects from '../data/projects.json';

const lang = 'es';

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Pablo Gómez",
  "jobTitle": "Full Stack Developer",
  "url": "https://pablogomezvillen.com",
  "email": "paraelpc03@gmail.com",
  "telephone": "+34622400727",
  "image": "https://pablogomezvillen.com/img/foto-empresa.jpg",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Granada",
    "addressCountry": "ES"
  },
  "sameAs": ["https://www.linkedin.com/in/pablo-gomez-villen"]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Pablo Gómez - Portfolio",
  "url": "https://pablogomezvillen.com",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://pablogomezvillen.com/blog?slug={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};
---

<Layout
  title="Pablo Gómez — Full Stack Developer Laravel & PHP | Portfolio"
  lang={lang}
  description="Portfolio de Pablo Gómez, Full Stack Developer especializado en Laravel, PHP, JavaScript y MySQL. Más de 1 año de experiencia en producción en Granada, España."
  canonical="https://pablogomezvillen.com/"
  keywords="Full Stack Developer, Laravel, PHP, JavaScript, MySQL, Google Cloud, ElasticSearch, desarrollador web, Granada, España"
  jsonLd={[personSchema, websiteSchema]}
>
  <!-- Sobre mí -->
  <section id="sobre-mi" class="section">
    <div class="about-grid">
      <img src="img/foto-empresa.jpg" alt="Pablo Gómez, Full Stack Developer en Granada" class="avatar" loading="lazy" />
      <div class="about-text">
        <h2 data-i18n="section-sobre-mi.title"></h2>
        <p data-i18n="section-sobre-mi.content"></p>
      </div>
    </div>
  </section>

  <!-- PROYECTOS OCULTO temporalmente (en construcción)
  <section id="proyectos" class="section bg-light-rounded">
    <h2 data-i18n="section-proyectos.title"></h2>
    <div class="projects">
      (contenido de proyectos - ver src/pages/proyectos.astro)
    </div>
  </section>
  -->

  <!-- Estudios -->
  <section id="estudios" class="section">
    <h2 data-i18n="section-estudios.title"></h2>
    <div class="projects">

      <div class="project-card">
        <a href="/blog?slug=daw" class="full-link" aria-label="Ver estudios DAW"></a>
        <h3 data-i18n="section-estudios.daw"></h3>
        <div class="meta">
          <span class="center">iLERNA</span>
          <span class="period"><span class="start">2025</span>–<span class="end">2026</span></span>
        </div>
        <div class="skills" aria-label="Aptitudes obtenidas en iLERNA">
          <span class="skill high">PHP</span>
          <span class="skill high">JavaScript</span>
          <span class="skill mid">MySQL</span>
          <span class="skill mid">HTML</span>
          <span class="skill mid">CSS</span>
        </div>
        <span class="tech">DAW | En curso</span>
      </div>

      <div class="project-card">
        <a href="/blog?slug=ia-bigdata" class="full-link" aria-label="Ver especialización en IA y Big Data"></a>
        <h3 data-i18n="section-estudios.ia-bd"></h3>
        <div class="meta">
          <span class="center">Campus Net Manyanet Les Corts</span>
          <span class="period"><span class="start">2025</span>–<span class="end">2025</span></span>
        </div>
        <div class="skills" aria-label="Aptitudes obtenidas en Campus Net Manyanet">
          <span class="skill high">Python</span>
          <span class="skill mid">Pandas</span>
          <span class="skill mid">Modelado ML</span>
        </div>
        <span class="tech">IA | Big Data</span>
      </div>

      <div class="project-card">
        <a href="/blog?slug=dam" class="full-link" aria-label="Ver estudios DAM"></a>
        <h3 data-i18n="section-estudios.dam"></h3>
        <div class="meta">
          <span class="center">IES Francisco Ayala</span>
          <span class="period"><span class="start">2021</span>–<span class="end">2023</span></span>
        </div>
        <div class="skills">
          <span class="skill low">Odoo</span>
          <span class="skill high">SQL</span>
          <span class="skill mid">Hibernate</span>
        </div>
        <span class="tech">Desarrollo móvil | JavaScript</span>
      </div>

    </div>
  </section>

  <!-- Experiencia -->
  <section id="experiencia" class="section bg-light-rounded">
    <h2 data-i18n="section-experiencia.title"></h2>
    <div class="projects">
      <div class="project-card">
        <a href="/experiencia#exp-1" class="full-link" aria-label="Ver experiencia en EDUCA EDTECH Group"></a>
        <h3 data-i18n="section-experiencia.first-job.title"></h3>
        <p data-i18n="section-experiencia.first-job.period"></p>
        <div class="skills">
          <span class="skill high">Laravel</span>
          <span class="skill high">PHP</span>
          <span class="skill mid">Google Cloud</span>
          <span class="skill low">ElasticSearch</span>
        </div>
        <span class="tech">Laravel | JavaScript | SQL</span>
      </div>

      <div class="project-card">
        <a href="/experiencia#exp-2" class="full-link" aria-label="Ver experiencia en Euroinnova"></a>
        <h3 data-i18n="section-experiencia.second-job.title"></h3>
        <p data-i18n="section-experiencia.second-job.period"></p>
        <div class="skills">
          <span class="skill high">Laravel</span>
          <span class="skill high">PHP</span>
          <span class="skill high">MySQL</span>
          <span class="skill mid">JavaScript</span>
        </div>
        <span class="tech">PHP | Laravel | MySQL</span>
      </div>
    </div>
  </section>

  <!-- Contacto -->
  <section id="contacto" class="section bg-dark">
    <h2 data-i18n="contact.title"></h2>
    <p data-i18n="contact.content"></p>
    <ul class="contact">
      <li>💼 <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank">LinkedIn</a></li>
      <li>📞 <a href="tel:+34622400727">+34 622 400 727</a></li>
      <li>📧 <a href="mailto:paraelpc03@gmail.com">paraelpc03@gmail.com</a></li>
    </ul>
  </section>

  <div class="contact-fixed" aria-hidden="true">
    <div class="contact-fixed-header">
      <h3 class="contact-fixed-title" data-i18n="contact.title"></h3>
      <button class="contact-close" aria-label="Cerrar contacto">✕</button>
    </div>
    <ul class="contact">
      <li>📞 <a href="tel:+34622400727">+34 622 400 727</a></li>
      <li>📧 <a href="mailto:paraelpc03@gmail.com">paraelpc03@gmail.com</a></li>
      <li>💼 <a href="https://www.linkedin.com/in/pablo-gomez-villen" target="_blank">LinkedIn</a></li>
    </ul>
  </div>
  <button class="contact-mini" aria-label="Abrir contacto">📩</button>

  <!-- Carga i18n para todo el slot -->
  <script type="module">
    import { loadLanguage, getLanguage } from '/scripts/i18n.js';

    window.addEventListener('DOMContentLoaded', async () => {
      const lang = getLanguage();
      await loadLanguage(lang);
      const idiomaActual = window.lang || lang;

      const projectsData = await fetch('/data/projects.json').then(r => r.json());

      document.querySelectorAll('.project-card').forEach((card, i) => {
        const descEl = card.querySelector('.project-desc');
        if (!descEl) return;

        const p = projectsData.proyectos[i];
        if (p?.description?.[idiomaActual]) {
          descEl.textContent = p.description[idiomaActual];
        }
      });
    });
  </script>
</Layout>
