---
// Exit-intent CTA popup — aparece al salir o volver de otra pestaña, máx. 1 vez/día
---

<dialog
  id="exit-popup"
  class="exit-popup"
  aria-labelledby="exit-popup-title"
>
  <button class="exit-popup-close" aria-label="Cerrar popup">✕</button>
  <p class="exit-popup-eyebrow">¡Antes de irte!</p>
  <h2 class="exit-popup-title" id="exit-popup-title">¿Hablamos?</h2>
  <p class="exit-popup-desc">
    Cuéntame tu proyecto o envíame tu oferta.<br />Respondo en menos de 24h.
  </p>
  <div class="exit-popup-btns">
    <a href="tel:+34622400727" class="exit-btn exit-btn--call">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2.22h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      Llamar
    </a>
    <a
      href="https://wa.me/34622400727?text=Hola%20Pablo%2C%20he%20visto%20tu%20portfolio%20y%20me%20gustar%C3%ADa%20hablar%20contigo."
      target="_blank"
      rel="noopener noreferrer"
      class="exit-btn exit-btn--wa"
    >
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      WhatsApp
    </a>
  </div>
</dialog>

<style>
  dialog.exit-popup {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(480px, 92vw);
    background: #fff;
    border: none;
    border-radius: 20px;
    padding: 40px 36px 32px;
    box-shadow:
      0 32px 80px rgba(0, 0, 0, 0.28),
      0 8px 24px rgba(0, 0, 0, 0.12);
    border-top: 5px solid #1e3c72;
    z-index: 500;
    opacity: 0;
    transform: scale(0.88) translateY(20px);
    transition:
      opacity 280ms ease,
      transform 360ms cubic-bezier(0.2, 0.9, 0.2, 1);
  }

  dialog.exit-popup[open] {
    opacity: 1;
    transform: scale(1) translateY(0);
  }

  dialog.exit-popup::backdrop {
    background: rgba(5, 10, 30, 0.72);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  .exit-popup-close {
    position: absolute;
    top: 14px;
    right: 16px;
    background: none;
    border: none;
    font-size: 1rem;
    color: #bbb;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
    line-height: 1;
    transition: color 0.18s, background 0.18s;
  }

  .exit-popup-close:hover {
    color: #444;
    background: #f2f2f2;
  }

  .exit-popup-close:focus-visible {
    outline: 2px solid #2a5298;
    outline-offset: 2px;
  }

  .exit-popup-eyebrow {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #2a5298;
    margin-bottom: 8px;
  }

  .exit-popup-title {
    font-size: 2rem;
    font-weight: 900;
    color: #1e3c72;
    margin-bottom: 10px;
    line-height: 1.1;
  }

  .exit-popup-desc {
    font-size: 1rem;
    color: #555;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .exit-popup-btns {
    display: flex;
    gap: 12px;
  }

  .exit-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 13px 16px;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: filter 0.18s, transform 0.14s;
  }

  .exit-btn:hover  { filter: brightness(1.1); transform: translateY(-2px); }
  .exit-btn:active { transform: scale(0.96); }

  .exit-btn:focus-visible {
    outline: 2px solid #ffce00;
    outline-offset: 2px;
  }

  .exit-btn--call { background: #1e3c72; color: #fff; }
  .exit-btn--wa   { background: #25d366; color: #fff; }

  @media (max-width: 480px) {
    dialog.exit-popup { padding: 32px 22px 24px; }
    .exit-popup-title { font-size: 1.6rem; }
    .exit-popup-btns  { flex-direction: column; }
  }
</style>

<script>
  (() => {
    const LS_KEY = 'cta_popup_ts';
    const ONE_DAY = 86_400_000;
    const popup = document.getElementById('exit-popup') as HTMLDialogElement | null;
    if (!popup) return;

    let shownThisSession = false;
    let openerElement: Element | null = null;

    function canShow() {
      const ts = localStorage.getItem(LS_KEY);
      return !ts || Date.now() - Number(ts) > ONE_DAY;
    }

    function showPopup() {
      if (shownThisSession || !canShow()) return;
      shownThisSession = true;
      localStorage.setItem(LS_KEY, String(Date.now()));

      openerElement = document.activeElement;
      document.body.classList.remove('contact-open');
      popup.showModal();
    }

    function closePopup() {
      popup.close();
      if (openerElement instanceof HTMLElement) {
        openerElement.focus();
      }
    }

    popup.querySelector('.exit-popup-close')?.addEventListener('click', closePopup);

    // El evento 'cancel' se dispara cuando el usuario pulsa Escape (nativo del dialog)
    popup.addEventListener('cancel', () => {
      if (openerElement instanceof HTMLElement) {
        openerElement.focus();
      }
    });

    // Exit intent: cursor sale por la parte superior del viewport
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY <= 0) showPopup();
    });

    // Vuelta de otra pestaña: espera 3s para evitar falsos positivos al cargar
    let listenForTabReturn = false;
    setTimeout(() => { listenForTabReturn = true; }, 3000);

    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible' && listenForTabReturn) {
        showPopup();
      }
    });
  })();
</script>
